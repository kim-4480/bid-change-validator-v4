# Supabase Transaction pooler URI. 비밀번호의 특수문자는 URL 인코딩합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace_with_database_password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Alembic용 Session pooler URI(마이그레이션 DDL은 5432로 실행)
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:replace_with_database_password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_POOL_MODE=transaction
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
NOTICE_POLLER_DATABASE_POOL_SIZE=1
NOTICE_POLLER_DATABASE_MAX_OVERFLOW=0

G2B_SERVICE_KEY=replace_with_your_service_key
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.6-luna

# S3를 아직 정하지 않았다면 LOCAL로 바꿀 수 있지만, 해당 서버 볼륨에만 보존됩니다.
DOCUMENT_STORAGE_BACKEND=S3
DOCUMENT_S3_BUCKET=replace_with_bucket_name
DOCUMENT_S3_PREFIX=notice-documents
DOCUMENT_S3_ENDPOINT_URL=replace_with_s3_compatible_endpoint
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key

CORS_ORIGINS=https://replace-with-frontend-domain.example
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
# 운영환경에서는 12자 이상이며 admin이 아닌 값만 허용됩니다.
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_random_password
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=true
AUTH_REQUIRED=true

NOTICE_POLL_INTERVAL_SECONDS=300
NOTICE_POLL_LOOKBACK_MINUTES=60
NOTICE_POLL_OVERLAP_MINUTES=5
NOTICE_POLL_PAGE_SIZE=100
NOTICE_POLL_MAX_PAGES=10
NOTICE_POLL_BUSINESS_TYPES=SERVICE,GOODS,CONSTRUCTION,FOREIGN
NOTICE_HISTORY_BACKFILL_BATCH_SIZE=10
NOTICE_HISTORY_BACKFILL_RETRY_MINUTES=15
