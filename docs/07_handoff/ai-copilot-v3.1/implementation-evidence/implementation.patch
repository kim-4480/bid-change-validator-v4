+@pytest.mark.parametrize('change', ['source', 'extracted', 'blocks', 'add', 'remove', 'model', 'dimensions', 'extractor'])
+def test_same_version_changes_invalidate_fingerprint(tmp_path, change):
+    v, embed = version(), Embeddings()
