+class Embeddings:
+    def __init__(self): self.document_calls = 0
+    def embed_documents(self, texts):
+        self.document_calls += 1
+        return [[1.0, float(len(t) % 7 + 1)] for t in texts]
+    def embed_query(self, text): return [1.0, 1.0]
+
