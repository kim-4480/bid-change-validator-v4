G2B_SERVICE_KEY=replace_with_your_service_key

POSTGRES_DB=bidjigi
POSTGRES_USER=bidjigi
POSTGRES_PASSWORD=bidjigi_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bidjigi:bidjigi_local_password@localhost:5432/bidjigi
# Supabase Session pooler(5432)는 작은 고정 풀을 사용합니다.
DATABASE_POOL_MODE=auto
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
NOTICE_POLLER_DATABASE_POOL_SIZE=1
NOTICE_POLLER_DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
# DATABASE_URL이 Transaction pooler(6543)라면 마이그레이션에는 5432 주소를 별도로 사용하세요.
MIGRATION_DATABASE_URL=
API_PORT=8000
APP_ENVIRONMENT=development
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_REQUIRED=false
DOCUMENT_STORAGE_BACKEND=LOCAL
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=notice-documents
DOCUMENT_S3_ENDPOINT_URL=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NOTICE_POLL_INTERVAL_SECONDS=300
NOTICE_POLL_LOOKBACK_MINUTES=60
NOTICE_POLL_OVERLAP_MINUTES=5
NOTICE_POLL_PAGE_SIZE=100
NOTICE_POLL_MAX_PAGES=10
NOTICE_POLL_BUSINESS_TYPES=SERVICE,GOODS,CONSTRUCTION,FOREIGN
NOTICE_HISTORY_BACKFILL_BATCH_SIZE=10
NOTICE_HISTORY_BACKFILL_RETRY_MINUTES=15

# Qualification Requirement Analysis
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
