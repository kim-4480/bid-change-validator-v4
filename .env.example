G2B_SERVICE_KEY=replace_with_your_service_key

POSTGRES_DB=bidjigi
POSTGRES_USER=bidjigi
POSTGRES_PASSWORD=bidjigi_local_password
POSTGRES_PORT=55432
# These existing Docker volumes are required; Compose must not initialize an empty DB.
PG17_DATA_VOLUME=bidcheck_v4_supabase_pg17_20261008
NOTICE_DOCUMENTS_VOLUME=bid-change-validator-v4_notice_documents_data
# Identity of the restored PostgreSQL 17 cluster; override only after verifying a different restore.
PG17_EXPECTED_SYSTEM_ID=7694180214230085666
DATABASE_URL=postgresql+psycopg://bidjigi:bidjigi_local_password@db:5432/bidjigi
# Inside Compose use db:5432; from Windows use 127.0.0.1:55432.
DATABASE_POOL_MODE=auto
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
NOTICE_POLLER_DATABASE_POOL_SIZE=1
NOTICE_POLLER_DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
MIGRATION_DATABASE_URL=
API_PORT=18000
APP_ENVIRONMENT=development
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_REQUIRED=false
DOCUMENT_STORAGE_BACKEND=LOCAL
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=notice-documents
DOCUMENT_S3_ENDPOINT_URL=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NOTICE_POLL_INTERVAL_SECONDS=300
NOTICE_POLL_LOOKBACK_MINUTES=60
NOTICE_POLL_OVERLAP_MINUTES=5
NOTICE_POLL_PAGE_SIZE=100
NOTICE_POLL_MAX_PAGES=10
NOTICE_POLL_BUSINESS_TYPES=SERVICE,GOODS,CONSTRUCTION,FOREIGN
NOTICE_HISTORY_BACKFILL_BATCH_SIZE=10
NOTICE_HISTORY_BACKFILL_RETRY_MINUTES=15

# Qualification Requirement Analysis
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
# 참가자격 추출 방식: legacy(모델이 경계·원문까지 정함) | clause(코드가 조항을 나누고 모델은 라벨만)
BIDENGINE_EXTRACTION_MODE=legacy
# 맥락 가드: on 이면 조항의 극성(요구·배제·예외)을 모델에게 물어 '또는'·'아닌 자' 같은 낱말 가드를 다시 판단한다.
# clause 방식에서 효과가 있다(docs/experiments/2026-10-02-context-guard.md). 조항당 호출이 한 번 더 든다.
BIDENGINE_POLARITY_GUARD=off
# 조항 선택: code(제목·키워드) | hybrid(코드 ∪ 모델) | model(모델이 고른 조항만). clause 방식에서만 쓴다.
# 측정에서는 clause + POLARITY_GUARD=on + hybrid 조합이 가장 정확했다(docs/experiments/2026-10-03-clause-selection.md).
BIDENGINE_CLAUSE_SELECTION=code
