[{"block_index": 0, "section_index": 0, "paragraph_index": 0, "location": "section 1 · paragraph 1", "text": "[별지서식 2] 과업지시서"}, {"block_index": 1, "section_index": 0, "paragraph_index": 2, "location": "section 1 · paragraph 3", "text": "대한민국을 대표하는 경남의 국가거점국립대학"}, {"block_index": 2, "section_index": 0, "paragraph_index": 4, "location": "section 1 · paragraph 5", "text": "2026년 실험실 글로벌 시장 창업탐색 운영 용역"}, {"block_index": 3, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "(싱가포르 SWITCH) 과업지시서"}, {"block_index": 4, "section_index": 0, "paragraph_index": 7, "location": "section 1 · paragraph 8", "text": "2026. 10."}, {"block_index": 5, "section_index": 0, "paragraph_index": 9, "location": "section 1 · paragraph 10", "text": "경상국립대학교 산학협력단"}, {"block_index": 6, "section_index": 0, "paragraph_index": 11, "location": "section 1 · paragraph 12", "text": "1"}, {"block_index": 7, "section_index": 0, "paragraph_index": 12, "location": "section 1 · paragraph 13", "text": "과업개요"}, {"block_index": 8, "section_index": 0, "paragraph_index": 13, "location": "section 1 · paragraph 14", "text": "가. 과 업 명 : 2026년 실험실 글로벌 시장 창업탐색 운영 용역(싱가포르 SWITCH)"}, {"block_index": 9, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "나. 과업기간 : 계약일로부터 ~ 11. 13.(금)"}, {"block_index": 10, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "다. 과업예산 : 금팔천사백만원(￦84,000,000) 이내"}, {"block_index": 11, "section_index": 0, "paragraph_index": 16, "location": "section 1 · paragraph 17", "text": "(국내비용 및 수수료에 대한 세금계산서발행)"}, {"block_index": 12, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "라. 과업목적"}, {"block_index": 13, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "- 아시아 최대 규모의 글로벌 혁신기술 전시회(SWITCH) 참가를 통해 부스 운영, IR 피칭, 비즈니스 매칭 등을 수행하고 글로벌 시장 검증 및 사업화 가능성 모색"}, {"block_index": 14, "section_index": 0, "paragraph_index": 19, "location": "section 1 · paragraph 20", "text": "- 투자자 및 기업과의 밋업(Meet-up)을 통한 실질적인 글로벌 투자 연계 촉진"}, {"block_index": 15, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "- 참여대학 간 협업을 통한 프로그램 기획·운영 효율성 제고 및 성과 극대화"}, {"block_index": 16, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "2"}, {"block_index": 17, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "과업내용"}, {"block_index": 18, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "가. 과업내용"}, {"block_index": 19, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "- 참가자(교수, 학생, 인솔자) 왕복 항공권 예약, 발권 및 취소/변경 관리"}, {"block_index": 20, "section_index": 0, "paragraph_index": 26, "location": "section 1 · paragraph 27", "text": "- 현지 이동 및 일정 고려한 현지 숙소 선정, 예약 및 운영 관리"}, {"block_index": 21, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "- 현지 공항-숙소-행사장 간 전용 수송 차량(임차버스 등) 배치 및 운행 관리"}, {"block_index": 22, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "- 일정 중 식사 제공, 식당 예약 및 현지 단체 이동 안전 관리"}, {"block_index": 23, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "- 참여교수, 학생 및 인솔자 지원(사전오리엔테이션 포함)"}, {"block_index": 24, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "- 학생 역량 강화를 위한 전문 멘토링 프로그램 구성 및 멘토 매칭"}, {"block_index": 25, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "- 현지 과제 수행, 피드백 세션 및 최종 결과보고회 운영"}, {"block_index": 26, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "- 과업 수행 결과보고서 제작 및 정산 관련 증빙 자료 제출"}, {"block_index": 27, "section_index": 0, "paragraph_index": 33, "location": "section 1 · paragraph 34", "text": "- 기타 사업의 성공적인 추진을 위해 사업단이 요청하는 사항"}, {"block_index": 28, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "나. 행사 개요"}, {"block_index": 29, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "- 행 사 명: 2026년 실험실 글로벌 시장 창업탐색 프로그램 (싱가포르 SWITCH)"}, {"block_index": 30, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": "- 행사일정: 2026. 10. 26.(월) ~ 10. 30.(금), 3박 5일"}, {"block_index": 31, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "- 행사장소: 싱가포르 마리나베이 일대 등"}, {"block_index": 32, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "3"}, {"block_index": 33, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": "세부일정"}, {"block_index": 34, "section_index": 0, "paragraph_index": 42, "location": "section 1 · paragraph 43", "text": "단계별 추진 일정"}, {"block_index": 35, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "10월"}, {"block_index": 36, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": "10월"}, {"block_index": 37, "section_index": 0, "paragraph_index": 45, "location": "section 1 · paragraph 46", "text": "11월"}, {"block_index": 38, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "2주"}, {"block_index": 39, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": "3주"}, {"block_index": 40, "section_index": 0, "paragraph_index": 48, "location": "section 1 · paragraph 49", "text": "4주"}, {"block_index": 41, "section_index": 0, "paragraph_index": 49, "location": "section 1 · paragraph 50", "text": "1주"}, {"block_index": 42, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "오리엔테이션"}, {"block_index": 43, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": "항공‧식사‧숙박 등 준비"}, {"block_index": 44, "section_index": 0, "paragraph_index": 52, "location": "section 1 · paragraph 53", "text": "현지프로그램 준비"}, {"block_index": 45, "section_index": 0, "paragraph_index": 53, "location": "section 1 · paragraph 54", "text": "현지일정 운영"}, {"block_index": 46, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": "결과‧정산보고"}, {"block_index": 47, "section_index": 0, "paragraph_index": 56, "location": "section 1 · paragraph 57", "text": "4"}, {"block_index": 48, "section_index": 0, "paragraph_index": 57, "location": "section 1 · paragraph 58", "text": "수행과업 범위"}, {"block_index": 49, "section_index": 0, "paragraph_index": 58, "location": "section 1 · paragraph 59", "text": "가. 정량적 목표"}, {"block_index": 50, "section_index": 0, "paragraph_index": 59, "location": "section 1 · paragraph 60", "text": "❍ 과업내용: 2026년 실험실 글로벌 시장 창업탐색 운영 용역(싱가포르 SWITCH)"}, {"block_index": 51, "section_index": 0, "paragraph_index": 60, "location": "section 1 · paragraph 61", "text": "❍ 참가인원: 20명 내외"}, {"block_index": 52, "section_index": 0, "paragraph_index": 61, "location": "section 1 · paragraph 62", "text": "❍ 결 과 물: 프로그램 운영에 대한 자율양식의 결과보고서"}, {"block_index": 53, "section_index": 0, "paragraph_index": 62, "location": "section 1 · paragraph 63", "text": "※ 결과보고서 내 활동사진 운영 및 교육에 따른 세부내용은 필히 기입"}, {"block_index": 54, "section_index": 0, "paragraph_index": 64, "location": "section 1 · paragraph 65", "text": "5"}, {"block_index": 55, "section_index": 0, "paragraph_index": 65, "location": "section 1 · paragraph 66", "text": "과업수행 지침"}, {"block_index": 56, "section_index": 0, "paragraph_index": 66, "location": "section 1 · paragraph 67", "text": "가. 과업 수행자는 과업지시서에 의해 과업을 수행하되 규정하지 아니한 사항은 관계 법령 및 경상국립대학교 산학협력단의 제반 규정에 의해 성실히 수행하여야 한다."}, {"block_index": 57, "section_index": 0, "paragraph_index": 67, "location": "section 1 · paragraph 68", "text": "나. 본 과업에 명시되지 않은 사항이 발생한 경우 예산 및 범위 내에서 수행 방향을 재조정할 수 있으며, 사업내용의 변경이나 조정이 필요한 경우 경상국립대학교 산학협력단과 협의하여 결정한다."}, {"block_index": 58, "section_index": 0, "paragraph_index": 68, "location": "section 1 · paragraph 69", "text": "다. 사업 내용 및 예산의 변경 사항에 있어서는 사전에 경상국립대학교 산학협력단에 변경신청을 하고 이를 승인 받아야 한다."}, {"block_index": 59, "section_index": 0, "paragraph_index": 69, "location": "section 1 · paragraph 70", "text": "라. 본 과업에 참여하는 참여 인력은 수행업무 분야에 전문지식과 자격을 갖추고 풍부한 경험이 있는 자로 구성한다."}, {"block_index": 60, "section_index": 0, "paragraph_index": 70, "location": "section 1 · paragraph 71", "text": "마. 과업 수행자는 사업수행 기간 내에 사업을 완료하여야 하며, 사업수행자의 구책 사유로 인하여 기간 내에 사업을 완료하지 못할 경우 관계 규정에 의해 계약 위반금 지급 또는 계약 해지를 할 수 있다."}, {"block_index": 61, "section_index": 0, "paragraph_index": 71, "location": "section 1 · paragraph 72", "text": "바. 과업수행자가 과업을 수행하는 중 취득한 과업과 관련된 자료 및 정보의 외부유출로 인하여 발생하는 민‧형사상의 모든 책임은 과업수행자에게 있다."}, {"block_index": 62, "section_index": 0, "paragraph_index": 72, "location": "section 1 · paragraph 73", "text": "사. 다음 각 호에 해당하는 경우 당해 계약의 전부 또는 일부를 계약 해제 또는 해지할 수 있으며, 이 경우 과업수행자는 손해배상 등 민‧형사상 책임 일체의 요구를 할 수 없다."}, {"block_index": 63, "section_index": 0, "paragraph_index": 73, "location": "section 1 · paragraph 74", "text": "① 정당한 이유 없이 약정한 착수기일을 경과하고도 과업수행에 착수하지 않을 경우"}, {"block_index": 64, "section_index": 0, "paragraph_index": 74, "location": "section 1 · paragraph 75", "text": "② 계약서상의 과업수행기간 이내에 과업을 완료하지 못하거나 과업 수행 업체의 명백한 귀책사유로 인해 과업을 완료할 가능성이 없다고 인정되는 경우"}, {"block_index": 65, "section_index": 0, "paragraph_index": 75, "location": "section 1 · paragraph 76", "text": "③ 업체 선정 시 제출한 제안서의 내용과 실제 과업수행내용, 회사 소개 내용등에 중대한 차이가 있어 적절한 과업수행을 기대할 수 없는 경우"}, {"block_index": 66, "section_index": 0, "paragraph_index": 76, "location": "section 1 · paragraph 77", "text": "④ 사전 승인 없이 과업 내용을 변경하는 경우"}, {"block_index": 67, "section_index": 0, "paragraph_index": 77, "location": "section 1 · paragraph 78", "text": "⑤ 기타 과업수행에 있어 발주처의 정당한 요구사항을 이행하지 않을 경우"}, {"block_index": 68, "section_index": 0, "paragraph_index": 78, "location": "section 1 · paragraph 79", "text": "아. 본 과업수행과 관련된 참여 인력이 부적격하다고 인정될 경우 경상국립대학교 산학협력단은 사업수행자에게 교체를 요구할 수 있으며, 사업수행자는 타당한 이유가 없는 한 이에 따른다."}, {"block_index": 69, "section_index": 0, "paragraph_index": 79, "location": "section 1 · paragraph 80", "text": "자. 사업 진행 과정에서 경상국립대학교 산학협력단이 추가 요청하는 사항은 협상 완료한 과업 범위 내에서 적극 반영하도록 한다."}, {"block_index": 70, "section_index": 0, "paragraph_index": 81, "location": "section 1 · paragraph 82", "text": "6"}, {"block_index": 71, "section_index": 0, "paragraph_index": 82, "location": "section 1 · paragraph 83", "text": "기타사항"}, {"block_index": 72, "section_index": 0, "paragraph_index": 83, "location": "section 1 · paragraph 84", "text": "가. 본 과업지시서는 과업수행을 위한 사항을 규정 하였는바, 이에 규정되지 아니한 사항은 용역 관련 법령 및 지침 등에 따라 발주기관과 협의하여 하여야 한다."}, {"block_index": 73, "section_index": 0, "paragraph_index": 84, "location": "section 1 · paragraph 85", "text": "나. 본 과업 수행 시 수급자가 제3자에게 피해를 주었을 경우, 수급자는 손실 보상하여야 한다."}]