[{"block_index": 0, "section_index": 0, "paragraph_index": 0, "location": "section 1 · paragraph 1", "text": "인천대학교 공고[재무2026–81호]"}, {"block_index": 1, "section_index": 0, "paragraph_index": 1, "location": "section 1 · paragraph 2", "text": "용 역 입 찰 공 고"}, {"block_index": 2, "section_index": 0, "paragraph_index": 2, "location": "section 1 · paragraph 3", "text": "1. 입찰에 부치는 사항"}, {"block_index": 3, "section_index": 0, "paragraph_index": 4, "location": "section 1 · paragraph 5", "text": "발주기관"}, {"block_index": 4, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "인천대학교"}, {"block_index": 5, "section_index": 0, "paragraph_index": 6, "location": "section 1 · paragraph 7", "text": "공 고 명"}, {"block_index": 6, "section_index": 0, "paragraph_index": 7, "location": "section 1 · paragraph 8", "text": "네트워크 장비 교체사업"}, {"block_index": 7, "section_index": 0, "paragraph_index": 8, "location": "section 1 · paragraph 9", "text": "입찰개요"}, {"block_index": 8, "section_index": 0, "paragraph_index": 9, "location": "section 1 · paragraph 10", "text": "과업기간"}, {"block_index": 9, "section_index": 0, "paragraph_index": 10, "location": "section 1 · paragraph 11", "text": "계약일로부터 120일"}, {"block_index": 10, "section_index": 0, "paragraph_index": 11, "location": "section 1 · paragraph 12", "text": "과업내용"}, {"block_index": 11, "section_index": 0, "paragraph_index": 12, "location": "section 1 · paragraph 13", "text": "제안요청서 참조"}, {"block_index": 12, "section_index": 0, "paragraph_index": 13, "location": "section 1 · paragraph 14", "text": "기초금액"}, {"block_index": 13, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "(추정가격+부가가치세)"}, {"block_index": 14, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "금2,800,000,000원"}, {"block_index": 15, "section_index": 0, "paragraph_index": 16, "location": "section 1 · paragraph 17", "text": "입찰서제출"}, {"block_index": 16, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "개시일시"}, {"block_index": 17, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "2026.10.01.(목) 10:00"}, {"block_index": 18, "section_index": 0, "paragraph_index": 19, "location": "section 1 · paragraph 20", "text": "계약방법"}, {"block_index": 19, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "일반(총액)경쟁"}, {"block_index": 20, "section_index": 0, "paragraph_index": 21, "location": "section 1 · paragraph 22", "text": "협상에의한계약"}, {"block_index": 21, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "입찰서제출"}, {"block_index": 22, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "마감일시"}, {"block_index": 23, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "2026.10.06.(화) 10:00"}, {"block_index": 24, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "개찰일시"}, {"block_index": 25, "section_index": 0, "paragraph_index": 26, "location": "section 1 · paragraph 27", "text": "제안서 평가 완료 후"}, {"block_index": 26, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "낙찰방법"}, {"block_index": 27, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "협상에 의한 낙찰자 결정"}, {"block_index": 28, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "2. 입찰서 제출 및 개찰일정"}, {"block_index": 29, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "가. 입찰서 제출기간 및 장소"}, {"block_index": 30, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "- 제출기간: 2026. 10. 01.(목) 10:00 ~ 2026. 10. 06.(화) 10:00"}, {"block_index": 31, "section_index": 0, "paragraph_index": 33, "location": "section 1 · paragraph 34", "text": "- 제출장소: 국가종합전자조달시스템(G2B) 전자입찰서 제출"}, {"block_index": 32, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "나. 개찰일시 및 장소: 2026. 10. 06.(화) 11:00 인천대학교 입찰집행관 PC"}, {"block_index": 33, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "※ 전산장애 발생 시 개찰시간이 다소 지연되거나 연기될 수 있음"}, {"block_index": 34, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": "다. 제출서류"}, {"block_index": 35, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "(1) 정량적 평가 제안서"}, {"block_index": 36, "section_index": 0, "paragraph_index": 38, "location": "section 1 · paragraph 39", "text": "(2) 정성적 평가 제안서"}, {"block_index": 37, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "(3) 제안 설명회 발표자료"}, {"block_index": 38, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": "(4) 기타 제안요청서 붙임 서식"}, {"block_index": 39, "section_index": 0, "paragraph_index": 41, "location": "section 1 · paragraph 42", "text": "(5) 기타서류(입찰참가자격관련 서류)"}, {"block_index": 40, "section_index": 0, "paragraph_index": 42, "location": "section 1 · paragraph 43", "text": "㉮ 나라장터에서 출력한 “경쟁입찰참가자격등록증” 1부"}, {"block_index": 41, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "㉯ 법인 등기사항증명서(개인사업자인 경우 사업자등록증) 1부"}, {"block_index": 42, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": "3. 입찰 참가자의 자격에 관한 사항"}, {"block_index": 43, "section_index": 0, "paragraph_index": 45, "location": "section 1 · paragraph 46", "text": "가. 정보통신공사업 제14조에 따른 사업자 신고를 필하여 정보통신공사업(0036) 업종을 등록한 업체"}, {"block_index": 44, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "나. 계약상대자는 대가를 지급받은 경우 15일 이내에 하도급대금을 하수급인에게 현금으로 지급하여야 하며, 하도급대금의 지급 내역(수령자, 지급액, 지급일 등)을 5일(공휴일 및 토요일은 제외한다) 이내에 계약담당자에게 통보하여야 합니다."}, {"block_index": 45, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": "다. 공동수급(공동이행방식)을 허용하며, 공동수급체 구성원은 대표사를 포함하여 5개 이하로 구성 및 구성원별 최소 지분율은 10% 이상으로 하여야 합니다."}, {"block_index": 46, "section_index": 0, "paragraph_index": 48, "location": "section 1 · paragraph 49", "text": "라. ｢국가계약법｣ 제27조의5 및 ｢국가계약법 시행령｣ 제12조 제3항에 따라‘조세포탈 등을 한 자’로서 유죄판결이 확정된 날부터 2년이 지나지 아니한 자는 입찰에 참여할 수 없습니다."}, {"block_index": 47, "section_index": 0, "paragraph_index": 49, "location": "section 1 · paragraph 50", "text": "4. 낙찰자 결정 방법"}, {"block_index": 48, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "가. 낙찰자 선정방법"}, {"block_index": 49, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": "- 협상적격자는 입찰가격이 해당 사업예산(예정가격을 작성한 경우에는 예정가격) 이하인 자로서 기술능력평가 점수가 기술능력평가분야의 배점한도의 85%이상인 자 중에서 선정합니다."}, {"block_index": 50, "section_index": 0, "paragraph_index": 52, "location": "section 1 · paragraph 53", "text": "- 협상순서는 기술능력평가 90점 / 입찰가격평가 10점을 종합평가 결과가 고득점자순으로 진행하며, 합산점수가 동일한 제안자가 2인 이상일 경우에는 기술능력 평가점수가 높은 제안자를 우선순위자로 하고, 기술능력 평가점수도 동일한 경우에는 기술능력의 세부평가항목 중 배점이 큰 항목에서 높은 점수를 얻은 자를 우선순위자로 합니다."}, {"block_index": 51, "section_index": 0, "paragraph_index": 53, "location": "section 1 · paragraph 54", "text": "- 가격입찰서와 제안서는 순서에 상관없이 제출 가능하며, 가격입찰서와 제안서 중 어느 하나라도 제출하지 않은 경우에는 무효입찰 처리됩니다. 따라서 입찰자는 보낸 문서함에서 가격입찰서와 제안서가 이상없이 제출되었음을 확인하시기 바랍니다."}, {"block_index": 52, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": "- 제안서 평가는 수요기관에서 직접 평가위원을 구성하여 평가하며, 평가일시 및 장소는 수요기관에서 별도 공지할 예정입니다."}, {"block_index": 53, "section_index": 0, "paragraph_index": 55, "location": "section 1 · paragraph 56", "text": "- 기타 평가 관련 사항은 「협상에 의한 계약 체결기준」에 따릅니다."}, {"block_index": 54, "section_index": 0, "paragraph_index": 56, "location": "section 1 · paragraph 57", "text": "5. 입찰보증금의 납부 및 귀속"}, {"block_index": 55, "section_index": 0, "paragraph_index": 57, "location": "section 1 · paragraph 58", "text": "가. 국가를 당사자로 하는 계약에 관한 법률 제9조 및 동법 시행령 제37조 규정에 의거 입찰보증금 납부는 면제(입찰보증금 납부를 확약하는 내용이 포함된 입찰참가신청서 제출로 납부를 갈음)합니다."}, {"block_index": 56, "section_index": 0, "paragraph_index": 58, "location": "section 1 · paragraph 59", "text": "나. 국가를 당사자로 하는 계약에 관한 법률 제9조 제3항 및 동법 시행령 제38조에 의한 세입조치사유가 발생한 경우에는 입찰보증금 납부확약 내용에 따라 입찰금액의 100분의5에 해당하는 금액을 납부하여야 합니다."}, {"block_index": 57, "section_index": 0, "paragraph_index": 59, "location": "section 1 · paragraph 60", "text": "6. 입찰의 무효"}, {"block_index": 58, "section_index": 0, "paragraph_index": 60, "location": "section 1 · paragraph 61", "text": "국가를 당사자로 하는 계약에 관한 법률 시행령 제39조 제4항, 동법 시행규칙 제44조 및『용역입찰유의서』제12조에 해당하는 입찰은 무효입니다."}, {"block_index": 59, "section_index": 0, "paragraph_index": 61, "location": "section 1 · paragraph 62", "text": "7. 기타사항"}, {"block_index": 60, "section_index": 0, "paragraph_index": 62, "location": "section 1 · paragraph 63", "text": "가. 입찰참가자는 국가계약법령, 계약예규, 고시(조달청 국가종합전자조달시스템 전자입찰특별유의서 등), 통첩, 공고사항, 이용약관, 안내서, 공지사항 등을 숙지 ․ 준수하여야 하며, 이에 따르지 아니하여 발생하는 불이익에 대한 책임은 입찰자에게 있습니다."}, {"block_index": 61, "section_index": 0, "paragraph_index": 63, "location": "section 1 · paragraph 64", "text": "나. 일할 계산하여 용역대금이 산정되는 경우 대금지급은 계약체결 후 실제 용역 제공일수에 따라 일할 계산하여 지급합니다."}, {"block_index": 62, "section_index": 0, "paragraph_index": 64, "location": "section 1 · paragraph 65", "text": "다. 이 공고문에 특별히 언급되지 아니한 사항은 전자입찰공고일 현재 시행중인 국가계약 법령 등에 의합니다."}, {"block_index": 63, "section_index": 0, "paragraph_index": 65, "location": "section 1 · paragraph 66", "text": "라. 수요기관은 「중대재해처벌법 시행령」 제4조 제9호에 따라 계약자가 동 법 제4조 및 제5조에 규정된 안전·보건과 관련된 의무를 준수하는지 평가·점검할 수 있으며, 계약자는 수요기관이 평가·점검을 실시하는 경우 이에 협조하여야 합니다."}, {"block_index": 64, "section_index": 0, "paragraph_index": 66, "location": "section 1 · paragraph 67", "text": "마. 문의사항"}, {"block_index": 65, "section_index": 0, "paragraph_index": 67, "location": "section 1 · paragraph 68", "text": "- 전자입찰 이용안내 : 정부조달 콜센터(1588-0800)"}, {"block_index": 66, "section_index": 0, "paragraph_index": 68, "location": "section 1 · paragraph 69", "text": "- 계약관련사항 : 인천대학교 재무회계과 최정혁(032-835-9387)"}, {"block_index": 67, "section_index": 0, "paragraph_index": 69, "location": "section 1 · paragraph 70", "text": "- 사업관련사항 : 인천대학교 정보전산과 염기남(032-835-9457)"}, {"block_index": 68, "section_index": 0, "paragraph_index": 70, "location": "section 1 · paragraph 71", "text": "2026. 9. 24."}, {"block_index": 69, "section_index": 0, "paragraph_index": 71, "location": "section 1 · paragraph 72", "text": "인 천 대 학 교 재 무 원"}, {"block_index": 70, "section_index": 0, "paragraph_index": 73, "location": "section 1 · paragraph 74", "text": "< 본 계약은 청렴계약(서약)제가 적용됩니다 >"}, {"block_index": 71, "section_index": 0, "paragraph_index": 74, "location": "section 1 · paragraph 75", "text": "본 계약은 「국가를 당사자로 하는 계약에 관한 법률」에 따른 청렴계약제가 적용됩니다. 입찰자는 반드시 입찰서 제출시 아래의 청렴계약서에 관한 내용을 숙지․승낙하여야 하며, 동 내용을 위반한 경우 발주기관의 조치에 대하여 어떠한 이의도 제기할 수 없습니다."}, {"block_index": 72, "section_index": 0, "paragraph_index": 75, "location": "section 1 · paragraph 76", "text": "「국가를 당사자로 하는 계약에 관한 법률」에 따라 본 입찰에 참여한 당사 대리인과 임직원은 입찰․낙찰, 계약체결 또는 계약이행 등의 과정(준공․납품 이후를 포함한다)에서 아래 각 호의 청렴계약 조건을 준수할 것이며, 이를 위반할 때에는 입찰․낙찰을 취소하거나 계약을 해제․해지하는 등의 불이익을 감수하고, 이에 민․형사상 이의를 제기하지 않을 것임을 약정합니다."}, {"block_index": 73, "section_index": 0, "paragraph_index": 76, "location": "section 1 · paragraph 77", "text": "1. 금품․향응 등을 요구 또는 약속하거나 수수(授受)하지 않을 것이며, 관계공무원에게 금품, 향응 등을 제공한 경우에는 「국가를 당사자로 하는 계약에 관한 법률 시행령」에 따른 부정당업자의 입찰참가자격 제한 처분을 받겠습니다."}, {"block_index": 74, "section_index": 0, "paragraph_index": 77, "location": "section 1 · paragraph 78", "text": "2. 입찰가격의 사전 협의 또는 특정인의 낙찰을 위한 담합 등 공정한 경쟁을 방해하는 행위시에는 「국가를 당사자로 하는 계약에 관한 법률 시행령」에 따른 부정당업자의 입찰참가자격 제한 처분을 받겠습니다."}, {"block_index": 75, "section_index": 0, "paragraph_index": 78, "location": "section 1 · paragraph 79", "text": "3. 공정한 직무수행을 방해하는 알선․청탁을 통하여 입찰 또는 계약과 관련된 특정 정보의 제공을 요구하거나 받는 행위를 하지 않겠습니다."}]