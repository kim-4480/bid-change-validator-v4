[{"block_index": 0, "section_index": 0, "paragraph_index": 0, "location": "section 1 · paragraph 1", "text": "입찰공고 제2026 - 94호"}, {"block_index": 1, "section_index": 0, "paragraph_index": 1, "location": "section 1 · paragraph 2", "text": "입 찰 공 고 문"}, {"block_index": 2, "section_index": 0, "paragraph_index": 2, "location": "section 1 · paragraph 3", "text": "1. 입찰에 부치는 사항"}, {"block_index": 3, "section_index": 0, "paragraph_index": 3, "location": "section 1 · paragraph 4", "text": "○ 용 역 명 : [앵커] 생성형 AI 융합 K-pop 송캠프 운영 용역"}, {"block_index": 4, "section_index": 0, "paragraph_index": 4, "location": "section 1 · paragraph 5", "text": "○ 사업예산 : 금22,000,000원(금이천이백만원) - 부가세 포함"}, {"block_index": 5, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "○ 입찰방법 : (실적)제한경쟁입찰(협상에 의한 계약 체결)"}, {"block_index": 6, "section_index": 0, "paragraph_index": 6, "location": "section 1 · paragraph 7", "text": "○ 과업기간 : 계약체결일 ~ 2026.12.09. 까지"}, {"block_index": 7, "section_index": 0, "paragraph_index": 8, "location": "section 1 · paragraph 9", "text": "2. 수행내역 : 붙임(과업지시서) 확인"}, {"block_index": 8, "section_index": 0, "paragraph_index": 9, "location": "section 1 · paragraph 10", "text": "3. 일정 및 장소"}, {"block_index": 9, "section_index": 0, "paragraph_index": 11, "location": "section 1 · paragraph 12", "text": "구 분"}, {"block_index": 10, "section_index": 0, "paragraph_index": 12, "location": "section 1 · paragraph 13", "text": "일 시"}, {"block_index": 11, "section_index": 0, "paragraph_index": 13, "location": "section 1 · paragraph 14", "text": "비 고"}, {"block_index": 12, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "입찰공고"}, {"block_index": 13, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "2026.09.14.(월) ~"}, {"block_index": 14, "section_index": 0, "paragraph_index": 16, "location": "section 1 · paragraph 17", "text": "국가종합전자조달시스템(G2B) 및 대학홈페이지"}, {"block_index": 15, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "가격입찰서 접수"}, {"block_index": 16, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "2026.09.15.(화) 09:00"}, {"block_index": 17, "section_index": 0, "paragraph_index": 19, "location": "section 1 · paragraph 20", "text": "~ 2026.09.28.(월) 11:00"}, {"block_index": 18, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "나라장터(G2B) 전자 제출"}, {"block_index": 19, "section_index": 0, "paragraph_index": 21, "location": "section 1 · paragraph 22", "text": "(※ 부가세 포함 총액 투찰)"}, {"block_index": 20, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "제안서 접수"}, {"block_index": 21, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "2026.09.28.(월), 09:00 ~ 11:00"}, {"block_index": 22, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "오프라인 방문 제출 (명지전문대학 사회교육관 106호 구매시설팀)"}, {"block_index": 23, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "기술능력평가"}, {"block_index": 24, "section_index": 0, "paragraph_index": 26, "location": "section 1 · paragraph 27", "text": "2026.09.29.(화), 09:30 ~ 13:00"}, {"block_index": 25, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "평가위원 서면평가"}, {"block_index": 26, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "입찰가격평가(개찰)"}, {"block_index": 27, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "2026.09.29.(화), 14:00 이후"}, {"block_index": 28, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "기술능력평가 완료 후 나라장터(G2B) 개찰"}, {"block_index": 29, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "4. 입찰참가자격[아래의 조건을 모두 충족(낙찰자는 계약체결일까지)해야 함, 공동수급불가]"}, {"block_index": 30, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "○ 「국가를 당사자로 하는 계약에 관한 법률」 시행령 제12조 및 시행규칙 제14조에 의한 유자격자"}, {"block_index": 31, "section_index": 0, "paragraph_index": 33, "location": "section 1 · paragraph 34", "text": "○ 공고일 기준 동법 시행령 제76조에 의한 부정당업자에 해당하지 않는 업체"}, {"block_index": 32, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "○ 「대중문화예술산업발전법」 제26조에 따른 대중문화예술기획업 등록을 필하고, 음반·음악영상물제작업으로 신고된 업체"}, {"block_index": 33, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "○ 최근 3년 이내 지자체 관내 지역 주민 및 대학생(또는 고등학생)을 대상으로 'K-pop 관련 캠프' 또는 유사한 음악·영상 콘텐츠 창작 교육 프로그램을 성공적으로 운영한 실적을 보유한 업체"}, {"block_index": 34, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": "○ 본 사업의 성격상 단독 진행이 가능하며, 본 대학의 선정 및 평가 방식에 이의가 없음을 확인한 업체"}, {"block_index": 35, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "5. 입찰참가등록 절차"}, {"block_index": 36, "section_index": 0, "paragraph_index": 38, "location": "section 1 · paragraph 39", "text": "*본 입찰은 전자입찰(가격)과 방문접수(제안서 및 증빙서류) 병행 방식입니다."}, {"block_index": 37, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "○ 가격입찰서 제출: 나라장터(G2B)를 통해 부가세를 포함한 총액으로 전자 투찰"}, {"block_index": 38, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": "○ 오프라인 제출 서류: (※ 9월 28일 09:00~11:00 사이 방문 제출)"}, {"block_index": 39, "section_index": 0, "paragraph_index": 41, "location": "section 1 · paragraph 42", "text": "① 제안서 10부 및 원본 파일 저장 USB 1매"}, {"block_index": 40, "section_index": 0, "paragraph_index": 42, "location": "section 1 · paragraph 43", "text": "② 입찰참가신청서 1부 *아래 별첨 서식 사용"}, {"block_index": 41, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "③ 사업자등록증 사본 1부"}, {"block_index": 42, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": "④ 대중문화예술기획업 등록증, 음반·음악영상물제작업 신고증 사본 각 1부"}, {"block_index": 43, "section_index": 0, "paragraph_index": 45, "location": "section 1 · paragraph 46", "text": "⑤ 법인등기부등본(법인) 또는 주민등록초본(개인) 1부"}, {"block_index": 44, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "⑥ 인감증명서 및 사용인감계 각 1부 (※ 접수 시 인감 또는 사용인감 지참)"}, {"block_index": 45, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": "⑦ 국세 및 지방세 완납증명서 각 1부"}, {"block_index": 46, "section_index": 0, "paragraph_index": 48, "location": "section 1 · paragraph 49", "text": "⑧ 사업 실적 증명서(최근 3년 이내) 각 1부"}, {"block_index": 47, "section_index": 0, "paragraph_index": 49, "location": "section 1 · paragraph 50", "text": "⑨ 대표자 위임장 및 재직증명서 각 1부(대리인 접수 시)"}, {"block_index": 48, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "⑩ 입찰금액의 10% 이상에 해당하는 입찰(이행)보증보험증권 1부(온라인 전자제출 병행)"}, {"block_index": 49, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": "※ 증권발행시 사업자 등록번호 : 명지전문대학, 110-82-01296"}, {"block_index": 50, "section_index": 0, "paragraph_index": 52, "location": "section 1 · paragraph 53", "text": "⑪ 그 외 입찰등록 구비서류(★) 1식 *과업지시서 붙임서류 참조"}, {"block_index": 51, "section_index": 0, "paragraph_index": 53, "location": "section 1 · paragraph 54", "text": "6. 기술능력평가 및 입찰가격평가"}, {"block_index": 52, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": "○ 기술능력평가(80점): 제출된 제안서를 바탕으로 한 서면평가로 진행되며, 별도의 업체 출석 및 제안 발표(PT)는 없습니다. 평가 결과는 비공개합니다."}, {"block_index": 53, "section_index": 0, "paragraph_index": 55, "location": "section 1 · paragraph 56", "text": "○ 입찰가격평가(20점): 기술능력평가 점수 산출 및 나라장터 시스템 등록 완료 후 개찰 진행."}, {"block_index": 54, "section_index": 0, "paragraph_index": 56, "location": "section 1 · paragraph 57", "text": "7. 협상대상자 및 낙찰자 선정"}, {"block_index": 55, "section_index": 0, "paragraph_index": 57, "location": "section 1 · paragraph 58", "text": "○ 기술평가점수(80점)와 가격평가점수(20점)를 합산하여 고득점순으로 우선 협상대상자를 선정함. 단, 기술능력평가 점수가 배점 한도의 85%(68점) 미만인 업체는 협상 대상에서 제외함."}, {"block_index": 56, "section_index": 0, "paragraph_index": 58, "location": "section 1 · paragraph 59", "text": "○ 종합평가점수 동점자 발생 시 기술평가 점수가 높은 업체를 우선하며, 기술평가 점수도 동일한 경우 배점이 큰 평가 항목(추진 계획 및 성과 달성 방안 등)에서 높은 점수를 얻은 업체를 우선순위자로 선정함."}, {"block_index": 57, "section_index": 0, "paragraph_index": 59, "location": "section 1 · paragraph 60", "text": "8. 재공고 입찰"}, {"block_index": 58, "section_index": 0, "paragraph_index": 60, "location": "section 1 · paragraph 61", "text": "○ 2인 이상의 유효한 입찰자가 없거나 낙찰자가 없을 경우"}, {"block_index": 59, "section_index": 0, "paragraph_index": 61, "location": "section 1 · paragraph 62", "text": "○ 낙찰자가 낙찰일로부터 10일 이내에 정당한 사유 없이 계약을 체결하지 아니한 경우"}, {"block_index": 60, "section_index": 0, "paragraph_index": 62, "location": "section 1 · paragraph 63", "text": "○ 낙찰포기, 공고사항 위반 등 낙찰업체의 귀책사유로 계약 체결이 불가능한 경우"}, {"block_index": 61, "section_index": 0, "paragraph_index": 63, "location": "section 1 · paragraph 64", "text": "9. 입찰보증금"}, {"block_index": 62, "section_index": 0, "paragraph_index": 64, "location": "section 1 · paragraph 65", "text": "○ 입찰보증금은 입찰금액의 100분의 10(10%) 이상에 해당하는 입찰보증서(보증보험증권)를 나라장터를 통해 전자제출(오프라인 제출 병행)하여야 합니다."}, {"block_index": 63, "section_index": 0, "paragraph_index": 65, "location": "section 1 · paragraph 66", "text": "(※ 명지전문대학 사업자등록번호: 110-82-01296)"}, {"block_index": 64, "section_index": 0, "paragraph_index": 66, "location": "section 1 · paragraph 67", "text": "○ 낙찰자가 낙찰포기 또는 낙찰일로부터 10일 이내에 정당한 사유 없이 계약을 체결하지 아니 하거나 공고사항 위반 또는 계약세부조건 임의 변경 및 낙찰업체의 귀책사유로 계약 체결이 불가능한 경우 입찰보증금은 본교에 귀속됩니다."}, {"block_index": 65, "section_index": 0, "paragraph_index": 67, "location": "section 1 · paragraph 68", "text": "10. 입찰무효"}, {"block_index": 66, "section_index": 0, "paragraph_index": 68, "location": "section 1 · paragraph 69", "text": "○ 아래의 어느 하나에 해당되는 사업자의 입찰은 무효 처리됩니다."}, {"block_index": 67, "section_index": 0, "paragraph_index": 69, "location": "section 1 · paragraph 70", "text": "① 입찰참가자격이 없는 자가 한 입찰"}, {"block_index": 68, "section_index": 0, "paragraph_index": 70, "location": "section 1 · paragraph 71", "text": "② 입찰보증금의 납부일시까지 소정의 입찰보증금을 납부하지 아니하고 한 입찰"}, {"block_index": 69, "section_index": 0, "paragraph_index": 71, "location": "section 1 · paragraph 72", "text": "③ 동일사항에 동일인(1인이 수개의 법인의 대표자인 경우 해당수개의 법인을 동일인으로 본다)이 2통 이상의 입찰서를 제출한 입찰"}, {"block_index": 70, "section_index": 0, "paragraph_index": 72, "location": "section 1 · paragraph 73", "text": "④ 입찰참가등록 사항 중 “업체의 상호 또는 법인의 명칭, 대표자(대표자가 여럿인 경우에는 대표자 전원)의 성명”이 변경되었으나, 개찰일 전일까지 이 사항을 변경등록하지 아니한 사업자의 입찰"}, {"block_index": 71, "section_index": 0, "paragraph_index": 73, "location": "section 1 · paragraph 74", "text": "⑤ 본 공고 사항을 위반한 사업자의 입찰"}, {"block_index": 72, "section_index": 0, "paragraph_index": 74, "location": "section 1 · paragraph 75", "text": "11. 유의사항"}, {"block_index": 73, "section_index": 0, "paragraph_index": 75, "location": "section 1 · paragraph 76", "text": "○ 입찰자는 공고문 및 제안요청서(과업지시서) 내용을 완전히 숙지하여 입찰에 응하여야 하며, 미숙지로 인한 책임은 입찰자에게 있습니다."}, {"block_index": 74, "section_index": 0, "paragraph_index": 76, "location": "section 1 · paragraph 77", "text": "○ 오프라인 입찰등록서류는 방문 접수만 가능하며 제출된 서류는 일절 반환하지 않습니다."}, {"block_index": 75, "section_index": 0, "paragraph_index": 77, "location": "section 1 · paragraph 78", "text": "○ 제안업체는 평가 결과에 대해 일체의 이의를 제기할 수 없으며 평가 결과는 비공개합니다."}, {"block_index": 76, "section_index": 0, "paragraph_index": 78, "location": "section 1 · paragraph 79", "text": "○ 계약체결 시 계약금액의 10% 이상에 해당하는 이행(계약)보증보험증권을 제출하여야 하며, 미제출 시 본 대학은 계약을 해지할 수 있습니다."}, {"block_index": 77, "section_index": 0, "paragraph_index": 79, "location": "section 1 · paragraph 80", "text": "○ 입찰자가 제출한 제안서 및 규격서 내용이 사실과 다를 경우 계약해제·해지 및 관련 책임을 부담합니다."}, {"block_index": 78, "section_index": 0, "paragraph_index": 80, "location": "section 1 · paragraph 81", "text": "○ 교내 사정에 의해 입찰 일정이 변경·연기 또는 취소될 수 있으며, 입찰 참가자는 이에 대한 책임을 물을 수 없습니다."}, {"block_index": 79, "section_index": 0, "paragraph_index": 81, "location": "section 1 · paragraph 82", "text": "12. 문의처"}, {"block_index": 80, "section_index": 0, "paragraph_index": 82, "location": "section 1 · paragraph 83", "text": "○ 입찰관련 : 구매시설팀 구매담당자(02-300-1038)"}, {"block_index": 81, "section_index": 0, "paragraph_index": 83, "location": "section 1 · paragraph 84", "text": "○ 제안요청서 관련 : AI조기취업학과지원팀 담당자(02-300-3783)"}, {"block_index": 82, "section_index": 0, "paragraph_index": 84, "location": "section 1 · paragraph 85", "text": "붙임 : 과업지시서 1부. 끝."}, {"block_index": 83, "section_index": 0, "paragraph_index": 85, "location": "section 1 · paragraph 86", "text": "2026.09.14."}, {"block_index": 84, "section_index": 0, "paragraph_index": 86, "location": "section 1 · paragraph 87", "text": "명지전문대학 총장"}, {"block_index": 85, "section_index": 0, "paragraph_index": 87, "location": "section 1 · paragraph 88", "text": "<서식 1>"}, {"block_index": 86, "section_index": 0, "paragraph_index": 88, "location": "section 1 · paragraph 89", "text": "입 찰 참 가 신 청 서"}, {"block_index": 87, "section_index": 0, "paragraph_index": 90, "location": "section 1 · paragraph 91", "text": "입찰공고번호"}, {"block_index": 88, "section_index": 0, "paragraph_index": 91, "location": "section 1 · paragraph 92", "text": "제 2026 – 호"}, {"block_index": 89, "section_index": 0, "paragraph_index": 92, "location": "section 1 · paragraph 93", "text": "입찰일자"}, {"block_index": 90, "section_index": 0, "paragraph_index": 93, "location": "section 1 · paragraph 94", "text": "2026.09. ."}, {"block_index": 91, "section_index": 0, "paragraph_index": 94, "location": "section 1 · paragraph 95", "text": "입찰명"}, {"block_index": 92, "section_index": 0, "paragraph_index": 95, "location": "section 1 · paragraph 96", "text": "[RISE] 2026학년도 조기취업형 계약학과 교육용 AI 소프트웨어 구독"}, {"block_index": 93, "section_index": 0, "paragraph_index": 96, "location": "section 1 · paragraph 97", "text": "본인은 위의 공고번호로 공고(지명통지)한 귀교의 일반(제한, 지명 등)경쟁입찰에"}, {"block_index": 94, "section_index": 0, "paragraph_index": 97, "location": "section 1 · paragraph 98", "text": "참가하고자, 귀교에서 정한 입찰공고 및 현장설명사항 등을 모두 승낙하고 붙임 서류를"}, {"block_index": 95, "section_index": 0, "paragraph_index": 98, "location": "section 1 · paragraph 99", "text": "첨 부 하 여 입 찰 참 가 를 신 청 합 니 다."}, {"block_index": 96, "section_index": 0, "paragraph_index": 99, "location": "section 1 · paragraph 100", "text": "붙임 : 입찰등록서류 각 1부."}, {"block_index": 97, "section_index": 0, "paragraph_index": 100, "location": "section 1 · paragraph 101", "text": "2026년 9월 일"}, {"block_index": 98, "section_index": 0, "paragraph_index": 101, "location": "section 1 · paragraph 102", "text": "입찰 참가 신청자 인적사항"}, {"block_index": 99, "section_index": 0, "paragraph_index": 102, "location": "section 1 · paragraph 103", "text": "상호명"}, {"block_index": 100, "section_index": 0, "paragraph_index": 103, "location": "section 1 · paragraph 104", "text": ": 법인인 경우"}, {"block_index": 101, "section_index": 0, "paragraph_index": 104, "location": "section 1 · paragraph 105", "text": "주소"}, {"block_index": 102, "section_index": 0, "paragraph_index": 105, "location": "section 1 · paragraph 106", "text": ":"}, {"block_index": 103, "section_index": 0, "paragraph_index": 106, "location": "section 1 · paragraph 107", "text": "신청자"}, {"block_index": 104, "section_index": 0, "paragraph_index": 107, "location": "section 1 · paragraph 108", "text": ": 법인의 경우 대표자 (인감)"}, {"block_index": 105, "section_index": 0, "paragraph_index": 108, "location": "section 1 · paragraph 109", "text": "주민 (법인) 등록 번호"}, {"block_index": 106, "section_index": 0, "paragraph_index": 109, "location": "section 1 · paragraph 110", "text": ":"}, {"block_index": 107, "section_index": 0, "paragraph_index": 110, "location": "section 1 · paragraph 111", "text": "사업장 전화번호"}, {"block_index": 108, "section_index": 0, "paragraph_index": 111, "location": "section 1 · paragraph 112", "text": ":"}, {"block_index": 109, "section_index": 0, "paragraph_index": 112, "location": "section 1 · paragraph 113", "text": "명지전문대학총장 귀하"}, {"block_index": 110, "section_index": 0, "paragraph_index": 113, "location": "section 1 · paragraph 114", "text": "비"}, {"block_index": 111, "section_index": 0, "paragraph_index": 114, "location": "section 1 · paragraph 115", "text": "고"}]