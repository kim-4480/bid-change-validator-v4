[{"block_index": 0, "section_index": 0, "paragraph_index": 0, "location": "section 1 · paragraph 1", "text": "공 사 설 명 서"}, {"block_index": 1, "section_index": 0, "paragraph_index": 1, "location": "section 1 · paragraph 2", "text": "1. 공 사 명: 2026년 이수고가 보수공사"}, {"block_index": 2, "section_index": 0, "paragraph_index": 3, "location": "section 1 · paragraph 4", "text": "2. 위 치: 이수고가(서울특별시 동작구 동작동~서초구 반포동)"}, {"block_index": 3, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "3. 공사목적"}, {"block_index": 4, "section_index": 0, "paragraph_index": 6, "location": "section 1 · paragraph 7", "text": "이수고가 정밀안전진단용역 결과에서 도출된 손상(포장손상 및 균열 등)에 대해 신속한 보수·보강으로 내구성 증진 및 안전성을 확보하고, 교량의 수명을 연장시키고자 함"}, {"block_index": 5, "section_index": 0, "paragraph_index": 8, "location": "section 1 · paragraph 9", "text": "4. 공사개요"}, {"block_index": 6, "section_index": 0, "paragraph_index": 9, "location": "section 1 · paragraph 10", "text": "○ 공사내용 : 교면 포장 및 방수 34.5a, 상판보수 81.4㎡ 등"}, {"block_index": 7, "section_index": 0, "paragraph_index": 10, "location": "section 1 · paragraph 11", "text": "○ 총공사비 : 897,000천원(도급비 735,600천원, 관급비 120,000천원, 이전비 41,400천원)"}, {"block_index": 8, "section_index": 0, "paragraph_index": 12, "location": "section 1 · paragraph 13", "text": "5. 공사기간: 착공일로부터 180일(6개월)"}, {"block_index": 9, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "6. 하자담보책임기간: 준공검사일로부터 아래와 같음"}, {"block_index": 10, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "○『지방자치단체를 당사자로 하는 계약에 관한 법률』 시행령 제69조, 시행규칙 제68조에 의함"}, {"block_index": 11, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "7. 신기술 및 특허 관련"}, {"block_index": 12, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "○ 신기술 및 특허 관련 공종은 기술개발자 또는 기술협력업체의 사용료 등에 대하여 도급자 책임하에 해결하여야 한다."}, {"block_index": 13, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "8. 현장설명 및 설계도서 열람장소"}, {"block_index": 14, "section_index": 0, "paragraph_index": 21, "location": "section 1 · paragraph 22", "text": "○『지방자치단체를 당사자로 하는 계약에 관한 법률』 시행령 제15조 제3항에 따라 현장설명은 생략"}, {"block_index": 15, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "○ 설계도서 열람장소 : 서울특별시 교량안전과(02-2133-1974)"}, {"block_index": 16, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "9. 설계도서의 제출"}, {"block_index": 17, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "○ 시공자는 『시설물의 안전 및 유지관리에 관한 특별법』 제9조(설계도서등의 제출 등)규정에 따라 설계도서 등 관련 서류를 발주청 및 국토안전관리원에 제출하여야 한다."}, {"block_index": 18, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "10. 기타사항"}, {"block_index": 19, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "○ 국민건강보험료, 국민연금보험료, 산업안전보건비, 환경보전비, 퇴직공제부금비, 교통정리원 보험료 등은 준공 시 정산한다."}, {"block_index": 20, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "○ 건설사업관리용역(감독권한대행 등) 시행하고 있음."}]