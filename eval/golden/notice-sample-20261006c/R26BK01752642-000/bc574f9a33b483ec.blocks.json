[{"block_index": 0, "section_index": 0, "paragraph_index": 3, "location": "section 1 · paragraph 4", "text": "과 업 내 용 서"}, {"block_index": 1, "section_index": 0, "paragraph_index": 4, "location": "section 1 · paragraph 5", "text": "(과업명 : 분당, 고양 발전사 현대화사업 대응 및"}, {"block_index": 2, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "장기사용 설비의 최적 개체방안 도출 연구)"}, {"block_index": 3, "section_index": 0, "paragraph_index": 7, "location": "section 1 · paragraph 8", "text": "2026. 8"}, {"block_index": 4, "section_index": 0, "paragraph_index": 11, "location": "section 1 · paragraph 12", "text": "플랜트기술처"}, {"block_index": 5, "section_index": 0, "paragraph_index": 12, "location": "section 1 · paragraph 13", "text": "플랜트관리·QC부"}, {"block_index": 6, "section_index": 0, "paragraph_index": 13, "location": "section 1 · paragraph 14", "text": "1. 용 역 명"}, {"block_index": 7, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "□ 분당, 고양 발전사 현대화사업 대응 및 장기사용 설비의 최적 개체"}, {"block_index": 8, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "방안 도출 연구"}, {"block_index": 9, "section_index": 0, "paragraph_index": 16, "location": "section 1 · paragraph 17", "text": "2. 용역목적"}, {"block_index": 10, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "□ 발전사 현대화사업에 따른 한국지역난방공사 최적 설비 구성방안 및 노후설비의 최적 개체방안 도출"}, {"block_index": 11, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "3. 용역기간"}, {"block_index": 12, "section_index": 0, "paragraph_index": 19, "location": "section 1 · paragraph 20", "text": "□ 계약일로부터 7개월로 한다."}, {"block_index": 13, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "4. 연구 범위 및 내용"}, {"block_index": 14, "section_index": 0, "paragraph_index": 21, "location": "section 1 · paragraph 22", "text": "가. 배관, 축열조 등 주요설비 상태진단 및 수명평가"}, {"block_index": 15, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "□ (배관 상태진단) 분당/고양 열원 누수로 보수부위, 과거 진단 부위 상태진단"}, {"block_index": 16, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "ㅇ 대상 개소 : 분당 열원 10개소, 고양 열원 5개소(과거 보수 이력 및 누수"}, {"block_index": 17, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "발생 취약부)"}, {"block_index": 18, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "ㅇ 정밀 비파괴검사 및 위상배열 초음파 탐상(PAUT)을 통한 모재 및 용접부"}, {"block_index": 19, "section_index": 0, "paragraph_index": 26, "location": "section 1 · paragraph 27", "text": "건전성 상태 측정"}, {"block_index": 20, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "□ (예상 수명평가) 취약부위 선정 후 감육진행 현황 및 최소배관 두께 측정 등을 통하여 대상 설비별 특성을 감안한 예상 수명평가"}, {"block_index": 21, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "ㅇ 취약부위 선정 기준 수립 및 과거 진단결과와 비교하여 운전시간"}, {"block_index": 22, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "경과에 따른 배관 감육(Corrosion/Erosion) 진행 현황 산출"}, {"block_index": 23, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "※ 과거 진단결과와 비교 분석"}, {"block_index": 24, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "ㅇ 최소 허용 배관 두께 측정 데이터 및 대상 설비별 운전 특성을"}, {"block_index": 25, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "종합 반영한 잔여 예상 수명 평가"}, {"block_index": 26, "section_index": 0, "paragraph_index": 33, "location": "section 1 · paragraph 34", "text": "□ (핀홀 대책)용접 열영향부(HAZ) 핀홀(Pinhole)에 대한 조사 및 대책 수립"}, {"block_index": 27, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "ㅇ 용접 열영향부(Heat Affected Zone)의 미세조직 변화, 국부 부식"}, {"block_index": 28, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "원인 조사 및 발생 메커니즘 분석"}, {"block_index": 29, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": "ㅇ 핀홀 발생 시 대응방안 가이드 제시, 재발 방지를 위한 용접 절차"}, {"block_index": 30, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "시공 가이드 및 비파괴 검사 관리 기준 도출"}, {"block_index": 31, "section_index": 0, "paragraph_index": 38, "location": "section 1 · paragraph 39", "text": "□ (축열조 진단) 축열조 취약부위 선정 후 상태점검 및 진단"}, {"block_index": 32, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "ㅇ 축열조 하부 쉘 플레이트, 노즐 부위, 용접 이음매 등 구조적 취약"}, {"block_index": 33, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": "부위 선정 및 정밀 상태점검"}, {"block_index": 34, "section_index": 0, "paragraph_index": 41, "location": "section 1 · paragraph 42", "text": "※ 과거 진단결과와 비교 분석"}, {"block_index": 35, "section_index": 0, "paragraph_index": 42, "location": "section 1 · paragraph 43", "text": "ㅇ 운전 하중 및 외부 환경 변동에 따른 축열조 기기 건전성 평가"}, {"block_index": 36, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "및 보완 대책 수립"}, {"block_index": 37, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": "나. 발전사 현대화, 효율적 연계운전을 위한 최적 설비구성 방안 수립"}, {"block_index": 38, "section_index": 0, "paragraph_index": 45, "location": "section 1 · paragraph 46", "text": "□ (설계마진 검토) 분당/고양 현대화 이후 변경되는 열원 공급 조건(온도, 압력, 유량) 하에서 운전 실적을 반영한 기존 설비의 설계마진 검토"}, {"block_index": 39, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "ㅇ 현대화 프로젝트 완성 후 변동되는 연계 열원 공급 조건(온도, 압력,"}, {"block_index": 40, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": "유량 범위) 분석"}, {"block_index": 41, "section_index": 0, "paragraph_index": 48, "location": "section 1 · paragraph 49", "text": "ㅇ 실 운전 실적 데이터(Operational Data)를 반영하여 기존 배관, 펌프,"}, {"block_index": 42, "section_index": 0, "paragraph_index": 49, "location": "section 1 · paragraph 50", "text": "열교환기 등 주요 설비의 설계 마진 Re-check"}, {"block_index": 43, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "※ 현대화에 따른 설계자료는 발주자 제공"}, {"block_index": 44, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": "□ (수열설비·배관) 2블록 수열량 증가에 따른 수열 설비·배관 구성 방안"}, {"block_index": 45, "section_index": 0, "paragraph_index": 52, "location": "section 1 · paragraph 53", "text": "ㅇ 블록 대규모 수열량 증대에 대응하기 위한 수열 펌프, 차압조절"}, {"block_index": 46, "section_index": 0, "paragraph_index": 53, "location": "section 1 · paragraph 54", "text": "밸브 용량 및 배관 규격 재산정"}, {"block_index": 47, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": "ㅇ 지역난방 배관망의 유속, 압력손실 분석을 통한 최적 수열 배관망"}, {"block_index": 48, "section_index": 0, "paragraph_index": 55, "location": "section 1 · paragraph 56", "text": "및 바이패스(Bypass) 관로 구성안 도출"}, {"block_index": 49, "section_index": 0, "paragraph_index": 56, "location": "section 1 · paragraph 57", "text": "□ (최적 운전모드) 분당/고양 현대화에 따른 운전특성(GT대수 감소, 열생산량 증감 등) 변동을 고려한 최적 운전모드 및 운전방안 제시"}, {"block_index": 50, "section_index": 0, "paragraph_index": 57, "location": "section 1 · paragraph 58", "text": "ㅇ 가스터빈(GT) 운전 대수 감소, 열생산량 증감 등 현대화 운전 특성"}, {"block_index": 51, "section_index": 0, "paragraph_index": 58, "location": "section 1 · paragraph 59", "text": "변동 요소 모델링"}, {"block_index": 52, "section_index": 0, "paragraph_index": 59, "location": "section 1 · paragraph 60", "text": "ㅇ 계통 과도현상(Water Hammering, Pressure Surge) 방지 및 부하"}, {"block_index": 53, "section_index": 0, "paragraph_index": 60, "location": "section 1 · paragraph 61", "text": "변동 대응 최적 운전모드/절차 작성"}, {"block_index": 54, "section_index": 0, "paragraph_index": 61, "location": "section 1 · paragraph 62", "text": "□ (최적설비 구성) 효율적인 연계운전을 위한 분당/고양 지역난방"}, {"block_index": 55, "section_index": 0, "paragraph_index": 62, "location": "section 1 · paragraph 63", "text": "설비 최적설비 구성 및 설비개체 방안 수립"}, {"block_index": 56, "section_index": 0, "paragraph_index": 63, "location": "section 1 · paragraph 64", "text": "ㅇ 연계운전 시 에너지를 효율적으로 활용하고 열손실 및 펌핑 동력을"}, {"block_index": 57, "section_index": 0, "paragraph_index": 64, "location": "section 1 · paragraph 65", "text": "최소화하는 설비 재구성/개체안 수립"}, {"block_index": 58, "section_index": 0, "paragraph_index": 65, "location": "section 1 · paragraph 66", "text": "□ (경제성 반영) 주요설비 상태진단 및 수명평가 결과를 기반으로 설비별 개체/활용 방안 도출 및 경제성 검토를 반영한 최적 방안 제시"}, {"block_index": 59, "section_index": 0, "paragraph_index": 66, "location": "section 1 · paragraph 67", "text": "ㅇ 시나리오 도출 : [1안] 전면 개체, [2안] 성능 보강 및 수명연장,"}, {"block_index": 60, "section_index": 0, "paragraph_index": 67, "location": "section 1 · paragraph 68", "text": "[3안] 지속 활용"}, {"block_index": 61, "section_index": 0, "paragraph_index": 68, "location": "section 1 · paragraph 69", "text": "ㅇ LCC(생애주기비용) 및 B/C 분석을 거쳐 기술적·경제적으로 가장"}, {"block_index": 62, "section_index": 0, "paragraph_index": 69, "location": "section 1 · paragraph 70", "text": "우수한 최적 개체/활용안 확정"}, {"block_index": 63, "section_index": 0, "paragraph_index": 70, "location": "section 1 · paragraph 71", "text": "다. 설비개체·유지보수 로드맵 수립"}, {"block_index": 64, "section_index": 0, "paragraph_index": 71, "location": "section 1 · paragraph 72", "text": "□ (단계별 로드맵) 최적 시나리오 단계별 설비개체 또는 유지보수 로드맵 수립"}, {"block_index": 65, "section_index": 0, "paragraph_index": 72, "location": "section 1 · paragraph 73", "text": "ㅇ 발전사 현대화공사 일정과 연계하여 설비별 교체·보강의 시급성"}, {"block_index": 66, "section_index": 0, "paragraph_index": 73, "location": "section 1 · paragraph 74", "text": "및 중요도 반영"}, {"block_index": 67, "section_index": 0, "paragraph_index": 74, "location": "section 1 · paragraph 75", "text": "ㅇ 설비별 쇠퇴도, 핀홀/감육 리스크, 운전 중요도를 통합 고려한"}, {"block_index": 68, "section_index": 0, "paragraph_index": 75, "location": "section 1 · paragraph 76", "text": "우선순위 Matrix 제시"}, {"block_index": 69, "section_index": 0, "paragraph_index": 76, "location": "section 1 · paragraph 77", "text": "□ (리스크분석, 적정 일정 수립) 분당/고양 현대화 일정을 고려한"}, {"block_index": 70, "section_index": 0, "paragraph_index": 77, "location": "section 1 · paragraph 78", "text": "안정적인 열공급을 위한 지역난방설비 적정 설비 개체 및 유지보수 일정 수립"}, {"block_index": 71, "section_index": 0, "paragraph_index": 78, "location": "section 1 · paragraph 79", "text": "ㅇ 발전사 현대화 공사 차단/정지 기간(Shutdown)과 동기화한 최적"}, {"block_index": 72, "section_index": 0, "paragraph_index": 79, "location": "section 1 · paragraph 80", "text": "개체 및 유지보수 일정 계획"}, {"block_index": 73, "section_index": 0, "paragraph_index": 80, "location": "section 1 · paragraph 81", "text": "ㅇ 설비 개체용 및 O/H(Overhaul) 작업용 차단 밸브 신설(안) 검토"}, {"block_index": 74, "section_index": 0, "paragraph_index": 81, "location": "section 1 · paragraph 82", "text": "ㅇ 기존 차단 밸브 철거/신설 계획 및 공사 기간 중 열공급 중단 최"}, {"block_index": 75, "section_index": 0, "paragraph_index": 82, "location": "section 1 · paragraph 83", "text": "소화를 위한 열공급 안정성 확보 대책 수립"}, {"block_index": 76, "section_index": 0, "paragraph_index": 83, "location": "section 1 · paragraph 84", "text": "ㅇ 수립된 최적방안을 현장에 적용시 리스크 분석"}, {"block_index": 77, "section_index": 0, "paragraph_index": 84, "location": "section 1 · paragraph 85", "text": "5. 연구용역 세부일정"}, {"block_index": 78, "section_index": 0, "paragraph_index": 86, "location": "section 1 · paragraph 87", "text": "세부내용"}, {"block_index": 79, "section_index": 0, "paragraph_index": 87, "location": "section 1 · paragraph 88", "text": "일정(개월)"}, {"block_index": 80, "section_index": 0, "paragraph_index": 88, "location": "section 1 · paragraph 89", "text": "1"}, {"block_index": 81, "section_index": 0, "paragraph_index": 89, "location": "section 1 · paragraph 90", "text": "2"}, {"block_index": 82, "section_index": 0, "paragraph_index": 90, "location": "section 1 · paragraph 91", "text": "3"}, {"block_index": 83, "section_index": 0, "paragraph_index": 91, "location": "section 1 · paragraph 92", "text": "4"}, {"block_index": 84, "section_index": 0, "paragraph_index": 92, "location": "section 1 · paragraph 93", "text": "5"}, {"block_index": 85, "section_index": 0, "paragraph_index": 93, "location": "section 1 · paragraph 94", "text": "6"}, {"block_index": 86, "section_index": 0, "paragraph_index": 94, "location": "section 1 · paragraph 95", "text": "7"}, {"block_index": 87, "section_index": 0, "paragraph_index": 95, "location": "section 1 · paragraph 96", "text": "가. 주요기기 상태 및 수명진단"}, {"block_index": 88, "section_index": 0, "paragraph_index": 96, "location": "section 1 · paragraph 97", "text": "나. 최적 설비구성 방안 수립"}, {"block_index": 89, "section_index": 0, "paragraph_index": 97, "location": "section 1 · paragraph 98", "text": "다. 설비개체·유지보수 로드맵 수립"}, {"block_index": 90, "section_index": 0, "paragraph_index": 98, "location": "section 1 · paragraph 99", "text": "6. 제출도서"}, {"block_index": 91, "section_index": 0, "paragraph_index": 100, "location": "section 1 · paragraph 101", "text": "구 분"}, {"block_index": 92, "section_index": 0, "paragraph_index": 101, "location": "section 1 · paragraph 102", "text": "제출형태"}, {"block_index": 93, "section_index": 0, "paragraph_index": 102, "location": "section 1 · paragraph 103", "text": "제출시기"}, {"block_index": 94, "section_index": 0, "paragraph_index": 103, "location": "section 1 · paragraph 104", "text": "착수계"}, {"block_index": 95, "section_index": 0, "paragraph_index": 104, "location": "section 1 · paragraph 105", "text": "(착수계에 포함되는 투입인력 정보는 법인 단위로 기재하되, 개별 연구자 성명은 계약상대자 내부 관리 사항으로 한다.)"}, {"block_index": 96, "section_index": 0, "paragraph_index": 105, "location": "section 1 · paragraph 106", "text": "파일"}, {"block_index": 97, "section_index": 0, "paragraph_index": 106, "location": "section 1 · paragraph 107", "text": "계약일로부터 7일이내"}, {"block_index": 98, "section_index": 0, "paragraph_index": 107, "location": "section 1 · paragraph 108", "text": "최종보고서"}, {"block_index": 99, "section_index": 0, "paragraph_index": 108, "location": "section 1 · paragraph 109", "text": "파일"}, {"block_index": 100, "section_index": 0, "paragraph_index": 109, "location": "section 1 · paragraph 110", "text": "완료 후 1개월 이내"}, {"block_index": 101, "section_index": 0, "paragraph_index": 110, "location": "section 1 · paragraph 111", "text": "※ 제출일은 발주자와 협의하여 조정 가능"}]