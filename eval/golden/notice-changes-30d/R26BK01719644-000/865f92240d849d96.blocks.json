[{"block_index": 0, "section_index": 0, "paragraph_index": 2, "location": "section 1 · paragraph 3", "text": "방폐물검사건물 건설기자재"}, {"block_index": 1, "section_index": 0, "paragraph_index": 3, "location": "section 1 · paragraph 4", "text": "구매 입찰설명서"}, {"block_index": 2, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "품 명: 공기조화기 및 공기정화기(M255)"}, {"block_index": 3, "section_index": 0, "paragraph_index": 7, "location": "section 1 · paragraph 8", "text": "차 례"}, {"block_index": 4, "section_index": 0, "paragraph_index": 9, "location": "section 1 · paragraph 10", "text": "제Ⅰ편"}, {"block_index": 5, "section_index": 0, "paragraph_index": 10, "location": "section 1 · paragraph 11", "text": "입찰유의서"}, {"block_index": 6, "section_index": 0, "paragraph_index": 11, "location": "section 1 · paragraph 12", "text": "제Ⅱ편"}, {"block_index": 7, "section_index": 0, "paragraph_index": 12, "location": "section 1 · paragraph 13", "text": "계약조건"}, {"block_index": 8, "section_index": 0, "paragraph_index": 13, "location": "section 1 · paragraph 14", "text": "제Ⅲ편"}, {"block_index": 9, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "입찰서 양식(물품 및 가격명세)"}, {"block_index": 10, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "제Ⅳ편"}, {"block_index": 11, "section_index": 0, "paragraph_index": 16, "location": "section 1 · paragraph 17", "text": "기술규격서"}, {"block_index": 12, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "Ⅰ. 입 찰 유 의 서"}, {"block_index": 13, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "차 례"}, {"block_index": 14, "section_index": 0, "paragraph_index": 21, "location": "section 1 · paragraph 22", "text": "제1장"}, {"block_index": 15, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "일반유의사항"}, {"block_index": 16, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "1.1"}, {"block_index": 17, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "일반사항"}, {"block_index": 18, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "1.2"}, {"block_index": 19, "section_index": 0, "paragraph_index": 26, "location": "section 1 · paragraph 27", "text": "입찰절차"}, {"block_index": 20, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "1.3"}, {"block_index": 21, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "입찰서 작성"}, {"block_index": 22, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "1.4"}, {"block_index": 23, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "일찰서 평가 및 계약체결"}, {"block_index": 24, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "제2장"}, {"block_index": 25, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "특별유의사항"}, {"block_index": 26, "section_index": 0, "paragraph_index": 33, "location": "section 1 · paragraph 34", "text": "2.1"}, {"block_index": 27, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "구매개요"}, {"block_index": 28, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "2.2"}, {"block_index": 29, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": "구매범위"}, {"block_index": 30, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "2.3"}, {"block_index": 31, "section_index": 0, "paragraph_index": 38, "location": "section 1 · paragraph 39", "text": "납품일정"}, {"block_index": 32, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "2.4"}, {"block_index": 33, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": "입찰마감일시"}, {"block_index": 34, "section_index": 0, "paragraph_index": 41, "location": "section 1 · paragraph 42", "text": "2.5"}, {"block_index": 35, "section_index": 0, "paragraph_index": 42, "location": "section 1 · paragraph 43", "text": "입찰형태"}, {"block_index": 36, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "2.6"}, {"block_index": 37, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": "입찰참가자격"}, {"block_index": 38, "section_index": 0, "paragraph_index": 45, "location": "section 1 · paragraph 46", "text": "2.7"}, {"block_index": 39, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "계약전 통지"}, {"block_index": 40, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": "2.8"}, {"block_index": 41, "section_index": 0, "paragraph_index": 48, "location": "section 1 · paragraph 49", "text": "입찰가격 작성기준"}, {"block_index": 42, "section_index": 0, "paragraph_index": 49, "location": "section 1 · paragraph 50", "text": "2.9"}, {"block_index": 43, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "입찰서 평가 절차 및 기준"}, {"block_index": 44, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": "붙 임"}, {"block_index": 45, "section_index": 0, "paragraph_index": 52, "location": "section 1 · paragraph 53", "text": "A 입찰보증금 지급각서"}, {"block_index": 46, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": "B 청렴계약 및 공정거래 이행각서"}, {"block_index": 47, "section_index": 0, "paragraph_index": 55, "location": "section 1 · paragraph 56", "text": "C 윤리실천 특별약관"}, {"block_index": 48, "section_index": 1, "paragraph_index": 0, "location": "section 2 · paragraph 1", "text": "제1장 일반유의사항"}, {"block_index": 49, "section_index": 1, "paragraph_index": 1, "location": "section 2 · paragraph 2", "text": "1.1 일반사항"}, {"block_index": 50, "section_index": 1, "paragraph_index": 2, "location": "section 2 · paragraph 3", "text": "1.1.1 목 적"}, {"block_index": 51, "section_index": 1, "paragraph_index": 3, "location": "section 2 · paragraph 4", "text": "대한민국 법률에 의해 설립되어 경북 경주시에 주소를 둔 한국원자력환경공단(이하 ‘공단’)은 중․저준위 방사성폐기물 방폐물검사건물 건설에 필요한 기기, 자재 및 용역을 구매하고자 하며, 이와 관련하여 입찰자에게 입찰절차 및 요건, 계약조건, 구매범위 및 납품일정, 기술규격 등 보다 상세한 입찰 관련 정보를 제공하기 위하여 이 입찰 설명서를 발급한다."}, {"block_index": 52, "section_index": 1, "paragraph_index": 4, "location": "section 2 · paragraph 5", "text": "1.1.2 입찰설명서의 준수"}, {"block_index": 53, "section_index": 1, "paragraph_index": 5, "location": "section 2 · paragraph 6", "text": "가. 입찰자는 ‘국가종합전자조달시스템(조달청의 나라장터)’ 전자입찰시스템을 이용하여 이 입찰에 참여하여야 하므로 ‘전자입찰유의서 및 이용약관’과 이 입찰 설명서를 숙지, 동의한 후 입찰설명서에 규정된 절차 및 요건을 엄격히 준수하여 입찰서를 작성, 제출하여야 한다. 이를 위반한 입찰서는 부적격 처리되거나 불리하게 처리될 수 있으며, 이는 입찰자의 책임이다."}, {"block_index": 54, "section_index": 1, "paragraph_index": 6, "location": "section 2 · paragraph 7", "text": "나. 입찰자는 ‘전자입찰유의서 및 이용약관’과 이 입찰설명서의 모든 내용을 충분히 숙지하고 수락한 것으로 간주된다."}, {"block_index": 55, "section_index": 1, "paragraph_index": 7, "location": "section 2 · paragraph 8", "text": "1.1.3 용어정의"}, {"block_index": 56, "section_index": 1, "paragraph_index": 8, "location": "section 2 · paragraph 9", "text": "제Ⅱ편 계약조건 제1장 일반조건 제2조에 규정된 용어의 의미는 문맥 상 다르게 해석되어지는 경우를 제외하고는 이 입찰설명서의 다른 편에 사용된 용어에도 적용된다."}, {"block_index": 57, "section_index": 1, "paragraph_index": 9, "location": "section 2 · paragraph 10", "text": "1.1.4 언어"}, {"block_index": 58, "section_index": 1, "paragraph_index": 10, "location": "section 2 · paragraph 11", "text": "입찰설명서는 한글 또는 영어로 작성, 제공된다. 입찰서는 한글, 영어 또는 양 언어로 작성되어야 하며, 그 이외의 언어로 작성된 입찰서는 접수하지 아니한다."}, {"block_index": 59, "section_index": 1, "paragraph_index": 11, "location": "section 2 · paragraph 12", "text": "1.1.5 입찰비용"}, {"block_index": 60, "section_index": 1, "paragraph_index": 12, "location": "section 2 · paragraph 13", "text": "입찰자는 입찰서의 작성 및 제출, 입찰참가자격 심사, 입찰평가 및 계약협상과 관련하여 자신에게 발생된 비용 및 경비를 부담하여야 한다. 어떠한 경우에도 공단은 동 비용 및 경비에 대하여 책임을 지지 아니한다."}, {"block_index": 61, "section_index": 1, "paragraph_index": 13, "location": "section 2 · paragraph 14", "text": "1.1.6 입찰의 비밀유지"}, {"block_index": 62, "section_index": 1, "paragraph_index": 14, "location": "section 2 · paragraph 15", "text": "입찰자는 입찰서 작성과 직접 관련이 없는 제3자에게 입찰설명서를 공개하여서는 아니 된다. 공단은 정부조달협정, 법령 또는 입찰설명서에 의하여 필요한 경우 이외에는 입찰서의 보안을 유지한다."}, {"block_index": 63, "section_index": 1, "paragraph_index": 15, "location": "section 2 · paragraph 16", "text": "1.1.7 입찰서의 소유권"}, {"block_index": 64, "section_index": 1, "paragraph_index": 16, "location": "section 2 · paragraph 17", "text": "공단에 제출된 입찰서 및 기타서류는 공단의 재산이 되며, 입찰서의 적격여부를 불문하고 입찰자에게 반환되지 아니한다."}, {"block_index": 65, "section_index": 1, "paragraph_index": 17, "location": "section 2 · paragraph 18", "text": "1.1.8 입찰설명서의 변경통지"}, {"block_index": 66, "section_index": 1, "paragraph_index": 18, "location": "section 2 · paragraph 19", "text": "공단은 입찰설명서의 내용 중 전자입찰의 취소 등 변경사항이 있으면 입찰자에게 통보를 하며, 변경사항은 입찰설명서의 내용에 포함된다."}, {"block_index": 67, "section_index": 1, "paragraph_index": 19, "location": "section 2 · paragraph 20", "text": "1.1.9 기간계산"}, {"block_index": 68, "section_index": 1, "paragraph_index": 20, "location": "section 2 · paragraph 21", "text": "입찰설명서에 상세히 다르게 규정되지 않는 한, 일수로 표시된 기간은 토요일, 공휴일을 포함하지 않으며 월수 또는 년수로 표시된 기간은 토요일, 공휴일을 포함한다. 이때 말일 또는 어느 특정일의 토요일, 공휴일과 겹치는 경우에는 최초 다음 영업일로 연기된다. 이 입찰설명서에 표시된 일시는 한국 표준시를 기준으로 한다."}, {"block_index": 69, "section_index": 1, "paragraph_index": 21, "location": "section 2 · paragraph 22", "text": "1.1.10 입찰철회 등"}, {"block_index": 70, "section_index": 1, "paragraph_index": 22, "location": "section 2 · paragraph 23", "text": "공단은 입찰자에 대한 책임 없이 사업변경, 가격초과, 협상결렬, 기타 다른 사유 등으로 언제든지 이 입찰을 철회 또는 연기하거나 재입찰 또는 재공고 입찰을 실시할 수 있으며, 구매범위, 납품일정, 입찰조건 등을 변경할 수 있다. 공단은 이러한 변경, 수정, 철회, 재입찰 또는 재공고 입찰과 관련하여 입찰자에게 어떠한 배상책임도 지지 아니한다."}, {"block_index": 71, "section_index": 1, "paragraph_index": 23, "location": "section 2 · paragraph 24", "text": "1.1.11 입찰의 무효"}, {"block_index": 72, "section_index": 1, "paragraph_index": 24, "location": "section 2 · paragraph 25", "text": "다음 각 호의 1에 해당하는 입찰은 무효로 한다."}, {"block_index": 73, "section_index": 1, "paragraph_index": 25, "location": "section 2 · paragraph 26", "text": "가. 입찰 참가 자격이 없는 자가 한 입찰"}, {"block_index": 74, "section_index": 1, "paragraph_index": 26, "location": "section 2 · paragraph 27", "text": "나. 입찰자(법인의 경우 대표자를 말한다. 이하 같다)가 직접 입찰을 하지 아니하고 대리인을 통하여 입찰할 경우 입찰개시 시각 전까지 위임장을 제출한 대리인이 아닌 자 또는 대리권이 없는 자가 한 입찰"}, {"block_index": 75, "section_index": 1, "paragraph_index": 27, "location": "section 2 · paragraph 28", "text": "다. 소정일시까지 소정의 입찰보증금을 납부하지 아니하고 한 입찰"}, {"block_index": 76, "section_index": 1, "paragraph_index": 28, "location": "section 2 · paragraph 29", "text": "라. 입찰서가 소정의 일시까지 도착하지 아니한 입찰"}, {"block_index": 77, "section_index": 1, "paragraph_index": 29, "location": "section 2 · paragraph 30", "text": "마. 동일사항에 대하여 동일인(1일이 수개의 법인의 대표자인 경우 해당 수개의 법인을 동일인으로 본다)이 2통 이상의 입찰서를 제출한 입찰.\n단, 대안입찰서는 예외."}, {"block_index": 78, "section_index": 1, "paragraph_index": 30, "location": "section 2 · paragraph 31", "text": "바. 동일사항에 대하여 타인의 대리를 겸하거나 2인 이상을 대리한 입찰"}, {"block_index": 79, "section_index": 1, "paragraph_index": 31, "location": "section 2 · paragraph 32", "text": "사. 입찰서의 입찰금액 등 중요한 부분이 불분명하거나, 정정한 후 날인을 누락한 경우"}, {"block_index": 80, "section_index": 1, "paragraph_index": 32, "location": "section 2 · paragraph 33", "text": "아. 담합하거나 타인의 경쟁참가를 방해 또는 공단 직원의 입찰업무 집행을 방해한 자의 입찰"}, {"block_index": 81, "section_index": 1, "paragraph_index": 33, "location": "section 2 · paragraph 34", "text": "자. 입찰자의 기명날인이 없는 입찰(입찰자의 성명을 기재하지 아니하고 대리인 성명 또는 회사명을 기재한 경우 및 입찰참가신청서 제출 시 신고한 인감과 다른 인감으로 날인된 경우도 포함된다)"}, {"block_index": 82, "section_index": 1, "paragraph_index": 34, "location": "section 2 · paragraph 35", "text": "차. 입찰설명서에서 요구하는 서류, 정보, 평가 자료를 제출하지 아니한 입찰"}, {"block_index": 83, "section_index": 1, "paragraph_index": 35, "location": "section 2 · paragraph 36", "text": "카. 기타 공단이 판단하는 입찰 설명서의 주요 요건을 위배한 입찰"}, {"block_index": 84, "section_index": 1, "paragraph_index": 36, "location": "section 2 · paragraph 37", "text": "1.1.12 부정당업자의 입찰참가자격 제한"}, {"block_index": 85, "section_index": 1, "paragraph_index": 37, "location": "section 2 · paragraph 38", "text": "국가를 당사자로 하는 계약에 관한 법률 시행령 76조에 의거 경쟁의 공정한 집행 또는 계약의 적정한 이행을 해할 우려가 있거나 기타 입찰에 참가시키는 것이 부적합하다고 인정되는 자에 대하여는 1개월 이상 2년 이하의 기간을 정하여 입찰참가자격을 제한한다."}, {"block_index": 86, "section_index": 1, "paragraph_index": 38, "location": "section 2 · paragraph 39", "text": "1.1.13 기타사항"}, {"block_index": 87, "section_index": 1, "paragraph_index": 39, "location": "section 2 · paragraph 40", "text": "입찰공고 또는 이 입찰유의서에 명시되지 아니한 기타의 사항에 대하여는 공단이 정하는 바에 따른다."}, {"block_index": 88, "section_index": 1, "paragraph_index": 40, "location": "section 2 · paragraph 41", "text": "1.2 입찰절차"}, {"block_index": 89, "section_index": 1, "paragraph_index": 41, "location": "section 2 · paragraph 42", "text": "1.2.1 입찰참가 신청"}, {"block_index": 90, "section_index": 1, "paragraph_index": 42, "location": "section 2 · paragraph 43", "text": "입찰공고 또는 따로 정하는 경우를 제외하고는 이 입찰에 대한 입찰참가신청은 아래 1.2.2조에 규정된 입찰보증금 제출로 갈음한다."}, {"block_index": 91, "section_index": 1, "paragraph_index": 43, "location": "section 2 · paragraph 44", "text": "1.2.2 입찰보증금"}, {"block_index": 92, "section_index": 1, "paragraph_index": 44, "location": "section 2 · paragraph 45", "text": "가. 입찰보증금의 납부는 면제하되 입찰보증금 지급각서를 제출하여야 한다. 신용정보관리규약에 의한 채무불이행 또는 금융질서 문란자인 경우 부가가치세를 포함한 총 입찰금액의 5% 이상의 금액을 공단에 납부하여야 한다. 입찰보증금 지급각서(붙임 A의 양식)를 제 2장 특별유의사항 제2.4조에 규정된 입찰마감일시까지 제2장 특별유의사항 2.7.1조의 주소지로 제출하여야 한다."}, {"block_index": 93, "section_index": 1, "paragraph_index": 45, "location": "section 2 · paragraph 46", "text": "나. 입찰보증금 지급각서 제출방법은 전자입찰 시 정해진 서식에 따라 송신한 입찰서로 대체한다."}, {"block_index": 94, "section_index": 1, "paragraph_index": 46, "location": "section 2 · paragraph 47", "text": "다. 입찰보증금은 (1) 입찰자가 입찰서의 유효기간 만료일 이전에 입찰서를 철회한 경우, 또는 (2) 낙찰자가 정당한 이유 없이 계약체결을 거부하거나 약정된 기간 내에 계약이행보증금을 납부하지 않는 경우에 공단에 귀속하며, 입찰자는 귀속사유 발생 시 공단의 요청에 따라 입찰보증금 해당금액을 현금으로 즉시 납부하여야 한다."}, {"block_index": 95, "section_index": 1, "paragraph_index": 47, "location": "section 2 · paragraph 48", "text": "1.2.3 입찰서 제출"}, {"block_index": 96, "section_index": 1, "paragraph_index": 48, "location": "section 2 · paragraph 49", "text": "가. 가격입찰서 및 입찰보증금 지급각서"}, {"block_index": 97, "section_index": 1, "paragraph_index": 49, "location": "section 2 · paragraph 50", "text": "공단으로부터 기술평가 적격업체로 통보받은 입찰자는 ‘국가종합전자조달시스템(조달청의 나라장터)’ 전자상거래 홈페이지에 온라인으로 제출하여야 한다. (가격입찰서 제출일은 추후통보)"}, {"block_index": 98, "section_index": 1, "paragraph_index": 50, "location": "section 2 · paragraph 51", "text": "나. 기술사항 입찰서"}, {"block_index": 99, "section_index": 1, "paragraph_index": 51, "location": "section 2 · paragraph 52", "text": "기술제안서는 제출 안내공고문에 안내된 장소 및 제출방법을 준수하여 제출기한 내에 제출하여야 한다. 입찰서가 공단에 접수되었는지 확인 할 책임은 입찰자에게 있다."}, {"block_index": 100, "section_index": 1, "paragraph_index": 52, "location": "section 2 · paragraph 53", "text": "1.2.4 입찰서 개봉"}, {"block_index": 101, "section_index": 1, "paragraph_index": 53, "location": "section 2 · paragraph 54", "text": "가격입찰서를 제외한 입찰서는 기재사항 확인 및 입찰평가를 위해 입찰마감 후에 즉시 개봉된다. 가격입찰서는 기술성 평가가 완료된 후 ‘국가종합전자조달시스템(조달청의 나라장터)’ 전자상거래 시스템을 이용하여 개찰되며 공단은 입찰자의 입회를 위해 가격입찰서의 개찰일시와 장소를 입찰자에게 통보한다."}, {"block_index": 102, "section_index": 1, "paragraph_index": 54, "location": "section 2 · paragraph 55", "text": "1,3 입찰서 작성"}, {"block_index": 103, "section_index": 1, "paragraph_index": 55, "location": "section 2 · paragraph 56", "text": "1.3.1 일반사항"}, {"block_index": 104, "section_index": 1, "paragraph_index": 56, "location": "section 2 · paragraph 57", "text": "입찰품목은 사용되지 않은 신품이고 구매의도에 적합하여야 하며, 제Ⅲ편 물품 및 가격명세 또는 제Ⅳ편 기술규격서에 규정된 바에 따라 엄격하게 설계, 제작, 조립, 시험, 공급 또는 설치되어야 하며, 규정된 기술규격이 없는 경우에는 가장 최신의 설계에 의한 제품이고, 제작자의 통상적인 생산물품과 동일하거나 보다 우수한 제품이어야 한다."}, {"block_index": 105, "section_index": 1, "paragraph_index": 57, "location": "section 2 · paragraph 58", "text": "1.3.2 입찰서 구성 및 내용"}, {"block_index": 106, "section_index": 1, "paragraph_index": 58, "location": "section 2 · paragraph 59", "text": "입찰서는 제Ⅲ편 입찰서 양식(물품 및 가격명세)에 따라 작성되어야 하며, 입찰설명서에서 요구하거나 충분한 입찰평가를 위하여 필요하다고 생각되는 추가 관련 자료가 첨부되어야 한다. 입찰서 양식은 모든 항목이 기재되어야 하며, 필요한 경우 입찰자는 충분한 설명과 함께 양식의 내용을 수정할 수 있다. 입찰서는 아래와 같이 구성되어야 한다."}, {"block_index": 107, "section_index": 1, "paragraph_index": 59, "location": "section 2 · paragraph 60", "text": "가. 기술 및 상업사항 입찰서"}, {"block_index": 108, "section_index": 1, "paragraph_index": 60, "location": "section 2 · paragraph 61", "text": "(1) 입찰서 제출 공문"}, {"block_index": 109, "section_index": 1, "paragraph_index": 61, "location": "section 2 · paragraph 62", "text": "(2) PART A 기술사항"}, {"block_index": 110, "section_index": 1, "paragraph_index": 62, "location": "section 2 · paragraph 63", "text": "(3) PART B 상업사항"}, {"block_index": 111, "section_index": 1, "paragraph_index": 63, "location": "section 2 · paragraph 64", "text": "(4) 가격명세(가격불표시분) 및 납품일정"}, {"block_index": 112, "section_index": 1, "paragraph_index": 64, "location": "section 2 · paragraph 65", "text": "(5) 예외사항"}, {"block_index": 113, "section_index": 1, "paragraph_index": 65, "location": "section 2 · paragraph 66", "text": "(6) 입찰설명서에서 요구되는 기타 도면, 기술, 일반자료 및 정보"}, {"block_index": 114, "section_index": 1, "paragraph_index": 66, "location": "section 2 · paragraph 67", "text": "(7) (2)～(6)의 내용을 담은 원본(전자파일 온라인), 사본(오프라인)"}, {"block_index": 115, "section_index": 1, "paragraph_index": 67, "location": "section 2 · paragraph 68", "text": "나. 가격입찰서"}, {"block_index": 116, "section_index": 1, "paragraph_index": 68, "location": "section 2 · paragraph 69", "text": "(1) 총액가격은 온라인 제출"}, {"block_index": 117, "section_index": 1, "paragraph_index": 69, "location": "section 2 · paragraph 70", "text": "(2) 가격명세(가격표시분) 및 납품일정은 계약체결 시 제출"}, {"block_index": 118, "section_index": 1, "paragraph_index": 70, "location": "section 2 · paragraph 71", "text": "1.3.3 입찰서 포장 및 표시"}, {"block_index": 119, "section_index": 1, "paragraph_index": 71, "location": "section 2 · paragraph 72", "text": "오프라인으로 제출하는 기술 및 상업사항 입찰서는 겉면에 입찰번호, 물품명, 입찰자명, 입찰서번호(입찰자 부여 시)등을 명시하여야 한다."}, {"block_index": 120, "section_index": 1, "paragraph_index": 72, "location": "section 2 · paragraph 73", "text": "1.3.4 입찰서 수량"}, {"block_index": 121, "section_index": 1, "paragraph_index": 73, "location": "section 2 · paragraph 74", "text": "기술 및 상업사항 입찰서는 원본 1부(전자파일 온라인), 사본 5부(오프라인) 총 6부를 제출한다."}, {"block_index": 122, "section_index": 1, "paragraph_index": 74, "location": "section 2 · paragraph 75", "text": "1.3.5 입찰서 수정"}, {"block_index": 123, "section_index": 1, "paragraph_index": 75, "location": "section 2 · paragraph 76", "text": "기술 및 상업사항 입찰서는 첨자, 변경 또는 삭제 없이 작성되어야 한다. 수정이 필요한 경우에는 수정부분에 법인 또는 사용인감으로 날인하여야 한다."}, {"block_index": 124, "section_index": 1, "paragraph_index": 76, "location": "section 2 · paragraph 77", "text": "1.3.6 추가서류"}, {"block_index": 125, "section_index": 1, "paragraph_index": 77, "location": "section 2 · paragraph 78", "text": "아래 서류를 제외하고, 공단은 입찰평가기간 중에는 어떠한 입찰서의 변경사항 또는 추가서류를 접수하지 아니한다."}, {"block_index": 126, "section_index": 1, "paragraph_index": 78, "location": "section 2 · paragraph 79", "text": "가. 제출된 입찰서의 주요내용을 변경시키지 않는 입찰자의 확인사항에 관한 서류"}, {"block_index": 127, "section_index": 1, "paragraph_index": 79, "location": "section 2 · paragraph 80", "text": "나. 입찰서 또는 입찰보증금의 유효기간 연장에 관한 서류"}, {"block_index": 128, "section_index": 1, "paragraph_index": 80, "location": "section 2 · paragraph 81", "text": "다. 입찰평가를 위해 공단이 서면으로 요청한 서류"}, {"block_index": 129, "section_index": 1, "paragraph_index": 81, "location": "section 2 · paragraph 82", "text": "1.3.7 입찰설명서에 대한 예외사항"}, {"block_index": 130, "section_index": 1, "paragraph_index": 82, "location": "section 2 · paragraph 83", "text": "가. 입찰자는 제Ⅰ편 입찰유의서 및 제Ⅱ편 계약조건을 수락하여야 하며, 이에 대한 예외사항은 원칙적으로 인정하지 아니한다."}, {"block_index": 131, "section_index": 1, "paragraph_index": 83, "location": "section 2 · paragraph 84", "text": "나. 입찰설명서 제Ⅳ편 기술규격서에 대한 예외사항을 제시할 때에는 입찰자는 공단이 그 타당성을 평가할 수 있도록 충분한 설명과 함께 그 차이점을 상세히 기술하여야 한다."}, {"block_index": 132, "section_index": 1, "paragraph_index": 84, "location": "section 2 · paragraph 85", "text": "1.3.8 대안입찰서"}, {"block_index": 133, "section_index": 1, "paragraph_index": 85, "location": "section 2 · paragraph 86", "text": "입찰자는 개선사항이 있거나 보다 경제적이라고 판단되는 경우 대안입찰서를 제출할 수 있다. 대안입찰서는 원입찰서와 쉽게 구별될 수 있도록 작성되어야 하며, 가격을 포함한 모든 대안사항이 그 이점 등에 대한 충분한 설명과 함께 기술되어야 한다. 대안입찰서는 원입찰서와 동일한 절차 및 요건에 따라 제출되고 취급되어야 한다."}, {"block_index": 134, "section_index": 1, "paragraph_index": 86, "location": "section 2 · paragraph 87", "text": "1.3.9 입찰서 유효기간"}, {"block_index": 135, "section_index": 1, "paragraph_index": 87, "location": "section 2 · paragraph 88", "text": "입찰가격을 포함한 입찰서는 확정청약으로서 구속력이 있으며 가격입찰마감일 이후 최소 8개월까지 조건 없이 유효하여야 한다. 공단은 필요한 경우 입찰자에게 입찰서 유효기간의 연장을 요청할 수 있다."}, {"block_index": 136, "section_index": 1, "paragraph_index": 88, "location": "section 2 · paragraph 89", "text": "1.3.10 입찰설명서 또는 입찰서 내용의 상치"}, {"block_index": 137, "section_index": 1, "paragraph_index": 89, "location": "section 2 · paragraph 90", "text": "입찰설명서 또는 입찰서의 내용이나 수치가 모순되거나 상충될 경우, 공단 또는 입찰자가 달리 확인하지 않는 한, 해당 사항을 보다 구체적으로 상세히 취급한 내용이 우선한다. 입찰자가 입찰설명서의 정확한 의미 또는 해석에 의문이 있는 경우, 서면으로 공단에 확인을 요청할 수 있다. 공단은 구두로 확인한 사항에 대하여 책임을 지지 아니한다."}, {"block_index": 138, "section_index": 1, "paragraph_index": 90, "location": "section 2 · paragraph 91", "text": "1.3.11 참고자료"}, {"block_index": 139, "section_index": 1, "paragraph_index": 91, "location": "section 2 · paragraph 92", "text": "입찰자가 달리 언급하지 않는 한, 입찰서에 참고용으로 포함된 입찰자의 홍보물, 자료 또는 정보는 공식 입찰내용으로 간주되지 아니한다."}, {"block_index": 140, "section_index": 1, "paragraph_index": 92, "location": "section 2 · paragraph 93", "text": "1.3.12 도면확인"}, {"block_index": 141, "section_index": 1, "paragraph_index": 93, "location": "section 2 · paragraph 94", "text": "입찰설명서에 포함된 도면은 하자 또는 불일치가 있을 수 있다. 입찰자는 입찰설명서의 도면과 기술된 규격서를 대조하여야 하며, 규격서와의 일치를 위한 도면의 수정사항을 입찰서에 명시하여야 한다."}, {"block_index": 142, "section_index": 1, "paragraph_index": 94, "location": "section 2 · paragraph 95", "text": "1.3.13 입찰서 기명날인 또는 서명"}, {"block_index": 143, "section_index": 1, "paragraph_index": 95, "location": "section 2 · paragraph 96", "text": "가. 기술 및 상업사항 입찰서에는 반드시 입찰자 성명(법인의 경우 법인명과 대표자의 성명을 같이 기재하여야 함)을 기재하고 법인인감(신고된 사용인감을 포함함)을 날인하여야 한다. 입찰서에는 인감증명서(필요시 사용인감계 포함)가 첨부되어야 한다."}, {"block_index": 144, "section_index": 1, "paragraph_index": 96, "location": "section 2 · paragraph 97", "text": "나. 가격입찰서의 경우에는 입찰유의서에 따라 ‘국가종합전자조달시스템(조달청의 나라장터)’ 전자입찰시스템을 이용한다."}, {"block_index": 145, "section_index": 1, "paragraph_index": 97, "location": "section 2 · paragraph 98", "text": "1.4 입찰서 평가 및 계약체결"}, {"block_index": 146, "section_index": 1, "paragraph_index": 98, "location": "section 2 · paragraph 99", "text": "1.4.1 입찰서 평가 기준 및 절차"}, {"block_index": 147, "section_index": 1, "paragraph_index": 99, "location": "section 2 · paragraph 100", "text": "공단은 제2장 특별유의사항에 명시된 입찰서 평가 기준, 절차 및 필요시 공단의 표준사업관리절차서에 따라 공정하게 평가를 실시한다."}, {"block_index": 148, "section_index": 1, "paragraph_index": 100, "location": "section 2 · paragraph 101", "text": "1.4.2 입찰서 평가내용 비공개 원칙"}, {"block_index": 149, "section_index": 1, "paragraph_index": 101, "location": "section 2 · paragraph 102", "text": "입찰서 평가는 공단 또는 공단이 지정한 다른 기관에 의하여 수행된다. 공단이 결정한 입찰서 평가의 결과는 최종적이고 확정적이며, 정부조달협정에 의하지 아니하고는 공단은 입찰서 평가에 관한 내용을 공개할 의무가 없다."}, {"block_index": 150, "section_index": 1, "paragraph_index": 102, "location": "section 2 · paragraph 103", "text": "1.4.3 낙찰자 선정"}, {"block_index": 151, "section_index": 1, "paragraph_index": 103, "location": "section 2 · paragraph 104", "text": "공단은 2인 이상의 유효한 입찰에 의하여 경쟁입찰이 성립된 경우, 기술규격 등 입찰설명서의 주요 요건을 충족하고 예정가격 이하로 입찰한 자 중 최저가격 입찰자를 낙찰자로 선정한다."}, {"block_index": 152, "section_index": 1, "paragraph_index": 104, "location": "section 2 · paragraph 105", "text": "1.4.4 계약체결"}, {"block_index": 153, "section_index": 1, "paragraph_index": 105, "location": "section 2 · paragraph 106", "text": "가. 낙찰자는 공단으로부터 낙찰통지를 받은 후 7일 이내에 소정서식에 의한 구비서류(붙임 B,C,D의 양식) 및 낙찰금액의 산출내역서를 공단에 제출하고, 10일 이내에 계약을 체결한다. 단, 불가항력의 사유로 인하여 계약을 체결할 수 없는 경우에는 그 사유가 존속하는 기간은 이를 산입하지 아니한다."}, {"block_index": 154, "section_index": 1, "paragraph_index": 106, "location": "section 2 · paragraph 107", "text": "나. 계약상대자는 계약 체결 시 계약보증금과 관련규정에 의하여 필요한 서류를 공단에 제출하여야 한다."}, {"block_index": 155, "section_index": 1, "paragraph_index": 107, "location": "section 2 · paragraph 108", "text": "(붙임 B 청렴계약 및 공정거래 이행각서, 붙임 C 공정계약 서약서,\n붙임 D 협력회사 인권경영 이행 서약서)"}, {"block_index": 156, "section_index": 1, "paragraph_index": 108, "location": "section 2 · paragraph 109", "text": "1.4.5 재입찰 및 재공고 입찰"}, {"block_index": 157, "section_index": 1, "paragraph_index": 109, "location": "section 2 · paragraph 110", "text": "가. 공단은 가격입찰서를 개찰한 결과 낙찰자를 결정할 수 없는 경우로서 기술규격 적격자가 2인 이상인 때에는 그 기술규격 적격자에 한하여 다시 가격입찰서를 제출하게 할 수 있다."}, {"block_index": 158, "section_index": 1, "paragraph_index": 110, "location": "section 2 · paragraph 111", "text": "나. 그 외 재입찰 및 재공고입찰에 대한 사항은 계약예규 ‘물품 구매 입찰유의서’ 및 국가계약법에 따라 시행한다."}, {"block_index": 159, "section_index": 1, "paragraph_index": 111, "location": "section 2 · paragraph 112", "text": "붙임 A"}, {"block_index": 160, "section_index": 1, "paragraph_index": 113, "location": "section 2 · paragraph 114", "text": "입찰보증금 지급각서"}, {"block_index": 161, "section_index": 1, "paragraph_index": 114, "location": "section 2 · paragraph 115", "text": "입찰번호 :"}, {"block_index": 162, "section_index": 1, "paragraph_index": 115, "location": "section 2 · paragraph 116", "text": "물 품 명 :"}, {"block_index": 163, "section_index": 1, "paragraph_index": 116, "location": "section 2 · paragraph 117", "text": "입찰일시 :"}, {"block_index": 164, "section_index": 1, "paragraph_index": 117, "location": "section 2 · paragraph 118", "text": "귀 공단에서 시행하는 위 구매입찰에서 본인이 입찰서 유효기간 만료일 이전에 입찰서를 철회하거나, 또는 본인이 낙찰자 또는 계약협상대상자로 선정된 후 정당한 이유 없이 계약을 체결하지 않거나 약정된 기일 내에 계약보증금을 납부하지 않아 입찰보증금의 귀 공단에 귀속사유가 발생할 경우에는 귀 공단의 요청에 따라 총 입찰금액의 100분의 5에 해당하는 금액을 귀 공단에 즉시 현금으로 납부하겠으며, 기타 입찰보증금의 귀 공단 귀속사유로 인한 어떠한 조치에 대하여도 귀 공단의 결정 또는 요구에 따를 것임을 확약합니다. 또한, 위 물품의 구매와 관련한 재공고 입찰에 본인이 참여할 경우에도 이 각서가 입찰보증금 지급각서로서 계속 유효함을 인정합니다."}, {"block_index": 165, "section_index": 1, "paragraph_index": 118, "location": "section 2 · paragraph 119", "text": "20 년 월 일"}, {"block_index": 166, "section_index": 1, "paragraph_index": 120, "location": "section 2 · paragraph 121", "text": "대표자 인"}, {"block_index": 167, "section_index": 1, "paragraph_index": 121, "location": "section 2 · paragraph 122", "text": "상 호"}, {"block_index": 168, "section_index": 1, "paragraph_index": 122, "location": "section 2 · paragraph 123", "text": "주 소"}, {"block_index": 169, "section_index": 1, "paragraph_index": 123, "location": "section 2 · paragraph 124", "text": "한국원자력환경공단 이사장 귀하"}, {"block_index": 170, "section_index": 1, "paragraph_index": 125, "location": "section 2 · paragraph 126", "text": "붙임 B"}, {"block_index": 171, "section_index": 1, "paragraph_index": 126, "location": "section 2 · paragraph 127", "text": "청렴계약 및 공정거래 이행각서"}, {"block_index": 172, "section_index": 1, "paragraph_index": 127, "location": "section 2 · paragraph 128", "text": "당사는 한국원자력환경공단 [이하 “공단”이라 한다]이 시행하는 입찰에 참가하거나 공단과의 거래를 함에 있어 청렴계약 및 공정거래 이행이 사회발전과 국가 경쟁력 제고에 중요한 관건이 됨을 깊이 인식하고 공단의 청렴계약 및 공정거래 실천의지에 적극 호응하여 공단에서 발주하는 공사ㆍ용역ㆍ물품 등의 입찰 및 계약과 관련하여 청렴계약 및 공정거래를 이행할 것을 다음과 같이 서약합니다."}, {"block_index": 173, "section_index": 1, "paragraph_index": 128, "location": "section 2 · paragraph 129", "text": "1. 어떠한 명분으로도 공단의 계약관련 업무수행자[계약부서, 수요부서 및 청구부서의 직원과 공단의 대리인 및 그 임직원을 포함한다]에게 직접 또는 간접적으로 금품ㆍ향응 등(친인척 등에 대한 부정한 취업 제공 포함) 부당한 이익을 제공하지 않겠습니다."}, {"block_index": 174, "section_index": 1, "paragraph_index": 129, "location": "section 2 · paragraph 130", "text": "2. 공단의 임직원 또는 업무종사자(친인척 포함)로서 거래를 하지 않겠습니다."}, {"block_index": 175, "section_index": 1, "paragraph_index": 130, "location": "section 2 · paragraph 131", "text": "3. 계약을 이행함에 있어 부실 또는 부당하게 하지 않겠습니다."}, {"block_index": 176, "section_index": 1, "paragraph_index": 131, "location": "section 2 · paragraph 132", "text": "4. 독점규제 및 공정거래에 관한 법률 또는 하도급거래 공정화에 관한 법률에 위반되는 어떠한 행위도 하지 않겠습니다."}, {"block_index": 177, "section_index": 1, "paragraph_index": 132, "location": "section 2 · paragraph 133", "text": "5. 산업안전보건법에 의한 안전조치 또는 보건조치를 소홀하게 하여 근로자 및 공중에게 위해가 가도록 하지 않겠습니다."}, {"block_index": 178, "section_index": 1, "paragraph_index": 133, "location": "section 2 · paragraph 134", "text": "6. 이번 입찰과 관련하여 입찰가격 또는 특정인의 낙찰을 위한 담합 등 어떠한 사항에 대하여도 경쟁자들과 사전에 협의, 연락, 합의, 조정 등을 한 사실이 없음을 서약함과 동시에, 이 후에도 자유경쟁을 부당하게 저해하는 일체의 불공정한 행위를 않겠습니다."}, {"block_index": 179, "section_index": 1, "paragraph_index": 134, "location": "section 2 · paragraph 135", "text": "가. 이를 위반하여 입찰집행 중 또는 입찰집행 후에 공정거래위원회의 결정 또는 법원의 판결에 따라 담합사실이 인정되는 경우에는 입찰중지, 입찰무효, 계약해제ㆍ해지, 공사 중지, 손해배상 청구, 공정거래위원회의 통지, 검찰고발 등 일체의 조치를 취하여도 민ㆍ형사상 이의를 제기하지 않겠습니다."}, {"block_index": 180, "section_index": 1, "paragraph_index": 135, "location": "section 2 · paragraph 136", "text": "나. 또한 경쟁입찰과 관련한 담합으로 공단에게 손해를 입혔을 경우에는 다음 각 호의 금액을 배상하도록 하겠습니다."}, {"block_index": 181, "section_index": 1, "paragraph_index": 138, "location": "section 2 · paragraph 139", "text": "① 담합에 따라 결정된 낙찰가격과 담합이 없었을 경우 형성되었으리라고 인정되는 가격의 차액"}, {"block_index": 182, "section_index": 1, "paragraph_index": 139, "location": "section 2 · paragraph 140", "text": "② 담합으로 인하여 입찰이 유찰된 경우 입찰공고 및 현장설명회 개최 등 재입찰절차에 따라 소요되는 각종 행정비용"}, {"block_index": 183, "section_index": 1, "paragraph_index": 140, "location": "section 2 · paragraph 141", "text": "③ 기타 공단이 입증하는 담합으로 인한 유․무형의 손해"}, {"block_index": 184, "section_index": 1, "paragraph_index": 141, "location": "section 2 · paragraph 142", "text": "다. ‘나’호에도 불구하고 구체적인 손해액을 산정하기가 곤란하거나 불가능할 경우에는 계약금액의 10%를 배상하도록 하겠습니다."}, {"block_index": 185, "section_index": 1, "paragraph_index": 142, "location": "section 2 · paragraph 143", "text": "라. ‘나’, ‘다’호의 배상액은 공단이 청구한 날로부터 60일 이내에 납부하도록 하겠으며, 이 기간 내에 납부하지 못할 경우에는 공단이 당사에 지급할 타 대가에서 우선 공제하여도 민ㆍ형사상 이의를 제기하지 않겠습니다."}, {"block_index": 186, "section_index": 1, "paragraph_index": 143, "location": "section 2 · paragraph 144", "text": "7. 입찰 또는 계약에 관한 서류(전자서류 포함)를 위변조하거나 부정하게 행사하거나 기타 공정한 입찰 질서를 방해하는 어떠한 행위도 하지 않겠습니다."}, {"block_index": 187, "section_index": 1, "paragraph_index": 144, "location": "section 2 · paragraph 145", "text": "위 사항을 위반할 경우에는 공단의 입찰참가자격의 취소, 낙찰취소, 계약의 해제 또는 해지 및 입찰참가자격의 제한 등의 조치를 감수할 것이며, 공단의 조치와 관련하여 손해배상의 청구, 소송 등에 대해 어떠한 이의도 제기하지 않을 것을 확약합니다."}, {"block_index": 188, "section_index": 1, "paragraph_index": 146, "location": "section 2 · paragraph 147", "text": "20 . ."}, {"block_index": 189, "section_index": 1, "paragraph_index": 147, "location": "section 2 · paragraph 148", "text": "서 약 자"}, {"block_index": 190, "section_index": 1, "paragraph_index": 148, "location": "section 2 · paragraph 149", "text": "기 관 명 :"}, {"block_index": 191, "section_index": 1, "paragraph_index": 149, "location": "section 2 · paragraph 150", "text": "대 표 : 󰄫"}, {"block_index": 192, "section_index": 1, "paragraph_index": 150, "location": "section 2 · paragraph 151", "text": "한국원자력환경공단 이사장 귀하"}, {"block_index": 193, "section_index": 1, "paragraph_index": 151, "location": "section 2 · paragraph 152", "text": "붙임 C"}, {"block_index": 194, "section_index": 1, "paragraph_index": 152, "location": "section 2 · paragraph 153", "text": "공정계약 서약서"}, {"block_index": 195, "section_index": 1, "paragraph_index": 153, "location": "section 2 · paragraph 154", "text": "한국원자력환경공단[이하 “공단”이라 한다]은 공단에서 발주한 공사ㆍ용역ㆍ물품 등의 입찰 및 계약과 관련하여 낙찰된 계약상대자와 청렴계약 및 공정거래를 이행할 것을 다음과 같이 서약합니다."}, {"block_index": 196, "section_index": 1, "paragraph_index": 154, "location": "section 2 · paragraph 155", "text": "1. 어떠한 명분으로도 계약상대자에게 직접 또는 간접적으로 금품ㆍ향응 등(친인척 등에 대한 부정한 취업 제공 포함) 부당한 이익을 요구하지 않겠습니다."}, {"block_index": 197, "section_index": 1, "paragraph_index": 155, "location": "section 2 · paragraph 156", "text": "2. 계약상대자의 경영·인사관리 및 계약상대자가 제3자와 체결한 계약의 내용에 대해 개입하지 않겠습니다."}, {"block_index": 198, "section_index": 1, "paragraph_index": 156, "location": "section 2 · paragraph 157", "text": "3. 해당 계약과 직접적인 관련이 없는 의무를 계약상대자에게 부과하거나 공단이 부담하여야 하는 계약 내용을 계약상대자에게 전가하는 행위를 하지 않겠습니다."}, {"block_index": 199, "section_index": 1, "paragraph_index": 157, "location": "section 2 · paragraph 158", "text": "가. 신기술·특허공법 보유자 또는 물품공급·기술지원사와 발주 전에 기술사용(지원)협약 등을 체결하지 아니하고 낙찰자로 하여금 직접 신기술·특허 보유자 또는 물품공급·기술지원사와 체결한 사용협약서 또는 물품공급·기술지원협약서를 제출하게 하거나 이로 인해 낙찰자가 계약을 체결할 수 없는 경우에도 부정당업자로 입찰참가자격을 제한하고 입찰보증금을 귀속하지 않겠습니다."}, {"block_index": 200, "section_index": 1, "paragraph_index": 158, "location": "section 2 · paragraph 159", "text": "나. 신기술·특허공법 보유자 또는 물품공급·기술지원사와 공단이 사전에 체결한 기술사용(지원)협약 등과 다르게 부당한 요구를 하여 낙찰자와 신기술·특허 보유자 또는 물품공급·기술지원사가 간 협약이 체결되지 않도록 하는 행위를 방지하겠습니다."}, {"block_index": 201, "section_index": 1, "paragraph_index": 159, "location": "section 2 · paragraph 160", "text": "다. 신기술·특허공법이 사용되는 공사의 전부 또는 일부가 기술보유자의 기술력을 활용하지 아니하면 시공과 품질 확보가 불가능하거나, 기술보유자가 보유한 특수 장비 등을 직접 사용하지 아니하면 시공과 품질 확보가 불가능한 경우를 제외하고 계약상대자에게 신기술·특허공법 보유자와 하도급계약 등을 체결하도록 강요·유도하지 않겠습니다."}, {"block_index": 202, "section_index": 1, "paragraph_index": 160, "location": "section 2 · paragraph 161", "text": "라. 계약체결 부대비용 등 계약체결 및 이행 과정에서 발생하는 비용 중 공단이 부담할 부분을 계약상대자에게 전가하거나, 공사용지 확보, 사업관련 민원대응 등 공단의업무를 계약상대자에게 전가하는 행위를 하지 않겠습니다."}, {"block_index": 203, "section_index": 1, "paragraph_index": 161, "location": "section 2 · paragraph 162", "text": "4. 「공기업·준정부기관 계약사무규칙」, 「국가를 당사자로 하는 계약에 관한 법률(이하, “국가계약법”이라 한다)」, 국가계약법 시행령 및 시행규칙, 기획재정부 계약예규, 공단 계약규정에 규정된 사항을 위반하여 계약상대자의 계약상 이익을 부당하게 제한하거나 의무를 부과하는 특약 또는 조건을 요구하는 어떠한 행위를 하지 않겠습니다."}, {"block_index": 204, "section_index": 1, "paragraph_index": 162, "location": "section 2 · paragraph 163", "text": "가. 수의계약 시에도 규격서나 시방서 등에 명시한 수의계약 대상제품을 부득이하게 특별하여 필요한 경우를 제외하고 특정제품 규격이나 인증번호 등을 명시하여 수의계약 체결을 요구하지 않겠습니다."}, {"block_index": 205, "section_index": 1, "paragraph_index": 163, "location": "section 2 · paragraph 164", "text": "나. 계약체결 이후 과업을 변경 시 계약 목적달성을 위해 필요한 최소한의 과업만을 변경하지 않고 빈번하게 과업변경을 계약상대자에게 요구하거나 계약금액 감액 시 기준, 대상, 방식에 대한 협의 없이 자의적으로 계약상대자의 적정대가를 보장하지 않는 행위를 하지 않겠습니다."}, {"block_index": 206, "section_index": 1, "paragraph_index": 164, "location": "section 2 · paragraph 165", "text": "다. 국가계약법 제19조 등에 따른 계약 내용의 변경에 따른 계약금액 조정과 관련하여 계약금액의 조정 없이 추가 과업을 요구하거나 일방적으로 과업을 변경하며 정당한 이유 없이 계약금액 조정신청을 거부 또는 인정하는 행위를 하지 않겠습니다."}, {"block_index": 207, "section_index": 1, "paragraph_index": 165, "location": "section 2 · paragraph 166", "text": "라. 장기계속계약의 연차별 계약기간 중 계약예규 「공사계약일반조건」제25조제3항 제1호부터 제3호까지 및 제6호·제7호에 따른 사유가 발생한 이후, 해당 연차계약을 해지하고 잔여 공사부분을 차년도 연차계약으로 이월하는 행위를 하지 않겠습니다."}, {"block_index": 208, "section_index": 1, "paragraph_index": 166, "location": "section 2 · paragraph 167", "text": "5. 공단은 시장에서 거래되는 등 재산적 가치가 있는 기술지식 등을 계약상대자의 승인을 얻어 복사·이용 또는 공개하려는 경우에는 계약상대자와 협의하여 정당한 이용대가를 지급하겠습니다."}, {"block_index": 209, "section_index": 1, "paragraph_index": 167, "location": "section 2 · paragraph 168", "text": "위 사항을 위반할 경우에는 공단은 계약상대자에게 계약의 해제 또는 해지 및 입찰참가자격의 제한 등의 행위를 하지 않으며, 공정거래 이행 위반에 따른 손해배상을 청구, 소송 등에 의한 어떠한 이의를 제기하지 않을 것을 서약합니다."}, {"block_index": 210, "section_index": 1, "paragraph_index": 169, "location": "section 2 · paragraph 170", "text": "20 . . ."}, {"block_index": 211, "section_index": 1, "paragraph_index": 170, "location": "section 2 · paragraph 171", "text": "서 약 자 한국원자력환경공단 이사장 (인)"}, {"block_index": 212, "section_index": 1, "paragraph_index": 171, "location": "section 2 · paragraph 172", "text": "붙임 D"}, {"block_index": 213, "section_index": 1, "paragraph_index": 172, "location": "section 2 · paragraph 173", "text": "협력회사 인권경영 이행 서약서"}, {"block_index": 214, "section_index": 1, "paragraph_index": 173, "location": "section 2 · paragraph 174", "text": "당사는 한국원자력환경공단의 협력회사로서 근로자(하도급업체 포함)의 인권보호, 고용안정, 노동환경 등의 권리보호를 위해 다음 사항을 이행할 것을 서약합니다."}, {"block_index": 215, "section_index": 1, "paragraph_index": 174, "location": "section 2 · paragraph 175", "text": "1. 당사는 근로자가 인간으로서의 존엄과 가치 및 자유와 권리를 누릴 수 있도록 인권보호를 위한 경영정책을 확립하도록 노력하겠습니다."}, {"block_index": 216, "section_index": 1, "paragraph_index": 175, "location": "section 2 · paragraph 176", "text": "2. 근로자에 대하여 인종ㆍ종교ㆍ신체적 결함ㆍ성별ㆍ출생지ㆍ노동조합 가입여부 등의 이유로 고용ㆍ보상ㆍ훈련의 기회, 승진, 이직, 퇴직 등에 차별을 하거나 차별을 조장하지 않겠습니다."}, {"block_index": 217, "section_index": 1, "paragraph_index": 176, "location": "section 2 · paragraph 177", "text": "3. 안전시설, 휴게시설 등을 설치하여 근로자의 노동환경을 개선하고 작업과 관련한 사고나 질병을 예방하기 위해 적절한 조치를 취하겠습니다. 특히, 근로자가 건강과 안전이 위험하다고 판단하여 작업을 거부한 경우 즉시 현장의 문제를 조사하여 조치를 취하도록 하겠습니다."}, {"block_index": 218, "section_index": 1, "paragraph_index": 177, "location": "section 2 · paragraph 178", "text": "4. 근로자에게 노동력 착취적인 언어, 신체적 접촉과 성적 강압 등과 같은 행위, 정신적 강압이나 언어폭력 등은 허용하지 않고, 근로자의 개인정보나 사생활에 대한 권리를 존중하겠습니다."}, {"block_index": 219, "section_index": 1, "paragraph_index": 178, "location": "section 2 · paragraph 179", "text": "5. 근로자에게 관련 규정에 부합한 노동시간 준수 및 휴일 제공으로 근로자 자신과 가족이 건강한 생활수준을 누릴 수 있게 하며, 여성근로자의 모성은 특별한 도움을 받을 권리를 보장하겠습니다."}, {"block_index": 220, "section_index": 1, "paragraph_index": 179, "location": "section 2 · paragraph 180", "text": "6. 당사는 근로 중 근로자에게 발생한 문제에 대하여 「근로기준법」,「산업재해보상보험법」,「국민건강보험법」등 관련 법령을 준수하여 필요한 조치를 취하며 이를 위반할 경우에는 관계법령에 따라 책임지겠습니다."}, {"block_index": 221, "section_index": 1, "paragraph_index": 180, "location": "section 2 · paragraph 181", "text": "20 . . ."}, {"block_index": 222, "section_index": 1, "paragraph_index": 181, "location": "section 2 · paragraph 182", "text": "서약자 : 대표 : 󰄫"}, {"block_index": 223, "section_index": 1, "paragraph_index": 182, "location": "section 2 · paragraph 183", "text": "제2장 특별유의사항"}, {"block_index": 224, "section_index": 1, "paragraph_index": 183, "location": "section 2 · paragraph 184", "text": "2.1 구매개요"}, {"block_index": 225, "section_index": 1, "paragraph_index": 184, "location": "section 2 · paragraph 185", "text": "공단은 경북 경주시 문무대왕면 봉길리 일대 중저준위운영본부 내 인수/검사를 위한 방폐물검사건물(제2인수저장건물)의 건설 사업을 추진 중이다."}, {"block_index": 226, "section_index": 1, "paragraph_index": 185, "location": "section 2 · paragraph 186", "text": "2.2 구매범위"}, {"block_index": 227, "section_index": 1, "paragraph_index": 186, "location": "section 2 · paragraph 187", "text": "이 입찰에 의한 구매범위의 상세내역은 제Ⅲ편 입찰서 양식 「가격명세 및 납품일정」및 제Ⅳ편「기술규격서」에 명시되어 있다."}, {"block_index": 228, "section_index": 1, "paragraph_index": 187, "location": "section 2 · paragraph 188", "text": "2.3 납품일정"}, {"block_index": 229, "section_index": 1, "paragraph_index": 188, "location": "section 2 · paragraph 189", "text": "이 입찰에 의한 구매물품의 납품일정은 제Ⅲ편 입찰서 양식 「가격명세 및 납품일정」에 명시되어 있다."}, {"block_index": 230, "section_index": 1, "paragraph_index": 189, "location": "section 2 · paragraph 190", "text": "2.4 입찰마감일시"}, {"block_index": 231, "section_index": 1, "paragraph_index": 190, "location": "section 2 · paragraph 191", "text": "입찰서는 한국시간으로 입찰공고문에 명시된 기간까지 제출되어야 한다."}, {"block_index": 232, "section_index": 1, "paragraph_index": 191, "location": "section 2 · paragraph 192", "text": "2.5 입찰형태"}, {"block_index": 233, "section_index": 1, "paragraph_index": 192, "location": "section 2 · paragraph 193", "text": "가. 이 입찰은 국내 경쟁입찰이다."}, {"block_index": 234, "section_index": 1, "paragraph_index": 193, "location": "section 2 · paragraph 194", "text": "나. 이 입찰은 규격․가격분리 (2단계 경쟁)입찰이다."}, {"block_index": 235, "section_index": 1, "paragraph_index": 194, "location": "section 2 · paragraph 195", "text": "다. 이 입찰은 기술평가 적격업체 중 예정가격 이하 최저가격으로 입찰한 자를 낙찰자로 결정한다."}, {"block_index": 236, "section_index": 1, "paragraph_index": 195, "location": "section 2 · paragraph 196", "text": "2.6 입찰참가자격"}, {"block_index": 237, "section_index": 1, "paragraph_index": 196, "location": "section 2 · paragraph 197", "text": "이 입찰에 참가할 수 있는 자는 기술제안서 제출 마감 전일 현재 공단 등록업체 관리목록의 “Air handling Units & Air Cleaning Units”에 등록된 업체이어야 한다."}, {"block_index": 238, "section_index": 1, "paragraph_index": 197, "location": "section 2 · paragraph 198", "text": "2.7 계약전 통지"}, {"block_index": 239, "section_index": 1, "paragraph_index": 198, "location": "section 2 · paragraph 199", "text": "2.7.1 입찰자는 입찰관련 추가정보의 요청, 입찰참가신청 및 입찰서 제출 등 계약 절차 상 문의는 아래 주소로 하여야 한다."}, {"block_index": 240, "section_index": 1, "paragraph_index": 199, "location": "section 2 · paragraph 200", "text": "경북 경주시 충효천길19 (우‐38062)"}, {"block_index": 241, "section_index": 1, "paragraph_index": 200, "location": "section 2 · paragraph 201", "text": "한국원자력환경공단 경영관리본부 ESG상생팀"}, {"block_index": 242, "section_index": 1, "paragraph_index": 201, "location": "section 2 · paragraph 202", "text": "전화번호 : (054) 750-4071"}, {"block_index": 243, "section_index": 1, "paragraph_index": 202, "location": "section 2 · paragraph 203", "text": "2.7.2 입찰자는 입찰설명서 기술사항 문의 또는 입찰서 기술사항 확인 등 기술 상 문의는 아래 주소로 하여야 한다."}, {"block_index": 244, "section_index": 1, "paragraph_index": 203, "location": "section 2 · paragraph 204", "text": "경북 경주시 충효천길19 (우‐38062)"}, {"block_index": 245, "section_index": 1, "paragraph_index": 204, "location": "section 2 · paragraph 205", "text": "한국원자력환경공단 중저준위기획실 엔지니어링팀"}, {"block_index": 246, "section_index": 1, "paragraph_index": 205, "location": "section 2 · paragraph 206", "text": "전화번호 : (054) 750-4314 / 750-4317"}, {"block_index": 247, "section_index": 1, "paragraph_index": 206, "location": "section 2 · paragraph 207", "text": "2.7.3 위 2.7.1조 및 2.7.2조에 의한 확인요청, 문의, 추가정보 등에 대하여 공단 자신의 판단 하에 회신하지 않거나 또는 회신이 이유를 불문하고 입찰자에게 지연 도착하는 경우에도 입찰자의 지연입찰에 대하여 공단은 어떠한 책임도 지지 않는다."}, {"block_index": 248, "section_index": 1, "paragraph_index": 207, "location": "section 2 · paragraph 208", "text": "2.8 입찰가격 작성기준"}, {"block_index": 249, "section_index": 1, "paragraph_index": 208, "location": "section 2 · paragraph 209", "text": "2.8.1 일반사항"}, {"block_index": 250, "section_index": 1, "paragraph_index": 209, "location": "section 2 · paragraph 210", "text": "입찰자는 입찰설명서에 규정된 요건 및 조건에 따라 공단의 구매범위에 대하여 총액 입찰가격을 제시하여야 하며(공단 선택구매항목은 별도 항목으로 제시), 제Ⅲ편 입찰서 양식 「가격명세 및 납품일정」에 명시한 바와 같이 품목별 및 단계별로 세분하여 가격명세를 제시하여야 한다."}, {"block_index": 251, "section_index": 1, "paragraph_index": 210, "location": "section 2 · paragraph 211", "text": "2.8.2 입찰통화"}, {"block_index": 252, "section_index": 1, "paragraph_index": 211, "location": "section 2 · paragraph 212", "text": "입찰가격은 원화(￦)로 표시하여야 한다."}, {"block_index": 253, "section_index": 1, "paragraph_index": 212, "location": "section 2 · paragraph 213", "text": "2.8.3 납품조건"}, {"block_index": 254, "section_index": 1, "paragraph_index": 213, "location": "section 2 · paragraph 214", "text": "입찰가격은 처분시설 현장하차도 조건에 의한 가격이어야 한다."}, {"block_index": 255, "section_index": 1, "paragraph_index": 214, "location": "section 2 · paragraph 215", "text": "2.8.4 제세 및 공과금"}, {"block_index": 256, "section_index": 1, "paragraph_index": 215, "location": "section 2 · paragraph 216", "text": "입찰가격에는 물품 납품과 용역의 수행에 관련되는 부가가치세를 포함한 모든 세금과 공과금이 포함되어야한다. 부가가치세는 품목별 입찰가격에서는 제외하되 총 입찰가격에는 포함되어야 한다."}, {"block_index": 257, "section_index": 1, "paragraph_index": 216, "location": "section 2 · paragraph 217", "text": "2.9 입찰서 평가 절차 및 기준"}, {"block_index": 258, "section_index": 1, "paragraph_index": 217, "location": "section 2 · paragraph 218", "text": "2.9.1 입찰평가 절차"}, {"block_index": 259, "section_index": 1, "paragraph_index": 218, "location": "section 2 · paragraph 219", "text": "가. 입찰서 평가는 2단계로 구분되어 수행된다. 제1단계는 기술성에 대한 평가이며, 제2단계는 경제성 평가이다. 제1단계 평가 시 부적격으로 평가된 입찰서는 제2단계 평가대상에서 제외된다."}, {"block_index": 260, "section_index": 1, "paragraph_index": 219, "location": "section 2 · paragraph 220", "text": "나. 입찰서 평가를 위하여 공단은 서면 또는 확인회의를 통하여 입찰서 내용을 확인할 수 있다. 공단의 확인 요청에 불응 시는 입찰자에게 불리한 조건으로 평가되거나, 제2단계 평가에서 제외될 수 있으며 이것은 전적으로 입찰자의 책임사항이다."}, {"block_index": 261, "section_index": 1, "paragraph_index": 220, "location": "section 2 · paragraph 221", "text": "2.9.2 입찰평가 기준"}, {"block_index": 262, "section_index": 1, "paragraph_index": 221, "location": "section 2 · paragraph 222", "text": "2.9.2.1 일반기준"}, {"block_index": 263, "section_index": 1, "paragraph_index": 222, "location": "section 2 · paragraph 223", "text": "가. 제1단계 평가에서 공단은 이의사항에 대한 수용여부를 포함하여 각 입찰서가 기술규격 등 입찰 설명서 주요요건을 충족하는지 여부를 평가한다. 1단계 평가 적격자만이 2단계 평가에 신청할 수 있다."}, {"block_index": 264, "section_index": 1, "paragraph_index": 223, "location": "section 2 · paragraph 224", "text": "나. 공단은 제2단계 평가에서 1단계 평가 적격자가 제출한 입찰서 중에서 최저가 입찰서를 선정한다."}, {"block_index": 265, "section_index": 1, "paragraph_index": 224, "location": "section 2 · paragraph 225", "text": "2.9.2.2 입찰평가 항목"}, {"block_index": 266, "section_index": 1, "paragraph_index": 225, "location": "section 2 · paragraph 226", "text": "입찰평가 주요항목은 다음과 같다"}, {"block_index": 267, "section_index": 1, "paragraph_index": 226, "location": "section 2 · paragraph 227", "text": "가. 기술성 평가"}, {"block_index": 268, "section_index": 1, "paragraph_index": 227, "location": "section 2 · paragraph 228", "text": "(1) 공급범위 및 납품일정"}, {"block_index": 269, "section_index": 1, "paragraph_index": 228, "location": "section 2 · paragraph 229", "text": "(2) 기술규격 차이"}, {"block_index": 270, "section_index": 1, "paragraph_index": 229, "location": "section 2 · paragraph 230", "text": "(3) 기기의 성능 및 신뢰성"}, {"block_index": 271, "section_index": 1, "paragraph_index": 230, "location": "section 2 · paragraph 231", "text": "(4) 설치, 시공 유지보수에 있어서의 편의성"}, {"block_index": 272, "section_index": 1, "paragraph_index": 231, "location": "section 2 · paragraph 232", "text": "(5) 품질보증"}, {"block_index": 273, "section_index": 1, "paragraph_index": 232, "location": "section 2 · paragraph 233", "text": "(6) 기술규격에 대한 이의 또는 예외사항"}, {"block_index": 274, "section_index": 1, "paragraph_index": 233, "location": "section 2 · paragraph 234", "text": "(7) 계약조건에 대한 이의 사항"}, {"block_index": 275, "section_index": 1, "paragraph_index": 234, "location": "section 2 · paragraph 235", "text": "(8) 기타 필요한 사항 등"}, {"block_index": 276, "section_index": 1, "paragraph_index": 235, "location": "section 2 · paragraph 236", "text": "2.9.3 기술성 평가 기준"}, {"block_index": 277, "section_index": 1, "paragraph_index": 236, "location": "section 2 · paragraph 237", "text": "가. 기술평가 유의사항"}, {"block_index": 278, "section_index": 1, "paragraph_index": 237, "location": "section 2 · paragraph 238", "text": "ㅇ 입찰서와 기타 구비서류를 검토하여 미비한 입찰자에 대하여는 상황에 따라 보완지시, 실격처리 등의 조치를 취하고 그 결과를 기술평가에 반영할 수 있다."}, {"block_index": 279, "section_index": 1, "paragraph_index": 238, "location": "section 2 · paragraph 239", "text": "ㅇ 입찰내용에 대한 확인, 검증이 필요한 경우 입찰자에게 입증자료를 요구할 수 있으며, 입증자료를 제출하지 못할 경우 입찰내용의 이행을 할 의사가 없는 것으로 간주한다."}, {"block_index": 280, "section_index": 1, "paragraph_index": 239, "location": "section 2 · paragraph 240", "text": "ㅇ 입찰자는 본 사업과 관련하여 취득한 내용에 대하여 제3자에게 누설하여서는 아니 된다."}, {"block_index": 281, "section_index": 1, "paragraph_index": 240, "location": "section 2 · paragraph 241", "text": "ㅇ 입찰자가 제출한 모든 자료 및 문서는 입찰자의 권익보호를 위하여 외부에 공개하지 않음을 원칙으로 한다."}, {"block_index": 282, "section_index": 1, "paragraph_index": 241, "location": "section 2 · paragraph 242", "text": "ㅇ 기술평가는 공단 또는 공단이 지정한 전문기관에서 수행한다."}, {"block_index": 283, "section_index": 1, "paragraph_index": 242, "location": "section 2 · paragraph 243", "text": "나. 기술입찰서 작성 방법"}, {"block_index": 284, "section_index": 1, "paragraph_index": 243, "location": "section 2 · paragraph 244", "text": "ㅇ 기술입찰서는 명료하고 간결하게 작성되어야 하며 불확실하거나 추상적인 표현, 즉 「~가능할 것이다」또는「~고려하고 있다」등은 사용하지 말아야 한다."}, {"block_index": 285, "section_index": 1, "paragraph_index": 244, "location": "section 2 · paragraph 245", "text": "ㅇ 기술입찰서는 허위 또는 예상으로 작성되지 않아야 하며 허위로 작성한 사실이 발견될 시에는 평가대상에서 제외한다."}, {"block_index": 286, "section_index": 1, "paragraph_index": 245, "location": "section 2 · paragraph 246", "text": "ㅇ 입찰자는 사업목적을 효과적으로 달성하기 위하여 필요하다고 판단되는 사항에 대해 추가로 제안 또는 대안을 제시할 수 있다."}, {"block_index": 287, "section_index": 1, "paragraph_index": 246, "location": "section 2 · paragraph 247", "text": "다. 기술평가 평가기준"}, {"block_index": 288, "section_index": 1, "paragraph_index": 247, "location": "section 2 · paragraph 248", "text": "ㅇ 입찰자는 입찰용 기술규격서의 모든 항목을 만족해야 한다. 아울러 입찰자가 제시한 각 항목에 대한 제안 또는 대안사항에 대해 평가자의 승인을 득하는 경우 만족한 것으로 본다."}, {"block_index": 289, "section_index": 1, "paragraph_index": 248, "location": "section 2 · paragraph 249", "text": "ㅇ 입찰자는 제출한 입찰서에 대한 평가자의 질의서 또는 보완자료를 접수한 경우 2주 이내에 적정한 답변을 회신하여야 한다. 입찰자의 답변이 기간을 초과하거나, 동일한 항목에 대해 기술규격서 요건에 불만족한 답변이 3회 이상 계속되는 경우에는 기술요건을 만족시킬 수 없는 것으로 평가한다. 단, 다음의 사항에 해당되는 경우 해당 기간 동안 답변기간을 연장할 수 있다."}, {"block_index": 290, "section_index": 1, "paragraph_index": 249, "location": "section 2 · paragraph 250", "text": "- 질의사항에 대한 상세검토가 필요하여 입찰자 전부가 기한 내 회신이 불가능하고 후속공정에 특별한 영향이 없는 경우"}, {"block_index": 291, "section_index": 1, "paragraph_index": 250, "location": "section 2 · paragraph 251", "text": "- 기타 천재지변 등의 불가항력 사항으로 인정되는 경우"}]