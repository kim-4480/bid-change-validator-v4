[{"block_index": 0, "section_index": 0, "paragraph_index": 0, "location": "section 1 · paragraph 1", "text": "예술의전당 입찰공고 2026-29호"}, {"block_index": 1, "section_index": 0, "paragraph_index": 1, "location": "section 1 · paragraph 2", "text": "나라장터 공고번호"}, {"block_index": 2, "section_index": 0, "paragraph_index": 2, "location": "section 1 · paragraph 3", "text": "용역입찰 공고문"}, {"block_index": 3, "section_index": 0, "paragraph_index": 3, "location": "section 1 · paragraph 4", "text": "1. 입찰에 부치는 사항"}, {"block_index": 4, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "건 명"}, {"block_index": 5, "section_index": 0, "paragraph_index": 6, "location": "section 1 · paragraph 7", "text": "예술의전당 크리스마스 시어터 조성 및 운영 용역"}, {"block_index": 6, "section_index": 0, "paragraph_index": 7, "location": "section 1 · paragraph 8", "text": "과업내용"}, {"block_index": 7, "section_index": 0, "paragraph_index": 8, "location": "section 1 · paragraph 9", "text": "1) 크리스마스 경관 조성"}, {"block_index": 8, "section_index": 0, "paragraph_index": 9, "location": "section 1 · paragraph 10", "text": "2) 공연 중심의 부대 프로그램 운영(6회)"}, {"block_index": 9, "section_index": 0, "paragraph_index": 10, "location": "section 1 · paragraph 11", "text": "3) 현장 운영 및 안전관리 등"}, {"block_index": 10, "section_index": 0, "paragraph_index": 11, "location": "section 1 · paragraph 12", "text": "4) 세부내용은 제안요청서 참조"}, {"block_index": 11, "section_index": 0, "paragraph_index": 12, "location": "section 1 · paragraph 13", "text": "계약기간"}, {"block_index": 12, "section_index": 0, "paragraph_index": 13, "location": "section 1 · paragraph 14", "text": "계약체결일 ~ 2027.1.15."}, {"block_index": 13, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "가격 입찰서 접수"}, {"block_index": 14, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "2026.09.28.(월) 09:00 ~ 2026.10.06.(화) 16:00"}, {"block_index": 15, "section_index": 0, "paragraph_index": 16, "location": "section 1 · paragraph 17", "text": "/조달청 국가종합전자조달시스템(나라장터)"}, {"block_index": 16, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "제안서 및 부대서류 접수"}, {"block_index": 17, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "2026.10.06.(화) 13:00 ~ 16:00"}, {"block_index": 18, "section_index": 0, "paragraph_index": 19, "location": "section 1 · paragraph 20", "text": "/예술의전당 오페라하우스 5층 재무전략부 직접제출"}, {"block_index": 19, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "※우편 및 퀵 배송 접수 불가, 기간 엄수"}, {"block_index": 20, "section_index": 0, "paragraph_index": 21, "location": "section 1 · paragraph 22", "text": "제안서 평가(장소)"}, {"block_index": 21, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "서류접수 후 별도 공지(예술의전당 내, 2026.10.08.(목) 예상)"}, {"block_index": 22, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "※ 입찰 진행상황 및 제안서 접수결과 등에 따라"}, {"block_index": 23, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "평가일정은 변경될 수 있으며, 변경 시 통보 예정"}, {"block_index": 24, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "가격개찰일시"}, {"block_index": 25, "section_index": 0, "paragraph_index": 26, "location": "section 1 · paragraph 27", "text": "제안서 기술능력평가 후"}, {"block_index": 26, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "(예상) 2026.10.08.(목). - 일정은 변동될 수 있음"}, {"block_index": 27, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "사업금액"}, {"block_index": 28, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "금 220,000,000원(부가세 포함)"}, {"block_index": 29, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "(추정가격: 200,000,000원)"}, {"block_index": 30, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "※ 지정된 일시 및 장소에서만 제안서를 접수하며, 접수 시간 외에는 접수 불가"}, {"block_index": 31, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "※ 가격입찰서와 제안서 서류 일체가 모두 제출 되어야 유효함"}, {"block_index": 32, "section_index": 0, "paragraph_index": 33, "location": "section 1 · paragraph 34", "text": "※ 접수업체가 5개를 초과한 경우 정량평가 상위 5개 업체만 제안서 평가 시행"}, {"block_index": 33, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "- 동점자를 포함하여 상위 5순위 이내 업체만을 제안서 평가함"}, {"block_index": 34, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "예시1) 1~4순위 각 1업체, 5순위 동점자 3업체: 총 7개 업체 발표"}, {"block_index": 35, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": "예시2) 1~3순위 각 1업체, 4순위 동점자 3업체: 총 6개 업체 발표"}, {"block_index": 36, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "예시3) 1~2순위 각 1업체, 3순위 동점자 3업체: 총 5개 업체 발표"}, {"block_index": 37, "section_index": 0, "paragraph_index": 38, "location": "section 1 · paragraph 39", "text": "2. 입찰방법 : 제한(총액)경쟁입찰"}, {"block_index": 38, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "가. 낙찰자선정방법 : 협상에 의한 계약"}, {"block_index": 39, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": "나. 청렴계약제가 적용됩니다."}, {"block_index": 40, "section_index": 0, "paragraph_index": 41, "location": "section 1 · paragraph 42", "text": "다. 중소기업 대상입니다."}, {"block_index": 41, "section_index": 0, "paragraph_index": 42, "location": "section 1 · paragraph 43", "text": "라. 공동계약은 허용하지 않습니다."}, {"block_index": 42, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "단, 법령에 위배되지 않는 범위 내에서 외부 전문업체의 활용은 가능합니다."}, {"block_index": 43, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": "3. 입찰참가자격"}, {"block_index": 44, "section_index": 0, "paragraph_index": 45, "location": "section 1 · paragraph 46", "text": "가. 「국가를 당사자로 하는 계약에 관한 법률 시행령」 제12조(경쟁입찰의 참가자격) 및 동법 시행규칙 제14조(입찰참가자격요건의 증명) 규정에 의한 경쟁입찰 참가자격을 갖춘 업체로서 아래의 각 항의 조건을 모두 충족하는 업체"}, {"block_index": 45, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "(1) 공고일 현재 「국가종합전자조달시스템 입찰참가자격등록규정」에 따라 국가종합전자조달시스템에 입찰참가자격 등록마감일시까지 행사대행업(업종코드: 9901)으로 입찰참가자격을 등록한 자로 「중소기업제품 구매촉진 및 판로지원에 관한 법률」제9조 및 같은 법 시행령 제10조에 따라 직접생산확인증명서 (세부품명번호 : 9015189001 / 축제기획및대행서비스)를 소지한 업체"}, {"block_index": 46, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": "(2) 「중소기업기본법」 제2조에 따른 중‧소기업자 또는 「소상공인기본법」 제2조에 따른 소상공인으로서 「중소기업 범위 및 확인에 관한 규정」에 따라 발급된 중소기업ㆍ소상공인 확인서(공공기관 입찰용)를 소지한 자"}, {"block_index": 47, "section_index": 0, "paragraph_index": 49, "location": "section 1 · paragraph 50", "text": "1) 중소기업ㆍ소상공인확인서 및 직접생산확인증명서가 중소기업제품 공공구매 종합정보망(http://www.smpp.go.kr)에서 확인이 안 될 경우 입찰참가자격이 없습니다.(전자입찰서 제출 마감일 전일까지 발급된 것으로, 유효기간 내에 있는 것이 있어야 함)"}, {"block_index": 48, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "2) 중소기업ㆍ소상공인확인서를 규격(기술)입찰서 제출 마감일 전일까지 신청한 사항이 확인된 업체는 입찰참가가 가능하나 다음 중 어느 하나에 해당하는 경우에는 입찰참가자격이 없습니다."}, {"block_index": 49, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": "-입찰서 제출 마감일부터 5일 이내에 중소기업공공구매 종합정보망에서 확인이 되지 않는 경우"}, {"block_index": 50, "section_index": 0, "paragraph_index": 52, "location": "section 1 · paragraph 53", "text": "-발급된 중소기업ㆍ소상공인확인서가 입찰참가자격의 기업 구분과 다른 경우"}, {"block_index": 51, "section_index": 0, "paragraph_index": 53, "location": "section 1 · paragraph 54", "text": "-발급된 중소기업ㆍ소상공인확인서의 유효기간 시작일이 전자입찰서 제출 마감일 이후인 경우"}, {"block_index": 52, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": "-전자입찰서 제출 마감일 이후 중소기업ㆍ소상공인확인서를 신청한 경우"}, {"block_index": 53, "section_index": 0, "paragraph_index": 55, "location": "section 1 · paragraph 56", "text": "(3) 체납사실이 없는 자로서 부정당업자, 영업정지 등 제한사유에 해당되지 않는 자"}, {"block_index": 54, "section_index": 0, "paragraph_index": 56, "location": "section 1 · paragraph 57", "text": "※ 직접생산확인서는 전자입찰서 제출 마감일 전일까지 발급된 것으로 유효기간 내에 있어야 하며, ‘중소기업제품 공공구매 종합정보망(http://www.smpp.go.kr)’에서 확인이 안 될 경우 입찰 참가자격이 없습니다."}, {"block_index": 55, "section_index": 0, "paragraph_index": 57, "location": "section 1 · paragraph 58", "text": "나. 입찰일(낙찰자는 계약체결일)까지 당해자격을 유지하여야 합니다."}, {"block_index": 56, "section_index": 0, "paragraph_index": 58, "location": "section 1 · paragraph 59", "text": "다. 한 업체의 소속 대표자 중 1인이 다른 업체의 대표자를 겸임할 경우 해당 업체들이 하나의 입찰에 동시 참여하면 동일인이 2통의 입찰서를 제출한 것으로 간주되어 모두 무효 입찰로 처리됩니다. 이에 따라 대표자가 여럿인 업체의 경우 입찰참가자격등록 시 대표자 전원을 등록하여야 하며 현재 1인만 등록된 경우 변경등록을 하여야 하며, 변경등록을 하지 아니하고 입찰에 참가한 자는 국가계약법시행규칙 제44조 6의 3호에 의하여 입찰무효 사유에 해당합니다."}, {"block_index": 57, "section_index": 0, "paragraph_index": 59, "location": "section 1 · paragraph 60", "text": "라. 부정당업자로 입찰참가자격의 제한을 받지 아니한 자이어야 하며, 미 자격자가 고의로 입찰에 참가하여 국가를 당사자로 하는 계약에 관한 법률 27조 제1항의 8호 또는 9호 또는 동법 시행령 제76조에 해당된다고 판단될 경우에는 관계규정에 따라 부정당업자로 제재할 수 있습니다."}, {"block_index": 58, "section_index": 0, "paragraph_index": 60, "location": "section 1 · paragraph 61", "text": "4. 입찰서 접수"}, {"block_index": 59, "section_index": 0, "paragraph_index": 61, "location": "section 1 · paragraph 62", "text": "가. 가격입찰서 제출 : 조달청 국가종합전자조달시스템(나라장터) 기간내 24시간 가능"}, {"block_index": 60, "section_index": 0, "paragraph_index": 62, "location": "section 1 · paragraph 63", "text": "나. 제안서 및 입찰관련 서류 : 직접제출"}, {"block_index": 61, "section_index": 0, "paragraph_index": 63, "location": "section 1 · paragraph 64", "text": "※가격입찰서(온라인)와 제안서(오프라인) 모두 제출해야 유효"}, {"block_index": 62, "section_index": 0, "paragraph_index": 64, "location": "section 1 · paragraph 65", "text": "- 서울시 서초구 남부순환로 2406 예술의전당 오페라하우스 5층 재무전략부"}, {"block_index": 63, "section_index": 0, "paragraph_index": 65, "location": "section 1 · paragraph 66", "text": "다. 제출서류 : 작성방법, 목차 등은 제안요청서 참고"}, {"block_index": 64, "section_index": 0, "paragraph_index": 66, "location": "section 1 · paragraph 67", "text": "(1) 금액산출내역서 1부(별도 밀봉 제출)"}, {"block_index": 65, "section_index": 0, "paragraph_index": 67, "location": "section 1 · paragraph 68", "text": "(2) 제안서를 수록한 USB 2개 (※읽기 오류 대응을 위함)"}, {"block_index": 66, "section_index": 0, "paragraph_index": 68, "location": "section 1 · paragraph 69", "text": "(3) 증빙서류철(원본) 각 1부"}, {"block_index": 67, "section_index": 0, "paragraph_index": 69, "location": "section 1 · paragraph 70", "text": "- 입찰참가신청서"}, {"block_index": 68, "section_index": 0, "paragraph_index": 70, "location": "section 1 · paragraph 71", "text": "- 조달청 경쟁입찰 참가자격등록증"}, {"block_index": 69, "section_index": 0, "paragraph_index": 71, "location": "section 1 · paragraph 72", "text": "- 사업자등록증"}, {"block_index": 70, "section_index": 0, "paragraph_index": 72, "location": "section 1 · paragraph 73", "text": "- 법인등기부등본(법인) 또는 주민등록등본(개인, 주민번호 암호화)"}, {"block_index": 71, "section_index": 0, "paragraph_index": 73, "location": "section 1 · paragraph 74", "text": "- 인감증명서 및 사용인감계(개인, 법인)"}, {"block_index": 72, "section_index": 0, "paragraph_index": 74, "location": "section 1 · paragraph 75", "text": "- 중‧소기업확인서"}, {"block_index": 73, "section_index": 0, "paragraph_index": 75, "location": "section 1 · paragraph 76", "text": "- 기타자유업(행사대행업, 업종코드 9901) 등록 확인 자료"}, {"block_index": 74, "section_index": 0, "paragraph_index": 76, "location": "section 1 · paragraph 77", "text": "- 직접생산확인증명서(세부품명번호 : 9015189001 / 축제기획및대행서비스)"}, {"block_index": 75, "section_index": 0, "paragraph_index": 77, "location": "section 1 · paragraph 78", "text": "- 국세/지방세 완납증명원 및 4대보험 완납증명원"}, {"block_index": 76, "section_index": 0, "paragraph_index": 78, "location": "section 1 · paragraph 79", "text": "- 신용등급평가확인서"}, {"block_index": 77, "section_index": 0, "paragraph_index": 79, "location": "section 1 · paragraph 80", "text": "- 투입인력 재직증명서 및 수행조직의 업무분장"}, {"block_index": 78, "section_index": 0, "paragraph_index": 80, "location": "section 1 · paragraph 81", "text": "- 개인정보 수집‧이용‧제공 동의서"}, {"block_index": 79, "section_index": 0, "paragraph_index": 81, "location": "section 1 · paragraph 82", "text": "- 보안서약서, 확약서"}, {"block_index": 80, "section_index": 0, "paragraph_index": 82, "location": "section 1 · paragraph 83", "text": "- 청렴이행각서"}, {"block_index": 81, "section_index": 0, "paragraph_index": 83, "location": "section 1 · paragraph 84", "text": "- (대리인 제출시)위임장 및 재직증명서(입찰참가자)"}, {"block_index": 82, "section_index": 0, "paragraph_index": 84, "location": "section 1 · paragraph 85", "text": "※ 입찰참가자 명함 지참 필수"}, {"block_index": 83, "section_index": 0, "paragraph_index": 85, "location": "section 1 · paragraph 86", "text": "라. 유의사항"}, {"block_index": 84, "section_index": 0, "paragraph_index": 86, "location": "section 1 · paragraph 87", "text": "(1) 제출 서류 중 사본 제출 시에는 사본에 “원본과 상위없음”이라고 명기하고, 사용인장으로 날인 및 테이핑하여 제출."}, {"block_index": 85, "section_index": 0, "paragraph_index": 87, "location": "section 1 · paragraph 88", "text": "(2) 제안서는 등록서류를 갖추어 직접 제출하여야 하며, 우편접수는 인정하지 않습니다."}, {"block_index": 86, "section_index": 0, "paragraph_index": 88, "location": "section 1 · paragraph 89", "text": "(3) 제출한 제안서 등 자료는 반환하지 않습니다."}, {"block_index": 87, "section_index": 0, "paragraph_index": 89, "location": "section 1 · paragraph 90", "text": "(4) 제안업체가 제출한 모든 자료 및 문서는 외부에 공개하지 않습니다."}, {"block_index": 88, "section_index": 0, "paragraph_index": 90, "location": "section 1 · paragraph 91", "text": "마. 문의처"}, {"block_index": 89, "section_index": 0, "paragraph_index": 91, "location": "section 1 · paragraph 92", "text": "(1) 과업에 관한 사항"}, {"block_index": 90, "section_index": 0, "paragraph_index": 92, "location": "section 1 · paragraph 93", "text": ": 예술의전당 야외사업부 (Tel : 02-580-1231)"}, {"block_index": 91, "section_index": 0, "paragraph_index": 93, "location": "section 1 · paragraph 94", "text": "(2) 입찰 및 계약에 관한 사항"}, {"block_index": 92, "section_index": 0, "paragraph_index": 94, "location": "section 1 · paragraph 95", "text": ": 예술의전당 재무전략부 (Tel : 02-580-1111)"}, {"block_index": 93, "section_index": 0, "paragraph_index": 95, "location": "section 1 · paragraph 96", "text": "(3) 예술의전당은 일요일과 월요일은 휴무일로 문의가 불가능합니다."}, {"block_index": 94, "section_index": 0, "paragraph_index": 96, "location": "section 1 · paragraph 97", "text": "5. 입찰보증금"}, {"block_index": 95, "section_index": 0, "paragraph_index": 97, "location": "section 1 · paragraph 98", "text": "가. 입찰보증금 납부는 면제하되, 전자입찰 시 정해진 서식에 따라 송신한 입찰서를 입찰금액의 100분의 5이상에 해당하는 입찰보증금 지급확약서를 제출한 것으로 간주합니다. 단, ‘나, 다’항의 경우는 그러하지 않습니다."}, {"block_index": 96, "section_index": 0, "paragraph_index": 98, "location": "section 1 · paragraph 99", "text": "나. 신용정보 관리규약에 의한 채무불이행 또는 금융질서 문란자인 경우"}, {"block_index": 97, "section_index": 0, "paragraph_index": 99, "location": "section 1 · paragraph 100", "text": "다. 입찰공고일 이전 1년 이내에 「국가계약법 시행령」 제76조제2항제2호가목의 사유로 입찰참가자격 제한을 받은 자(입찰참가자격 제한 기간 중인 경우를 포함한다.)"}, {"block_index": 98, "section_index": 0, "paragraph_index": 100, "location": "section 1 · paragraph 101", "text": "라. 상기 ‘나’ 및 ‘다’항에서 규정한 입찰보증금은 반드시 입찰일 전일(공휴일인 경우 그 전일) 18:00까지 나라장터를 통해 납부하여야 합니다."}, {"block_index": 99, "section_index": 0, "paragraph_index": 101, "location": "section 1 · paragraph 102", "text": "마. 낙찰자가 정당한 사유 없이 계약을 체결하지 아니할 경우에는 입찰보증금 납부 확약 내용에 따라 입찰보증금을 당사에 납부하여야 하며, 부정당업자로 입찰참가자격제한처분을 받을 수 있습니다."}, {"block_index": 100, "section_index": 0, "paragraph_index": 102, "location": "section 1 · paragraph 103", "text": "바. 입찰보증금의 납부와 관련하여 입찰참가자는 반드시 본 건 입찰공고의 입찰보증금 내용을 숙지하시기 바랍니다."}, {"block_index": 101, "section_index": 0, "paragraph_index": 103, "location": "section 1 · paragraph 104", "text": "6. 입찰의 무효 : “입찰”이라 하면 전당에 제안서를 제출하는 행위를 포함하며 다음에 해당할 경우 입찰을 무효처리 합니다."}, {"block_index": 102, "section_index": 0, "paragraph_index": 104, "location": "section 1 · paragraph 105", "text": "가. 입찰참가자격이 없는 자가 입찰한 입찰 또는 입찰에 관한 제반사항을 위반한 자"}, {"block_index": 103, "section_index": 0, "paragraph_index": 105, "location": "section 1 · paragraph 106", "text": "나. 입찰보증금을 소정기일까지 납부하지 않은 입찰"}, {"block_index": 104, "section_index": 0, "paragraph_index": 106, "location": "section 1 · paragraph 107", "text": "다. 제안서를 지정된 기간 내에 입찰장소에 제출하지 않은 입찰"}, {"block_index": 105, "section_index": 0, "paragraph_index": 107, "location": "section 1 · paragraph 108", "text": "라. 동일인(1인이 수개의 법인의 대표자인 경우 해당수개의 법인을 동일인으로 본다)이 2통 이상의 입찰서를 제출한 입찰"}, {"block_index": 106, "section_index": 0, "paragraph_index": 108, "location": "section 1 · paragraph 109", "text": "7. 제안설명회 및 제안서 평가 : 오프라인 시행, 일정 별도 공지"}, {"block_index": 107, "section_index": 0, "paragraph_index": 109, "location": "section 1 · paragraph 110", "text": "가. 평가기관 : 기관 자체 평가"}, {"block_index": 108, "section_index": 0, "paragraph_index": 110, "location": "section 1 · paragraph 111", "text": "나. 제안서 평가 : 제안요청서 참조"}, {"block_index": 109, "section_index": 0, "paragraph_index": 111, "location": "section 1 · paragraph 112", "text": "※ 본 사업은 전문성ㆍ기술성ㆍ안전성ㆍ기획력 및 현장운영의 역량을 종합적으로"}, {"block_index": 110, "section_index": 0, "paragraph_index": 112, "location": "section 1 · paragraph 113", "text": "평가하기 위하여 기술능력 평가의 비중을 높여 평가합니다."}, {"block_index": 111, "section_index": 0, "paragraph_index": 113, "location": "section 1 · paragraph 114", "text": "- 기술능력평가: 90%"}, {"block_index": 112, "section_index": 0, "paragraph_index": 114, "location": "section 1 · paragraph 115", "text": "* 정량평가: 경영상태(기업신용평가등급)"}, {"block_index": 113, "section_index": 0, "paragraph_index": 115, "location": "section 1 · paragraph 116", "text": "* 정성평가: 과업이해도, 수행능력, 관리능력 등 세부배점은 제안요청서 참조"}, {"block_index": 114, "section_index": 0, "paragraph_index": 116, "location": "section 1 · paragraph 117", "text": "- 가격평가: 10%"}, {"block_index": 115, "section_index": 0, "paragraph_index": 117, "location": "section 1 · paragraph 118", "text": "* 가격적정성 평가는 시행하지 아니함."}, {"block_index": 116, "section_index": 0, "paragraph_index": 118, "location": "section 1 · paragraph 119", "text": "8. 예정가격"}, {"block_index": 117, "section_index": 0, "paragraph_index": 119, "location": "section 1 · paragraph 120", "text": "본 입찰의 예정가격은「국가를 당사자로 하는 계약에 관한 법률 시행령」제7조의2 제2항에 의거 작성하지 않습니다."}, {"block_index": 118, "section_index": 0, "paragraph_index": 120, "location": "section 1 · paragraph 121", "text": "9. 가격개찰 일시 및 장소 : 제안서 기술평가 이후(계약집행관 PC/나라장터)"}, {"block_index": 119, "section_index": 0, "paragraph_index": 121, "location": "section 1 · paragraph 122", "text": "10. 협상대상자 선정 및 낙찰자 선정"}, {"block_index": 120, "section_index": 0, "paragraph_index": 122, "location": "section 1 · paragraph 123", "text": "가. 예술의전당 여건에 가장 적합한 업체를 선정하기 위하여 기술(90%)/가격(10%)을 평가하여 합산점수 고득점자 순으로 대상자를 선정합니다. 단, 제안서 평가결과 기술능력 평가점수가 배점한도의 85%(76.5점) 미만은 협상대상에서 제외합니다."}, {"block_index": 121, "section_index": 0, "paragraph_index": 123, "location": "section 1 · paragraph 124", "text": "나. 동점인 경우의 우선협상대상자 선정 방법"}, {"block_index": 122, "section_index": 0, "paragraph_index": 124, "location": "section 1 · paragraph 125", "text": "(1) 종합평가점수가 동점인 경우 기술능력평가 점수가 높은 업체를 선정"}, {"block_index": 123, "section_index": 0, "paragraph_index": 125, "location": "section 1 · paragraph 126", "text": "(2) 기술능력평가도 동점인 경우 정성적 평가분야의 배점이 큰 항목(順)에서 높은 점수를 얻은 자를 선순위자로 합니다."}, {"block_index": 124, "section_index": 0, "paragraph_index": 126, "location": "section 1 · paragraph 127", "text": "(3) 상기 점수가 모두 동일한 경우 추첨에 의해 결정"}, {"block_index": 125, "section_index": 0, "paragraph_index": 127, "location": "section 1 · paragraph 128", "text": "다. 위에 따라 협상이 성립된 때에는 다른 협상적격자와는 협상을 실시하지 않습니다."}, {"block_index": 126, "section_index": 0, "paragraph_index": 128, "location": "section 1 · paragraph 129", "text": "라. 모든 협상적격자와의 협상이 결렬된 경우에는 재공고 또는 새로운 입찰에 부칩니다."}, {"block_index": 127, "section_index": 0, "paragraph_index": 129, "location": "section 1 · paragraph 130", "text": "11. 계약"}, {"block_index": 128, "section_index": 0, "paragraph_index": 130, "location": "section 1 · paragraph 131", "text": "낙찰자는 낙찰일로부터 5일 이내에 전당이 요구하는 계약에 필요한 구비서류를 지참, 방문거나, 나라장터의 전자적 방식을 이용하여 계약을 체결하여야 합니다."}, {"block_index": 129, "section_index": 0, "paragraph_index": 131, "location": "section 1 · paragraph 132", "text": "12. 불공정행위 금지 및 청렴이행각서 제출"}, {"block_index": 130, "section_index": 0, "paragraph_index": 132, "location": "section 1 · paragraph 133", "text": "가. 입찰자 또는 계약상대자(이하 이 조에서는 “입찰자 등”이라 한다)는 입찰·낙찰, 계약체결 또는 계약이행 등의 과정에서 입찰 및 계약의 공정한 질서를 저해하는 다음 각 호의 어느 하나에 해당하는 행위를 하여서는 아니됩니다."}, {"block_index": 131, "section_index": 0, "paragraph_index": 133, "location": "section 1 · paragraph 134", "text": "1) 금품·향응 등의 공여·약속 또는 공여의 의사를 표시하는 행위"}, {"block_index": 132, "section_index": 0, "paragraph_index": 134, "location": "section 1 · paragraph 135", "text": "2) 입찰가격의 사전 협의 또는 특정인의 낙찰을 위한 담합 등 공정한 경쟁을 방해하는 행위"}, {"block_index": 133, "section_index": 0, "paragraph_index": 135, "location": "section 1 · paragraph 136", "text": "3) 공정한 직무수행을 방해하는 알선·청탁을 통하여 입찰 또는 계약과 관련된 특정 정보의 제공을 요구하는 행위"}, {"block_index": 134, "section_index": 0, "paragraph_index": 136, "location": "section 1 · paragraph 137", "text": "4) 하수급인 또는 자재·장비업자의 계약상 이익을 부당하게 제한하는 행위"}, {"block_index": 135, "section_index": 0, "paragraph_index": 137, "location": "section 1 · paragraph 138", "text": "5) 그 밖에 입찰 및 계약 등 과정에서 공정한 경쟁을 저해하는 행위"}, {"block_index": 136, "section_index": 0, "paragraph_index": 138, "location": "section 1 · paragraph 139", "text": "나. 입찰자 등은 제1항 각 호에 따른 행위가 「국가를 당사자로 하는 계약에 관한 법률」제5조의3 등 관계 법령에 위반되는 경우 해당 입찰·낙찰이 취소되거나 계약이 해지·해제될 수 있고, 입찰참가자격 제한 대상에 해당되는 경우 「국가를 당사자로 하는 계약에 관한 법률」제27조 등 관계 법령에 따라 부정당업자로 입찰참가자격 제한처분을 받을 수 있습니다."}, {"block_index": 137, "section_index": 0, "paragraph_index": 139, "location": "section 1 · paragraph 140", "text": "다. 계약담당자는 제 가항 각 호의 위반행위를 확인하기 위하여 입찰자 등에게 관련 자료제출을 요청할 수 있으며, 입찰자 등은 특별한 사정이 없는 한 적극 협조하여야 합니다."}, {"block_index": 138, "section_index": 0, "paragraph_index": 140, "location": "section 1 · paragraph 141", "text": "라. 입찰자 등은 계약담당자가 제 가항 제 2호 위반행위의 확인을 위하여 제 다항에 따른 자료제출을 요청함에도 불구하고 협조를 하지 않는 경우 “부당한 공동행위 고발요청 기준”에 따라 불이익을 받을 수 있습니다."}, {"block_index": 139, "section_index": 0, "paragraph_index": 141, "location": "section 1 · paragraph 142", "text": "마. 본 입찰에 참여하는 모든 업체는 청렴계약이행을 위한 입찰특별유의서 및 특수조건을 준수하겠다는 ‘청렴이행각서’를 제출하여야 합니다."}, {"block_index": 140, "section_index": 0, "paragraph_index": 142, "location": "section 1 · paragraph 143", "text": "13. 기타사항"}, {"block_index": 141, "section_index": 0, "paragraph_index": 143, "location": "section 1 · paragraph 144", "text": "가. 입찰참가자는 전당으로부터 받은 제안요청서 등 각종 자료 및 정보를 당해 입찰 외 다른 목적으로 사용해서는 안 됩니다. 제출된 서류는 일체 반환하지 않으며, 본건 제안을 위하여 소요되는 모든 비용은 입찰참가자가 부담하여야 합니다. 제출된 서류에 한하여 평가하며, 제출된 서류의 미비 등으로 인한 불이익의 책임은 제출자에게 있습니다. 평가자료에 허위 사실이 발견된 경우에는 입찰참가제한 및 관계법령에 따른 불이익 처분을 받을 수 있으며, 낙찰대상에서 제외할 수 있습니다."}, {"block_index": 142, "section_index": 0, "paragraph_index": 144, "location": "section 1 · paragraph 145", "text": "나. 낙찰자로 선정된 후 제출한 서류에서 허위사실이 발견되는 경우 낙찰자 선정은 취소되며 부정당업자로 입찰참가자격을 제한받을 수 있으며, 계약체결 후라도 계약해제의 사유가 되며 이에 대한 일체의 책임을 부담하여야 합니다."}, {"block_index": 143, "section_index": 0, "paragraph_index": 145, "location": "section 1 · paragraph 146", "text": "다. 공고 및 제안요청서의 내용은 발주처의 해석에 따릅니다."}, {"block_index": 144, "section_index": 0, "paragraph_index": 146, "location": "section 1 · paragraph 147", "text": "라. 본 건과 관련하여 입찰공고서와 제안요청서 등의 내용이 서로 다를 경우에는 입찰공고서가 우선 적용됩니다."}, {"block_index": 145, "section_index": 0, "paragraph_index": 147, "location": "section 1 · paragraph 148", "text": "마. 입찰참가자는 정한 입찰에 필요한 일체의 사항을 숙지하고 입찰에 응해 주시기 바라며, 이를 숙지하지 못하여 발생하는 책임은 입찰자에게 있습니다."}, {"block_index": 146, "section_index": 0, "paragraph_index": 148, "location": "section 1 · paragraph 149", "text": "바. 본 공고문에 특별히 언급되지 아니한 사항은 전당규정 및 기타공공기관 계약사무 운영규정, 국가를 당사자로 하는 계약에 관한 법률, 시행령, 시행규칙, 계약예규 등 관련규정에 의합니다."}, {"block_index": 147, "section_index": 0, "paragraph_index": 149, "location": "section 1 · paragraph 150", "text": "사. 입찰 및 계약과 관련하여 전당 직원이 금품, 향응 등 부당한 요구를 할 경우 예술의전당 감사실(02-580-1040)에 신고하여 주시기 바랍니다."}, {"block_index": 148, "section_index": 0, "paragraph_index": 150, "location": "section 1 · paragraph 151", "text": "아. 본 입찰의 낙찰자는 근로자와 고용계약을 체결할 경우 최저임금법 제10조 제1항의 규정에 의하여 고용노동부 장관이 고시한 최저임금액 미만으로 계약할 수 없습니다."}, {"block_index": 149, "section_index": 0, "paragraph_index": 152, "location": "section 1 · paragraph 153", "text": "국가종합전자조달시스템 전자입찰 특별유의서(조달청고시)"}, {"block_index": 150, "section_index": 0, "paragraph_index": 153, "location": "section 1 · paragraph 154", "text": "국가종합전자지스템 입찰참가자격등록규정(조달청고시)"}, {"block_index": 151, "section_index": 0, "paragraph_index": 154, "location": "section 1 · paragraph 155", "text": "기타공공기관 계약사무 운영규정(재정경제부훈령)"}, {"block_index": 152, "section_index": 0, "paragraph_index": 155, "location": "section 1 · paragraph 156", "text": "정부입찰․계약집행기준(기획재정부계약예규)"}, {"block_index": 153, "section_index": 0, "paragraph_index": 156, "location": "section 1 · paragraph 157", "text": "용역입찰유의서(기획재정부계약예규)"}, {"block_index": 154, "section_index": 0, "paragraph_index": 157, "location": "section 1 · paragraph 158", "text": "용역계약일반조건(기획재정부계약예규)"}, {"block_index": 155, "section_index": 0, "paragraph_index": 158, "location": "section 1 · paragraph 159", "text": "용역계약특수조건(조달청지침)"}, {"block_index": 156, "section_index": 0, "paragraph_index": 159, "location": "section 1 · paragraph 160", "text": "협상에 의한 계약체결기준(기획재정부계약예규)"}, {"block_index": 157, "section_index": 0, "paragraph_index": 160, "location": "section 1 · paragraph 161", "text": "조달청 협상에 의한 계약 제안서평가 세부기준(조달청지침)"}, {"block_index": 158, "section_index": 0, "paragraph_index": 161, "location": "section 1 · paragraph 162", "text": "기타 입찰・계약관련 법령 및 규정"}, {"block_index": 159, "section_index": 0, "paragraph_index": 162, "location": "section 1 · paragraph 163", "text": "※ 자료검색 : 국가법령정보센터(http://law.go.kr)에서 검색"}, {"block_index": 160, "section_index": 0, "paragraph_index": 163, "location": "section 1 · paragraph 164", "text": "※ 입찰공고문에 정한 각종 규정은 개정될 수 있으며, 개정될 경우 개정규정 부칙의 시행일(또는 적용례)에 따라 개정규정의 적용 여부가 결정될 수 있습니다."}, {"block_index": 161, "section_index": 0, "paragraph_index": 164, "location": "section 1 · paragraph 165", "text": "위와 같이 공고합니다."}, {"block_index": 162, "section_index": 0, "paragraph_index": 165, "location": "section 1 · paragraph 166", "text": "2026년 09월 22일"}, {"block_index": 163, "section_index": 0, "paragraph_index": 166, "location": "section 1 · paragraph 167", "text": "예 술 의 전 당 사 장"}]