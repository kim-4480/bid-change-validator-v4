[{"block_index": 0, "section_index": 0, "paragraph_index": 2, "location": "section 1 · paragraph 3", "text": "2027. 전남광주교육 홍보영상"}, {"block_index": 1, "section_index": 0, "paragraph_index": 3, "location": "section 1 · paragraph 4", "text": "제작 용역 과업지시서"}, {"block_index": 2, "section_index": 0, "paragraph_index": 5, "location": "section 1 · paragraph 6", "text": "2026. 8."}, {"block_index": 3, "section_index": 0, "paragraph_index": 8, "location": "section 1 · paragraph 9", "text": "홍보담당관"}, {"block_index": 4, "section_index": 0, "paragraph_index": 10, "location": "section 1 · paragraph 11", "text": "2027. 전남광주교육 홍보영상 제작 용역 과업지시서"}, {"block_index": 5, "section_index": 0, "paragraph_index": 11, "location": "section 1 · paragraph 12", "text": "홍보담당관"}, {"block_index": 6, "section_index": 0, "paragraph_index": 13, "location": "section 1 · paragraph 14", "text": "1"}, {"block_index": 7, "section_index": 0, "paragraph_index": 14, "location": "section 1 · paragraph 15", "text": "과업 사양"}, {"block_index": 8, "section_index": 0, "paragraph_index": 15, "location": "section 1 · paragraph 16", "text": "과업명: 2027. 전남광주교육 홍보영상 제작"}, {"block_index": 9, "section_index": 0, "paragraph_index": 16, "location": "section 1 · paragraph 17", "text": "목적"}, {"block_index": 10, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "❍ 전남광주교육 비전, 교육지표 및 역점과제 등 홍보"}, {"block_index": 11, "section_index": 0, "paragraph_index": 18, "location": "section 1 · paragraph 19", "text": "❍ 해외 및 국내 교육관계자에게 전남광주교육 홍보"}, {"block_index": 12, "section_index": 0, "paragraph_index": 19, "location": "section 1 · paragraph 20", "text": "과업기간: 계약일 ~ 2026. 12. 18.(금)"}, {"block_index": 13, "section_index": 0, "paragraph_index": 20, "location": "section 1 · paragraph 21", "text": "세부 사양"}, {"block_index": 14, "section_index": 0, "paragraph_index": 22, "location": "section 1 · paragraph 23", "text": "구분"}, {"block_index": 15, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "세부 내용"}, {"block_index": 16, "section_index": 0, "paragraph_index": 24, "location": "section 1 · paragraph 25", "text": "제작"}, {"block_index": 17, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "형태"}, {"block_index": 18, "section_index": 0, "paragraph_index": 26, "location": "section 1 · paragraph 27", "text": "· 외장하드 제출"}, {"block_index": 19, "section_index": 0, "paragraph_index": 27, "location": "section 1 · paragraph 28", "text": "① 교직원용 홍보영상 3편(편당 40초 ~ 1분 내외)"}, {"block_index": 20, "section_index": 0, "paragraph_index": 28, "location": "section 1 · paragraph 29", "text": "- 전남광주교육 비전 1편(40초)"}, {"block_index": 21, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "- 전남광주교육 교육지표 1편(40초)"}, {"block_index": 22, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "- 전남광주교육 역점과제 1편(1분 내외)"}, {"block_index": 23, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "- 총 3종(한국어, 영어, 수어)"}, {"block_index": 24, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "② 전광판용 타이포그래픽(2분 내외)"}, {"block_index": 25, "section_index": 0, "paragraph_index": 33, "location": "section 1 · paragraph 34", "text": "제작"}, {"block_index": 26, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "방식"}, {"block_index": 27, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "· 촬영 및 편집: 4K 이상"}, {"block_index": 28, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": "· 출력: 4K 영상, 외장하드 납품"}, {"block_index": 29, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "제작"}, {"block_index": 30, "section_index": 0, "paragraph_index": 38, "location": "section 1 · paragraph 39", "text": "언어"}, {"block_index": 31, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "· 한국어, 영어, 수어(3종)"}, {"block_index": 32, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": "· 번역과 성우 내레이션 및 자막"}, {"block_index": 33, "section_index": 0, "paragraph_index": 41, "location": "section 1 · paragraph 42", "text": "수량"}, {"block_index": 34, "section_index": 0, "paragraph_index": 42, "location": "section 1 · paragraph 43", "text": "· 총 4편(홍보영상 3편, 타이포그래픽 1편)"}, {"block_index": 35, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "납품"}, {"block_index": 36, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": "방법"}, {"block_index": 37, "section_index": 0, "paragraph_index": 45, "location": "section 1 · paragraph 46", "text": "· 파일형태: MP4(AVI, WMV 가능)"}, {"block_index": 38, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "· 촬영 Master Data 외장하드 납품"}, {"block_index": 39, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": "① 자막, 사운드 제외 무압축 클린본 원본 영상 제공"}, {"block_index": 40, "section_index": 0, "paragraph_index": 48, "location": "section 1 · paragraph 49", "text": "② 영상에 사용된 모든 음원 제공"}, {"block_index": 41, "section_index": 0, "paragraph_index": 49, "location": "section 1 · paragraph 50", "text": "③ 영상 재편집을 위한 모든 파일 제공"}, {"block_index": 42, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "(영상에 사용된 프로젝트 파일 및 파일경로가 변경되지 않은"}, {"block_index": 43, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": "원본파일 링크 소스 일체 제공)"}, {"block_index": 44, "section_index": 0, "paragraph_index": 53, "location": "section 1 · paragraph 54", "text": "2"}, {"block_index": 45, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": "과업 범위"}, {"block_index": 46, "section_index": 0, "paragraph_index": 55, "location": "section 1 · paragraph 56", "text": "전남광주교육 비전, 교육지표 및 역점과제 등을 고려한 전남광주교육 주요 정책분야에 대한 생생한 영상 표현"}, {"block_index": 47, "section_index": 0, "paragraph_index": 56, "location": "section 1 · paragraph 57", "text": "시나리오 기획, 촬영, 편집, 자막/타이틀, 음향, 음원 제작, 녹음, 교정, 외국어 번역, 더빙, 수화 녹화 등 영상제작에 필요한 전반"}, {"block_index": 48, "section_index": 0, "paragraph_index": 57, "location": "section 1 · paragraph 58", "text": "❍ 4K의 고화질 카메라, 크레인, 이동차, 드론, 특수 카메라(고속, 저속, 적외선) 등 다양한 장비 활용 촬영"}, {"block_index": 49, "section_index": 0, "paragraph_index": 58, "location": "section 1 · paragraph 59", "text": "❍ 최고 상태의 컴퓨터그래픽(CG), 자막/타이틀 사용"}, {"block_index": 50, "section_index": 0, "paragraph_index": 59, "location": "section 1 · paragraph 60", "text": "❍ 수준 높은 영상 제작기법과 최첨단 특수효과를 사용"}, {"block_index": 51, "section_index": 0, "paragraph_index": 60, "location": "section 1 · paragraph 61", "text": "❍ 음향, 인포그래픽, 이미지 등은 사전에 저작권 확보 필수"}, {"block_index": 52, "section_index": 0, "paragraph_index": 61, "location": "section 1 · paragraph 62", "text": "예술성과 흥미를 겸비한 화면을 구성하여 창의적인 영상물 제작"}, {"block_index": 53, "section_index": 0, "paragraph_index": 63, "location": "section 1 · paragraph 64", "text": "3"}, {"block_index": 54, "section_index": 0, "paragraph_index": 64, "location": "section 1 · paragraph 65", "text": "세부과업 내용"}, {"block_index": 55, "section_index": 0, "paragraph_index": 65, "location": "section 1 · paragraph 66", "text": "일반사항"}, {"block_index": 56, "section_index": 0, "paragraph_index": 66, "location": "section 1 · paragraph 67", "text": "❍ 본 과업은 전남광주통합특별시교육청(이하, 우리청)의 제반규정에 의하여 수행함을 원칙으로 하며, 과업지시서상의 용어 해석과 과업 내용에 대하여 우리청과 의견을 달리할 경우에는 상호 협의하여 결정하여야 한다."}, {"block_index": 57, "section_index": 0, "paragraph_index": 67, "location": "section 1 · paragraph 68", "text": "❍ 과업수행은 해당분야의 경험 및 전문능력을 활용하여 성실히 수행하여야 하며, 과업범위는 기획, 구성(안), 시나리오, 콘티, 촬영, 연출, 녹음(음악), 음향․음악, 디자인, 편집, 보정, 번역, 시사회, 수정 등 전 과정을 포함한다."}, {"block_index": 58, "section_index": 0, "paragraph_index": 68, "location": "section 1 · paragraph 69", "text": "❍ 과업수행업체는 계약 후 5일 이내에 제작계획서(공정표 포함)를 제출하여야 한다."}, {"block_index": 59, "section_index": 0, "paragraph_index": 69, "location": "section 1 · paragraph 70", "text": "시나리오 작성"}, {"block_index": 60, "section_index": 0, "paragraph_index": 70, "location": "section 1 · paragraph 71", "text": "❍ 수준 높은 영상물을 제작하기 위하여 시나리오는 대기업이나 공기업 홍보영상 시나리오 구성 경험이 있는자로, 7년 이상 경력의 전문작가가 작성하여야 한다."}, {"block_index": 61, "section_index": 0, "paragraph_index": 71, "location": "section 1 · paragraph 72", "text": "❍ 시나리오는 착수보고 후 7일 이내 영상물 기본 콘셉트(안)을 제출하되 사전에 우리청의 승인을 받아야 한다."}, {"block_index": 62, "section_index": 0, "paragraph_index": 72, "location": "section 1 · paragraph 73", "text": "❍ 시나리오 내용이 홍보물 제작 목적과 작품 구성상 불합리하다고 판단될 때에는 우리청과 협의 후 수정․보완하여야 한다."}, {"block_index": 63, "section_index": 0, "paragraph_index": 73, "location": "section 1 · paragraph 74", "text": "❍ 시나리오 방향은 현장 중심의 수요자가 호응할 수 있는 영상 형태 및 연출 방향(옴니버스, 뮤직비디오, 드라마 형태 등)으로 진행할 수 있도록 작성하고, 작성 방향은 우리청과 협의 후 정해야 한다."}, {"block_index": 64, "section_index": 0, "paragraph_index": 74, "location": "section 1 · paragraph 75", "text": "❍ 단순 나열식 원고작성을 지양하고, 주요 정책분야의 추진방향에 대한 스토리가 담길 수 있게 간결하고 명확한 문체를 사용하여 발주처의 교육철학 및 특성을 효과적으로 전달하여야 한다."}, {"block_index": 65, "section_index": 0, "paragraph_index": 75, "location": "section 1 · paragraph 76", "text": "❍ 각 홍보물의 특성에 맞춰 전문가가 아니어도 홍보물의 흐름을 인식할 수 있도록 작성하여야 한다."}, {"block_index": 66, "section_index": 0, "paragraph_index": 76, "location": "section 1 · paragraph 77", "text": "❍ 원고의 내용 및 문체는 우리청과 협의하여 수정 및 확정하며 최종결과물이 납품될 때까지 지속해서 협의하여야 한다."}, {"block_index": 67, "section_index": 0, "paragraph_index": 77, "location": "section 1 · paragraph 78", "text": "❍ 시나리오가 완성된 후 스토리보드를 제작하여 우리청의 승인을 받아야 한다."}, {"block_index": 68, "section_index": 0, "paragraph_index": 78, "location": "section 1 · paragraph 79", "text": "촬영"}, {"block_index": 69, "section_index": 0, "paragraph_index": 79, "location": "section 1 · paragraph 80", "text": "❍ 계약체결 후 우리청이 지정한 기일 이내에 추진계획을 작성, 우리청에 제출하고 협의를 거쳐 촬영하여야 한다."}, {"block_index": 70, "section_index": 0, "paragraph_index": 80, "location": "section 1 · paragraph 81", "text": "❍ 영상미를 위하여 전문 시네마 촬영 조명팀과 CF, TV지상파 광고 제작 경험이 있는 촬영감독이 촬영하여야 한다."}, {"block_index": 71, "section_index": 0, "paragraph_index": 81, "location": "section 1 · paragraph 82", "text": "❍ 여름, 가을의 느낌이 고루 들어가도록 계절감을 살려 촬영하여야 한다."}, {"block_index": 72, "section_index": 0, "paragraph_index": 82, "location": "section 1 · paragraph 83", "text": "❍ 촬영지는 반드시 연출, 촬영감독, 미술감독이 동행하여 사전답사하고 시설 사용 관련 예약 및 촬영 동의, 초상권 사용 동의를 과업수행업체가 직접 받아야 한다."}, {"block_index": 73, "section_index": 0, "paragraph_index": 83, "location": "section 1 · paragraph 84", "text": "❍ 미술팀을 두어 시나리오에 맞는 촬영 현장 구성 및 소품을 준비하여야 한다."}, {"block_index": 74, "section_index": 0, "paragraph_index": 84, "location": "section 1 · paragraph 85", "text": "❍ 촬영지의 가구나 조형물 등 원래의 위치나 모양을 변경(또는 이동)한 경우 과업수행업체는 원상태로 복구하고 깔끔히 정리하여야 한다."}, {"block_index": 75, "section_index": 0, "paragraph_index": 85, "location": "section 1 · paragraph 86", "text": "❍ 촬영에 필요한 소품, 의상 등은 과업수행업체가 직접 준비하여야 한다."}, {"block_index": 76, "section_index": 0, "paragraph_index": 86, "location": "section 1 · paragraph 87", "text": "❍ 영상물의 제작은 신규 촬영자료 사용을 원칙으로 하며, 불가피하게 기존 자료를 사용할 경우 우리청과 협의하여야 한다."}, {"block_index": 77, "section_index": 0, "paragraph_index": 87, "location": "section 1 · paragraph 88", "text": "❍ 촬영 내용은 현장미팅으로 우리청의 승인을 받아야 한다."}, {"block_index": 78, "section_index": 0, "paragraph_index": 88, "location": "section 1 · paragraph 89", "text": "❍ 영상 촬영은 항공(드론) 촬영을 포함하여야 한다."}, {"block_index": 79, "section_index": 0, "paragraph_index": 89, "location": "section 1 · paragraph 90", "text": "❍ 촬영 진행 중 촬영결과물 관련 우리청 담당자와 검토하고, 그 결과가 만족스럽지 못할 경우 촬영방향 수정 및 촬영보강을 하여야 한다."}, {"block_index": 80, "section_index": 0, "paragraph_index": 90, "location": "section 1 · paragraph 91", "text": "녹음"}, {"block_index": 81, "section_index": 0, "paragraph_index": 91, "location": "section 1 · paragraph 92", "text": "❍ 녹음은 공중파방송국 아나운서 또는 한국성우협회에 등록된 A급 이상의 성우에게 의뢰하여 최상의 음질을 유지하고 동영상 전반의 더빙작업은 전문 녹음실에서 녹음하여야 한다."}, {"block_index": 82, "section_index": 0, "paragraph_index": 92, "location": "section 1 · paragraph 93", "text": "❍ 녹음 완료 후라도 우리청의 요청으로 시나리오가 변경될 경우 재녹음하여야 한다."}, {"block_index": 83, "section_index": 0, "paragraph_index": 93, "location": "section 1 · paragraph 94", "text": "자막 및 화면색조, 배경음악"}, {"block_index": 84, "section_index": 0, "paragraph_index": 94, "location": "section 1 · paragraph 95", "text": "❍ 영상 후반작업 시 DI 색보정을 반드시 전문가를 선정하여 진행해야 하며, 전문가 작업에 따른 시네마틱한 영상미를 연출하여야 한다."}, {"block_index": 85, "section_index": 0, "paragraph_index": 95, "location": "section 1 · paragraph 96", "text": "❍ 자막의 활자체 크기와 화면 색조, 화면구성, 배경음악 등에 관하여 우리청에서 수정․보완 요구시 성실히 응해야 하며, 배경음악 및 글씨체 등의 사용은 저작권료를 지급하는 등 적법한 절차를 거쳐야 한다."}, {"block_index": 86, "section_index": 0, "paragraph_index": 96, "location": "section 1 · paragraph 97", "text": "작품 제작"}, {"block_index": 87, "section_index": 0, "paragraph_index": 97, "location": "section 1 · paragraph 98", "text": "❍ 미비사항 발생 시에는 용역업체의 부담으로 수정․보완하고, 약간의 변경 자료에 대하여는 업그레이드 할 수 있도록 한다."}, {"block_index": 88, "section_index": 0, "paragraph_index": 98, "location": "section 1 · paragraph 99", "text": "❍ 최상의 영상편집 장비 등을 사용하여 컴퓨터그래픽(3D 등), 영상합성 등 최첨단 기법과 양질의 제품을 사용하여 최상의 음․화질을 표현하여야 한다."}, {"block_index": 89, "section_index": 0, "paragraph_index": 99, "location": "section 1 · paragraph 100", "text": "❍ 과업수행 시 적용되는 기술 또는 정보가 특허 등에 의해 성과물의 배포나 사용에 제한되지 않도록 하여야 한다."}, {"block_index": 90, "section_index": 0, "paragraph_index": 100, "location": "section 1 · paragraph 101", "text": "❍ 제작 과정 중 변동사항은 우리청과 협의하여 내용을 변경하고 우리청의 지시에 따라야 한다."}, {"block_index": 91, "section_index": 0, "paragraph_index": 101, "location": "section 1 · paragraph 102", "text": "❍ 납품 검사 시 원색이 선명하지 않거나 음향이 고르지 않는 등의 하자가 있을 경우 수정‧납품해야 한다."}, {"block_index": 92, "section_index": 0, "paragraph_index": 102, "location": "section 1 · paragraph 103", "text": "❍ 음원을 제작할 경우, 작사, 작곡, 편곡, 믹싱 등의 과정을 포함한다."}, {"block_index": 93, "section_index": 0, "paragraph_index": 103, "location": "section 1 · paragraph 104", "text": "번역 및 더빙, 수어 녹화"}, {"block_index": 94, "section_index": 0, "paragraph_index": 104, "location": "section 1 · paragraph 105", "text": "❍ 외국어본(영어)은 자막과 더빙작업을 실시한다."}, {"block_index": 95, "section_index": 0, "paragraph_index": 105, "location": "section 1 · paragraph 106", "text": "❍ 외국어 번역 및 더빙은 번역사 또는 번역능력을 인정할 만한 자로부터 번역․감수를 하여야 하며, 우리청과 협의하여 결정하여야 한다."}, {"block_index": 96, "section_index": 0, "paragraph_index": 106, "location": "section 1 · paragraph 107", "text": "❍ 외국어본은 번역 및 감수를 거쳐 오역이 없도록 편집․제작한다."}, {"block_index": 97, "section_index": 0, "paragraph_index": 107, "location": "section 1 · paragraph 108", "text": "※ 번역 영상물의 감수확인서(외국어 전문 번역업체 및 기관) 첨부"}, {"block_index": 98, "section_index": 0, "paragraph_index": 108, "location": "section 1 · paragraph 109", "text": "❍ 업체 번역본은 우리청 관계자가 재검수한다."}, {"block_index": 99, "section_index": 0, "paragraph_index": 109, "location": "section 1 · paragraph 110", "text": "영상물 납품"}, {"block_index": 100, "section_index": 0, "paragraph_index": 110, "location": "section 1 · paragraph 111", "text": "❍ 홍보물은 중간 및 최종 시사회를 2회 실시하여야 하며, 시사회를 거쳐 최종 합격 시 납품하여야 한다."}, {"block_index": 101, "section_index": 0, "paragraph_index": 111, "location": "section 1 · paragraph 112", "text": "❍ 성과품 납품 후 중대한 하자가 발견된 경우 과업수행업체는 성과품을 회수, 보완 후 다시 납품해야 한다."}, {"block_index": 102, "section_index": 0, "paragraph_index": 112, "location": "section 1 · paragraph 113", "text": "❍ 납품 이후 AS기간은 1년으로 한다."}, {"block_index": 103, "section_index": 0, "paragraph_index": 114, "location": "section 1 · paragraph 115", "text": "4"}, {"block_index": 104, "section_index": 0, "paragraph_index": 115, "location": "section 1 · paragraph 116", "text": "과업 수행 일반 지침"}, {"block_index": 105, "section_index": 0, "paragraph_index": 116, "location": "section 1 · paragraph 117", "text": "일반지침"}, {"block_index": 106, "section_index": 0, "paragraph_index": 117, "location": "section 1 · paragraph 118", "text": "❍ 과업수행업체는 제작에 사용된 모든 자료 및 음원에 대한 법률 검토를 납품 전에 완료해야 하며, 업체가 제공하는 원고 및 자료 중 타인의 지적재산권 등을 침해하여 분쟁이 발생한 경우 모든 책임은 제작업체가 진다. 그로 인한 우리청의 손해에 대하여는 우리청이 정하는 바에 따라 보상하여야 한다."}, {"block_index": 107, "section_index": 0, "paragraph_index": 118, "location": "section 1 · paragraph 119", "text": "❍ 본 과업에 있어서 하도급 행위를 불허한다."}, {"block_index": 108, "section_index": 0, "paragraph_index": 119, "location": "section 1 · paragraph 120", "text": "❍ 본 홍보영상을 제작함에 있어 타인이나 단체의 저작권 및 저작인접권 등 법에 의해 보호되는 모든 권리와 지적재산권, 초상권 등 권리를 침해하여 타인이나 단체로부터 우리청을 상대로 손해배상 청구 소송 등이 제기되면, 과업수행업체는 이에 대한 책임을 진다. 또한, 소송에서 우리청을 면책시켜야 하며, 피해자 측에 합의 배상하여야 하고 본 산출물의 수정, 보완 또는 재작업을 수행하여야 할 의무가 있다."}, {"block_index": 109, "section_index": 0, "paragraph_index": 120, "location": "section 1 · paragraph 121", "text": "❍ 과업수행업체는 착수보고, 중간보고 및 완료보고 등 기획 및 편집 작업 과정의 단계별로 주요 진행상황을 정기 보고하고, 수시로 우리청과 협의를 거쳐야 한다. 우리청의 기획 및 편집 방향에 부합될 때까지 보완한다."}, {"block_index": 110, "section_index": 0, "paragraph_index": 121, "location": "section 1 · paragraph 122", "text": "❍ 제안요청서 및 과업지시서에 명기되지 않은 사항이라도 본 과업의 목적달성에 필요한 사항은 우리청과 협의하여 결정한다."}, {"block_index": 111, "section_index": 0, "paragraph_index": 122, "location": "section 1 · paragraph 123", "text": "❍ 기타 필요한 사항은 우리청 담당자와 협의해야 한다."}, {"block_index": 112, "section_index": 0, "paragraph_index": 123, "location": "section 1 · paragraph 124", "text": "❍ 과업 수행상 특별한 사유가 없이 다음 상황이 발생할 경우에는 계약위반 행위로 간주하여 관계 규정에 의하여 계약을 해지할 수 있다."}, {"block_index": 113, "section_index": 0, "paragraph_index": 124, "location": "section 1 · paragraph 125", "text": "▸ 영상물 수준이 기획안에 비추어 현저히 낮다고 판단된 경우"}, {"block_index": 114, "section_index": 0, "paragraph_index": 125, "location": "section 1 · paragraph 126", "text": "▸ 사업내용이 과업목적 및 기본방향과 상이하다고 판단되는 경우"}, {"block_index": 115, "section_index": 0, "paragraph_index": 126, "location": "section 1 · paragraph 127", "text": "▸ 제반 지시사항을 기한 내 이행치 않았을 경우"}, {"block_index": 116, "section_index": 0, "paragraph_index": 127, "location": "section 1 · paragraph 128", "text": "▸ 계약기간 내 완료할 능력이 없거나 현저하게 공정이 미달된 경우"}, {"block_index": 117, "section_index": 0, "paragraph_index": 128, "location": "section 1 · paragraph 129", "text": "▸ 과업수행 중 불성실 또는 부주의로 인한 중대한 과실이 인정될 경우"}, {"block_index": 118, "section_index": 0, "paragraph_index": 129, "location": "section 1 · paragraph 130", "text": "▸ 과업참여 시 제출된 각종 증빙자료가 허위로 작성되었음이 인정될 경우"}, {"block_index": 119, "section_index": 0, "paragraph_index": 130, "location": "section 1 · paragraph 131", "text": "▸ 기타 계약위반 행위라고 볼 수 있는 객관적 판단이 있을 경우"}, {"block_index": 120, "section_index": 0, "paragraph_index": 131, "location": "section 1 · paragraph 132", "text": "▸ 위의 계약해지 사항에 해당할 경우 우리청은 과업수행업체에 대하여 일체의 용역대가를 지불하지 아니하며 기 지급분이 있을 경우 과업수행업체는 일체 반환조치 및 손해배상을 하여야 한다."}, {"block_index": 121, "section_index": 0, "paragraph_index": 132, "location": "section 1 · paragraph 133", "text": "❍ 과업수행 과정에서 과업수행업체의 고의, 과실, 부주의 등으로 인하여 발생한 일체의 손해는 과업사업수행업체 책임 및 부담으로 한다."}, {"block_index": 122, "section_index": 0, "paragraph_index": 133, "location": "section 1 · paragraph 134", "text": "❍ 과업수행 과정에서 발생하는 사업수행업체 인력의 제반 안전사고 책임 및 행정적, 기술적 제 비용과 문제처리는 사업수행업체 부담으로 한다."}, {"block_index": 123, "section_index": 0, "paragraph_index": 134, "location": "section 1 · paragraph 135", "text": "❍ 드론을 활용한 항공 촬영시, 관할 기관(항공청, 국방부 등)에 비행승인과 항공촬영 허가를 받아야 하며, 기체를 조종 및 촬영하는 자 또는 업체는 아래와 같은 조건을 반드시 충족하여야 한다."}, {"block_index": 124, "section_index": 0, "paragraph_index": 135, "location": "section 1 · paragraph 136", "text": "- 초경량비행장치 3종 이상의 자격증 보유, 드론사업자등록증 보유, 드론보험가입(대인 1.5억원, 대물 2천만원 이상), 관련 법률과 규정을 위반하지 않도록 사전에 조치하여야 하며, 이와 관련된 문제 발생시 과업수행업체가 모든 법적 책임(형사, 민사)을 진다."}, {"block_index": 125, "section_index": 0, "paragraph_index": 136, "location": "section 1 · paragraph 137", "text": "❍ 홍보영상의 내용 및 문체는 우리청과 협의하여 수정 및 확정하며 최종결과물이 납품될 때까지 지속해서 협의하여 결과를 반영하여야 한다."}, {"block_index": 126, "section_index": 0, "paragraph_index": 137, "location": "section 1 · paragraph 138", "text": "과업변경 및 용역기간의 연장"}, {"block_index": 127, "section_index": 0, "paragraph_index": 138, "location": "section 1 · paragraph 139", "text": "❍ 과업지시서에 누락된 사항이라도 과업 진행중에 발생되는 신규 요청사항에 대해 용역업체는 별도의 비용 없이 성실히 응하여야 한다."}, {"block_index": 128, "section_index": 0, "paragraph_index": 139, "location": "section 1 · paragraph 140", "text": "❍ 용역계약 후 과업지시서의 내용은 우리청의 업무사정에 따라 변경될 수 있으며, 수정 또는 추가 요구가 있을 경우, 우리청과 계약상대자가 협의하여 결정한다."}, {"block_index": 129, "section_index": 0, "paragraph_index": 140, "location": "section 1 · paragraph 141", "text": "❍ 용역기간은 우리청이 인정하는 특별한 사유발생 시 연장 할 수 있으나, 과업수행업체의 귀책사유로 정해진 기한 내에 과업을 완료하지 못할 경우에 업체는 지연배상금을 납부하여야 한다."}, {"block_index": 130, "section_index": 0, "paragraph_index": 141, "location": "section 1 · paragraph 142", "text": "과업수행 성과물"}, {"block_index": 131, "section_index": 0, "paragraph_index": 142, "location": "section 1 · paragraph 143", "text": "❍ 최종성과물은 우리청의 검사를 받아야 하며, 이에 필요한 자료제출 및 보충 설명서 등의 요구가 있는 경우에는 이에 응하여야 한다. 또한 용역의 성과물이 과업지시서의 내용과 상이하거나 미흡하여 우리청의 보완 요구가 있는 경우, 이에 응하여야 한다."}, {"block_index": 132, "section_index": 0, "paragraph_index": 143, "location": "section 1 · paragraph 144", "text": "❍ 최종성과물 귀속"}, {"block_index": 133, "section_index": 0, "paragraph_index": 144, "location": "section 1 · paragraph 145", "text": "▸ 본 영상물의 저작권은 우리청과 과업수행업체에 공동으로 귀속되며, 소유권, 사용권 등 모든 판권은 우리청에 귀속된다."}, {"block_index": 134, "section_index": 0, "paragraph_index": 145, "location": "section 1 · paragraph 146", "text": "▸ 본 용역과 관련하여 과업 수행과정에서 취득 또는 작성되는 산출물은 과업 수행완료 즉시 제출하여야 한다."}, {"block_index": 135, "section_index": 0, "paragraph_index": 146, "location": "section 1 · paragraph 147", "text": "▸ 본 용역과 관련하여 입수된 자료와 산출물은 우리청의 승인 없이 제3자에게 제공하거나 과업목적 외에는 사용할 수 없다."}, {"block_index": 136, "section_index": 0, "paragraph_index": 147, "location": "section 1 · paragraph 148", "text": "재용역의 실시"}, {"block_index": 137, "section_index": 0, "paragraph_index": 148, "location": "section 1 · paragraph 149", "text": "❍ 계약업체의 과업 시행 도중, 성과품의 품질이 견적에 의거 현저하게 떨어지는 경우, 또는 하자가 발생하거나 이상이 있는 경우, 우리청에서 계약업체의 과업 진행상황을 중지시키거나 납품을 거절할 수 있으며, 이후 계약업체는 과업결과물을 최대한 수정, 보완하여 재시행하며 수정 시 발생되는 비용은 업체에서 부담한다."}, {"block_index": 138, "section_index": 0, "paragraph_index": 149, "location": "section 1 · paragraph 150", "text": "❍ 과업수행 중 현재의 작업진행 수준으로 과업완료가 어렵다고 판단될 경우 우리청은 용역업체에게 원활한 과업수행을 위해 적합한 자격을 갖춘 다른 인원 교체를 요구할 수 있으며, 최종성과물 검사 시 본 용역의 성과물에 이상이 있는 경우 과업이 종료되지 않고 재용역을 실시하여야 한다."}, {"block_index": 139, "section_index": 0, "paragraph_index": 150, "location": "section 1 · paragraph 151", "text": "비밀의 준수"}, {"block_index": 140, "section_index": 0, "paragraph_index": 151, "location": "section 1 · paragraph 152", "text": "❍ 과업수행업체는 본 계약기간 전․후를 막론하고 본 용역과 관련하여 취득한 사항을 제3자에게 누설해서는 안되며, 우리청이 요구하는 보안사항을 철저히 준수하여야 한다. 이의 위반으로 인한 보안사고 발생 시에는 모든 민․형사상의 책임을 진다."}, {"block_index": 141, "section_index": 0, "paragraph_index": 153, "location": "section 1 · paragraph 154", "text": "4"}, {"block_index": 142, "section_index": 0, "paragraph_index": 154, "location": "section 1 · paragraph 155", "text": "일정별 보고사항"}, {"block_index": 143, "section_index": 0, "paragraph_index": 156, "location": "section 1 · paragraph 157", "text": "구분"}, {"block_index": 144, "section_index": 0, "paragraph_index": 157, "location": "section 1 · paragraph 158", "text": "내 용"}, {"block_index": 145, "section_index": 0, "paragraph_index": 158, "location": "section 1 · paragraph 159", "text": "제출시기"}, {"block_index": 146, "section_index": 0, "paragraph_index": 159, "location": "section 1 · paragraph 160", "text": "비고"}, {"block_index": 147, "section_index": 0, "paragraph_index": 160, "location": "section 1 · paragraph 161", "text": "착수보고"}, {"block_index": 148, "section_index": 0, "paragraph_index": 161, "location": "section 1 · paragraph 162", "text": "· 제작계획서 보고"}, {"block_index": 149, "section_index": 0, "paragraph_index": 162, "location": "section 1 · paragraph 163", "text": "· 사업수행 일정 예정 진행표"}, {"block_index": 150, "section_index": 0, "paragraph_index": 163, "location": "section 1 · paragraph 164", "text": "· 용역 대표자, 총괄 책임자(이력서, 재직증명서)"}, {"block_index": 151, "section_index": 0, "paragraph_index": 164, "location": "section 1 · paragraph 165", "text": "· 분야별 기술진 현황(이력서)"}, {"block_index": 152, "section_index": 0, "paragraph_index": 165, "location": "section 1 · paragraph 166", "text": "· 보안각서"}, {"block_index": 153, "section_index": 0, "paragraph_index": 166, "location": "section 1 · paragraph 167", "text": "· 수행조직, 인원 구성 및 분야별 인력투입계획"}, {"block_index": 154, "section_index": 0, "paragraph_index": 167, "location": "section 1 · paragraph 168", "text": "· 부분별 수행 방법"}, {"block_index": 155, "section_index": 0, "paragraph_index": 168, "location": "section 1 · paragraph 169", "text": "계약 후"}, {"block_index": 156, "section_index": 0, "paragraph_index": 169, "location": "section 1 · paragraph 170", "text": "5일 이내"}, {"block_index": 157, "section_index": 0, "paragraph_index": 170, "location": "section 1 · paragraph 171", "text": "시나리오"}, {"block_index": 158, "section_index": 0, "paragraph_index": 171, "location": "section 1 · paragraph 172", "text": "보고"}, {"block_index": 159, "section_index": 0, "paragraph_index": 172, "location": "section 1 · paragraph 173", "text": "· 교육청 요구 반영"}, {"block_index": 160, "section_index": 0, "paragraph_index": 173, "location": "section 1 · paragraph 174", "text": "· 시나리오에 따른 스토리보드 작성"}, {"block_index": 161, "section_index": 0, "paragraph_index": 174, "location": "section 1 · paragraph 175", "text": "착수보고 후"}, {"block_index": 162, "section_index": 0, "paragraph_index": 175, "location": "section 1 · paragraph 176", "text": "7일 이내"}, {"block_index": 163, "section_index": 0, "paragraph_index": 176, "location": "section 1 · paragraph 177", "text": "중간보고"}, {"block_index": 164, "section_index": 0, "paragraph_index": 177, "location": "section 1 · paragraph 178", "text": "· 영상물 제작 추진 경과 및 향후계획 등"}, {"block_index": 165, "section_index": 0, "paragraph_index": 178, "location": "section 1 · paragraph 179", "text": "70% 진행 시"}, {"block_index": 166, "section_index": 0, "paragraph_index": 179, "location": "section 1 · paragraph 180", "text": "추후 협의"}, {"block_index": 16