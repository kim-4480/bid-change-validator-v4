[{"block_index": 0, "section_index": 0, "paragraph_index": 4, "location": "section 1 · paragraph 5", "text": "「2026년 남해군 고향사랑기금」영웅의 지팡이 과업 지시서"}, {"block_index": 1, "section_index": 0, "paragraph_index": 7, "location": "section 1 · paragraph 8", "text": "「2026년 남해군 고향사랑기금」"}, {"block_index": 2, "section_index": 0, "paragraph_index": 8, "location": "section 1 · paragraph 9", "text": "영웅의 지팡이 과업 지시서"}, {"block_index": 3, "section_index": 0, "paragraph_index": 17, "location": "section 1 · paragraph 18", "text": "2026. 10."}, {"block_index": 4, "section_index": 0, "paragraph_index": 23, "location": "section 1 · paragraph 24", "text": "남해군 복지정책과"}, {"block_index": 5, "section_index": 0, "paragraph_index": 25, "location": "section 1 · paragraph 26", "text": "남해군 복지정책과"}, {"block_index": 6, "section_index": 0, "paragraph_index": 29, "location": "section 1 · paragraph 30", "text": "「영웅의 지팡이」제작·납품 과업 지시서"}, {"block_index": 7, "section_index": 0, "paragraph_index": 30, "location": "section 1 · paragraph 31", "text": "「영웅의 지팡이」제작·납품 과업 지시서"}, {"block_index": 8, "section_index": 0, "paragraph_index": 31, "location": "section 1 · paragraph 32", "text": "Ⅰ과업개요"}, {"block_index": 9, "section_index": 0, "paragraph_index": 32, "location": "section 1 · paragraph 33", "text": "Ⅰ"}, {"block_index": 10, "section_index": 0, "paragraph_index": 34, "location": "section 1 · paragraph 35", "text": "과업개요"}, {"block_index": 11, "section_index": 0, "paragraph_index": 35, "location": "section 1 · paragraph 36", "text": "가. 과업명"}, {"block_index": 12, "section_index": 0, "paragraph_index": 36, "location": "section 1 · paragraph 37", "text": " 국가보훈대상자「영웅의 지팡이」제작·납품"}, {"block_index": 13, "section_index": 0, "paragraph_index": 37, "location": "section 1 · paragraph 38", "text": "나. 과업목적"}, {"block_index": 14, "section_index": 0, "paragraph_index": 38, "location": "section 1 · paragraph 39", "text": " 본 과업은 국가를 위해 헌신한 국가보훈대상자에게 감사와 존경의 마음을 전하고, 고령의 국가보훈대상자가 일상생활에서 안전하고 편리하게 사용할 수 있는 보행 보조용 지팡이를 제작·지원하는 것을 목적으로 한다."}, {"block_index": 15, "section_index": 0, "paragraph_index": 39, "location": "section 1 · paragraph 40", "text": "다. 제작수량"}, {"block_index": 16, "section_index": 0, "paragraph_index": 40, "location": "section 1 · paragraph 41", "text": " 영웅의 지팡이: 600개"}, {"block_index": 17, "section_index": 0, "paragraph_index": 41, "location": "section 1 · paragraph 42", "text": " 개 별 포 장: 600세트"}, {"block_index": 18, "section_index": 0, "paragraph_index": 43, "location": "section 1 · paragraph 44", "text": "라. 지급대상"}, {"block_index": 19, "section_index": 0, "paragraph_index": 44, "location": "section 1 · paragraph 45", "text": " 국가보훈대상자 신청자 597명으로 하며, 3세트는 예비용으로 제작"}, {"block_index": 20, "section_index": 0, "paragraph_index": 46, "location": "section 1 · paragraph 47", "text": "마. 사업비"}, {"block_index": 21, "section_index": 0, "paragraph_index": 47, "location": "section 1 · paragraph 48", "text": " 총사업비는 금 30,000,000원(금삼천만원) 이내로 한다."}, {"block_index": 22, "section_index": 0, "paragraph_index": 50, "location": "section 1 · paragraph 51", "text": "바. 과업기간 및 납품기한"}, {"block_index": 23, "section_index": 0, "paragraph_index": 51, "location": "section 1 · paragraph 52", "text": " 과업기간은 계약일로부터 납품 및 검수가 완료되는 날까지로 한다."}, {"block_index": 24, "section_index": 0, "paragraph_index": 52, "location": "section 1 · paragraph 53", "text": " 계약상대자는 계약일로부터 4주 이내에 납품을 완료하여야 한다."}, {"block_index": 25, "section_index": 0, "paragraph_index": 53, "location": "section 1 · paragraph 54", "text": " 납품은 2026년 10월 중 완료하는 것을 원칙으로 한다."}, {"block_index": 26, "section_index": 0, "paragraph_index": 54, "location": "section 1 · paragraph 55", "text": " 계약 체결일 등의 사유로 “계약일로부터 4주 이내”와 “2026년 10월 중 납품” 조건이 충돌하는 경우에는 발주기관과 협의하여 납품기한을 정한다."}, {"block_index": 27, "section_index": 0, "paragraph_index": 55, "location": "section 1 · paragraph 56", "text": " 구체적인 납품일시 및 반입 방법은 납품 전에 발주기관과 협의하여야 한다."}, {"block_index": 28, "section_index": 0, "paragraph_index": 57, "location": "section 1 · paragraph 58", "text": "사. 납품장소"}, {"block_index": 29, "section_index": 0, "paragraph_index": 58, "location": "section 1 · paragraph 59", "text": " 발주기관 지정장소"}, {"block_index": 30, "section_index": 0, "paragraph_index": 60, "location": "section 1 · paragraph 61", "text": "Ⅱ과업의 범위"}, {"block_index": 31, "section_index": 0, "paragraph_index": 61, "location": "section 1 · paragraph 62", "text": "Ⅱ"}, {"block_index": 32, "section_index": 0, "paragraph_index": 63, "location": "section 1 · paragraph 64", "text": "과업의 범위"}, {"block_index": 33, "section_index": 0, "paragraph_index": 64, "location": "section 1 · paragraph 65", "text": " 계약상대자가 수행하여야 할 과업의 범위는 다음과 같다."}, {"block_index": 34, "section_index": 0, "paragraph_index": 65, "location": "section 1 · paragraph 66", "text": "가. 카본 소재 높이조절식 일자형 지팡이 600개 제작 및 납품"}, {"block_index": 35, "section_index": 0, "paragraph_index": 66, "location": "section 1 · paragraph 67", "text": "나. 태극기 디자인 및 「영웅의 지팡이」 문구 지팡이 본체 인쇄"}, {"block_index": 36, "section_index": 0, "paragraph_index": 67, "location": "section 1 · paragraph 68", "text": "다. 고향사랑기부금 관련 필수 문구 본체 인쇄"}, {"block_index": 37, "section_index": 0, "paragraph_index": 68, "location": "section 1 · paragraph 69", "text": "라. 지팡이 읍·면별 수량 구분"}, {"block_index": 38, "section_index": 0, "paragraph_index": 69, "location": "section 1 · paragraph 70", "text": "마. 납품 장소까지의 운반·하차 및 지정 위치 적재"}, {"block_index": 39, "section_index": 0, "paragraph_index": 70, "location": "section 1 · paragraph 71", "text": "바. 읍·면별 납품내역서 제출"}, {"block_index": 40, "section_index": 0, "paragraph_index": 71, "location": "section 1 · paragraph 72", "text": "사. 검수 과정에서 발견된 불량품의 교환·보완"}, {"block_index": 41, "section_index": 0, "paragraph_index": 72, "location": "section 1 · paragraph 73", "text": " 대상자별 최종 매칭과 전달은 읍·면 담당자가 배부 과정에서 수행한다."}, {"block_index": 42, "section_index": 0, "paragraph_index": 73, "location": "section 1 · paragraph 74", "text": "Ⅲ지팡이 제작 규격"}, {"block_index": 43, "section_index": 0, "paragraph_index": 74, "location": "section 1 · paragraph 75", "text": "Ⅲ"}, {"block_index": 44, "section_index": 0, "paragraph_index": 76, "location": "section 1 · paragraph 77", "text": "지팡이 제작 규격"}, {"block_index": 45, "section_index": 0, "paragraph_index": 77, "location": "section 1 · paragraph 78", "text": "구분제작 규격❍ 제품 형태보행 보조형 일자형 높이조절식 지팡이❍ 본체 소재카본 소재를 기본으로 한 경량·고강도 소재❍ 제조기업국내기업 제품 또는 국내 생산 제품❍ 길이약 71~95cm범위에서 성인 신장에 맞게 조절 가능한 제품❍ 조절방식버튼식 또는 동등이상의 방식으로, 임의로 풀리거나 내려가지 않는 구조❍ 안전장치높이조절부 이중안전장치 적용, 고정 후 흔들림이 적을 것❍ 손잡이장시간 사용 시 손의 피로를 줄일 수 있는 인체공학적 형태❍ 손잡이 소재미끄럼 및 땀에 강하고 그립감이 우수한 소재❍ 지팡이 끝부분미끄럼방지 및 충격흡수가 가능한 고무팁 적용❍ 중량260±10g 정도의 경량 제품❍ 색상고급스럽고 무난한 색상❍ 디자인일상생활에서 부담 없이 사용할 수 있는 단정하고 품격 있는 디자인❍ 내구성반복적인 높이조절과 일상적인 보행 사용을 고려하여 내구성이 우수한 제품❍ 제품상태균열, 변형, 긁힘, 오염 ,인쇄 불량이 없는 신품"}, {"block_index": 46, "section_index": 0, "paragraph_index": 78, "location": "section 1 · paragraph 79", "text": "구분"}, {"block_index": 47, "section_index": 0, "paragraph_index": 79, "location": "section 1 · paragraph 80", "text": "제작 규격"}, {"block_index": 48, "section_index": 0, "paragraph_index": 80, "location": "section 1 · paragraph 81", "text": "❍ 제품 형태"}, {"block_index": 49, "section_index": 0, "paragraph_index": 81, "location": "section 1 · paragraph 82", "text": "보행 보조형 일자형 높이조절식 지팡이"}, {"block_index": 50, "section_index": 0, "paragraph_index": 82, "location": "section 1 · paragraph 83", "text": "❍ 본체 소재"}, {"block_index": 51, "section_index": 0, "paragraph_index": 83, "location": "section 1 · paragraph 84", "text": "카본 소재를 기본으로 한 경량·고강도 소재"}, {"block_index": 52, "section_index": 0, "paragraph_index": 84, "location": "section 1 · paragraph 85", "text": "❍ 제조기업"}, {"block_index": 53, "section_index": 0, "paragraph_index": 85, "location": "section 1 · paragraph 86", "text": "국내기업 제품 또는 국내 생산 제품"}, {"block_index": 54, "section_index": 0, "paragraph_index": 86, "location": "section 1 · paragraph 87", "text": "❍ 길이"}, {"block_index": 55, "section_index": 0, "paragraph_index": 87, "location": "section 1 · paragraph 88", "text": "약 71~95cm범위에서 성인 신장에 맞게 조절 가능한 제품"}, {"block_index": 56, "section_index": 0, "paragraph_index": 88, "location": "section 1 · paragraph 89", "text": "❍ 조절방식"}, {"block_index": 57, "section_index": 0, "paragraph_index": 89, "location": "section 1 · paragraph 90", "text": "버튼식 또는 동등이상의 방식으로, 임의로 풀리거나 내려가지 않는 구조"}, {"block_index": 58, "section_index": 0, "paragraph_index": 90, "location": "section 1 · paragraph 91", "text": "❍ 안전장치"}, {"block_index": 59, "section_index": 0, "paragraph_index": 91, "location": "section 1 · paragraph 92", "text": "높이조절부 이중안전장치 적용, 고정 후 흔들림이 적을 것"}, {"block_index": 60, "section_index": 0, "paragraph_index": 92, "location": "section 1 · paragraph 93", "text": "❍ 손잡이"}, {"block_index": 61, "section_index": 0, "paragraph_index": 93, "location": "section 1 · paragraph 94", "text": "장시간 사용 시 손의 피로를 줄일 수 있는 인체공학적 형태"}, {"block_index": 62, "section_index": 0, "paragraph_index": 94, "location": "section 1 · paragraph 95", "text": "❍ 손잡이 소재"}, {"block_index": 63, "section_index": 0, "paragraph_index": 95, "location": "section 1 · paragraph 96", "text": "미끄럼 및 땀에 강하고 그립감이 우수한 소재"}, {"block_index": 64, "section_index": 0, "paragraph_index": 96, "location": "section 1 · paragraph 97", "text": "❍ 지팡이 끝부분"}, {"block_index": 65, "section_index": 0, "paragraph_index": 97, "location": "section 1 · paragraph 98", "text": "미끄럼방지 및 충격흡수가 가능한 고무팁 적용"}, {"block_index": 66, "section_index": 0, "paragraph_index": 98, "location": "section 1 · paragraph 99", "text": "❍ 중량"}, {"block_index": 67, "section_index": 0, "paragraph_index": 99, "location": "section 1 · paragraph 100", "text": "260±10g 정도의 경량 제품"}, {"block_index": 68, "section_index": 0, "paragraph_index": 100, "location": "section 1 · paragraph 101", "text": "❍ 색상"}, {"block_index": 69, "section_index": 0, "paragraph_index": 101, "location": "section 1 · paragraph 102", "text": "고급스럽고 무난한 색상"}, {"block_index": 70, "section_index": 0, "paragraph_index": 102, "location": "section 1 · paragraph 103", "text": "❍ 디자인"}, {"block_index": 71, "section_index": 0, "paragraph_index": 103, "location": "section 1 · paragraph 104", "text": "일상생활에서 부담 없이 사용할 수 있는 단정하고 품격 있는 디자인"}, {"block_index": 72, "section_index": 0, "paragraph_index": 104, "location": "section 1 · paragraph 105", "text": "❍ 내구성"}, {"block_index": 73, "section_index": 0, "paragraph_index": 105, "location": "section 1 · paragraph 106", "text": "반복적인 높이조절과 일상적인 보행 사용을 고려하여 내구성이"}, {"block_index": 74, "section_index": 0, "paragraph_index": 106, "location": "section 1 · paragraph 107", "text": "우수한 제품"}, {"block_index": 75, "section_index": 0, "paragraph_index": 107, "location": "section 1 · paragraph 108", "text": "❍ 제품상태"}, {"block_index": 76, "section_index": 0, "paragraph_index": 108, "location": "section 1 · paragraph 109", "text": "균열, 변형, 긁힘, 오염 ,인쇄 불량이 없는 신품"}, {"block_index": 77, "section_index": 0, "paragraph_index": 109, "location": "section 1 · paragraph 110", "text": "Ⅳ디자인 및 필수 문구"}, {"block_index": 78, "section_index": 0, "paragraph_index": 110, "location": "section 1 · paragraph 111", "text": "Ⅳ"}, {"block_index": 79, "section_index": 0, "paragraph_index": 112, "location": "section 1 · paragraph 113", "text": "디자인 및 필수 문구"}, {"block_index": 80, "section_index": 0, "paragraph_index": 113, "location": "section 1 · paragraph 114", "text": "가. 태극기 디자인"}, {"block_index": 81, "section_index": 0, "paragraph_index": 114, "location": "section 1 · paragraph 115", "text": " 지팡이 상단 또는 손잡이 인근에 태극기 디자인을 적용한다."}, {"block_index": 82, "section_index": 0, "paragraph_index": 115, "location": "section 1 · paragraph 116", "text": " 태극기 디자인은 일상적인 보행 보조기구로서의 품격을 유지할 수 있도록 과도하게 크지 않게 제작한다."}, {"block_index": 83, "section_index": 0, "paragraph_index": 116, "location": "section 1 · paragraph 117", "text": " 태극기 디자인은 인쇄, 각인의 방법으로 표시하여 사용 중 쉽게 지워지거나 훼손되지 않도록 한다."}, {"block_index": 84, "section_index": 0, "paragraph_index": 117, "location": "section 1 · paragraph 118", "text": " 태극기의 위치, 크기 및 표시 방법은 제작 전에 발주기관의 확인을 받아야 한다."}, {"block_index": 85, "section_index": 0, "paragraph_index": 119, "location": "section 1 · paragraph 120", "text": "나. 사업명 표시"}, {"block_index": 86, "section_index": 0, "paragraph_index": 120, "location": "section 1 · paragraph 121", "text": " 지팡이 본체에 다음 문구를 인쇄한다."}, {"block_index": 87, "section_index": 0, "paragraph_index": 121, "location": "section 1 · paragraph 122", "text": "「영웅의 지팡이」"}, {"block_index": 88, "section_index": 0, "paragraph_index": 122, "location": "section 1 · paragraph 123", "text": " 글씨체, 크기, 색상 및 표시 위치는 가독성과 제품 디자인을 고려하여 발주기관과 협의하여 정한다."}, {"block_index": 89, "section_index": 0, "paragraph_index": 123, "location": "section 1 · paragraph 124", "text": " 사업명은 사용 중 쉽게 지워지거나 훼손되지 않는 방식으로 표시한다."}, {"block_index": 90, "section_index": 0, "paragraph_index": 125, "location": "section 1 · paragraph 126", "text": "다. 고향사랑기부금 필수 문구"}, {"block_index": 91, "section_index": 0, "paragraph_index": 126, "location": "section 1 · paragraph 127", "text": " 지팡이 본체에 다음 문구를 반드시 인쇄한다."}, {"block_index": 92, "section_index": 0, "paragraph_index": 127, "location": "section 1 · paragraph 128", "text": "「2026년도 남해군 고향사랑기부금으로 제작되었습니다.」"}, {"block_index": 93, "section_index": 0, "paragraph_index": 128, "location": "section 1 · paragraph 129", "text": " 필수 문구는 제품의 크기와 가독성을 고려하여 지팡이 본체에 직접 인쇄한다."}, {"block_index": 94, "section_index": 0, "paragraph_index": 129, "location": "section 1 · paragraph 130", "text": " 표시 방식은 통상적인 사용 과정에서 문구가 쉽게 지워지거나 훼손되지 않아야 한다."}, {"block_index": 95, "section_index": 0, "paragraph_index": 130, "location": "section 1 · paragraph 131", "text": " 계약상대자는 제작 전에 문구의 내용, 글씨체, 크기, 색상, 위치 및 표시 방식을 발주기관과 협의하여야 한다."}, {"block_index": 96, "section_index": 0, "paragraph_index": 132, "location": "section 1 · paragraph 133", "text": "Ⅴ견본 및 디자인 승인"}, {"block_index": 97, "section_index": 0, "paragraph_index": 133, "location": "section 1 · paragraph 134", "text": "Ⅴ"}, {"block_index": 98, "section_index": 0, "paragraph_index": 135, "location": "section 1 · paragraph 136", "text": "견본 및 디자인 승인"}, {"block_index": 99, "section_index": 0, "paragraph_index": 136, "location": "section 1 · paragraph 137", "text": "가. 사전 제출자료"}, {"block_index": 100, "section_index": 0, "paragraph_index": 137, "location": "section 1 · paragraph 138", "text": " 계약상대자는 본 제작에 착수하기 전에 다음 자료를 발주기관에 제출하여 확인받아야 한다."}, {"block_index": 101, "section_index": 0, "paragraph_index": 138, "location": "section 1 · paragraph 139", "text": "- 실제 제작 또는 납품 예정 제품의 견본 또는 제품 이미지"}, {"block_index": 102, "section_index": 0, "paragraph_index": 139, "location": "section 1 · paragraph 140", "text": "- 제조사 및 모델명"}, {"block_index": 103, "section_index": 0, "paragraph_index": 140, "location": "section 1 · paragraph 141", "text": "- 본체 소재 및 구성품"}, {"block_index": 104, "section_index": 0, "paragraph_index": 141, "location": "section 1 · paragraph 142", "text": "- 제품 길이 및 높이조절 범위"}, {"block_index": 105, "section_index": 0, "paragraph_index": 142, "location": "section 1 · paragraph 143", "text": "- 제품 중량 및 허용하중"}, {"block_index": 106, "section_index": 0, "paragraph_index": 143, "location": "section 1 · paragraph 144", "text": "- 높이조절 방식"}, {"block_index": 107, "section_index": 0, "paragraph_index": 144, "location": "section 1 · paragraph 145", "text": "- 손잡이 및 고무팁 규격"}, {"block_index": 108, "section_index": 0, "paragraph_index": 145, "location": "section 1 · paragraph 146", "text": "- 태극기, 사업명 및 필수 문구의 디자인 시안"}, {"block_index": 109, "section_index": 0, "paragraph_index": 146, "location": "section 1 · paragraph 147", "text": "- 개별 포장 방법과 포장 시안"}, {"block_index": 110, "section_index": 0, "paragraph_index": 147, "location": "section 1 · paragraph 148", "text": "- 품질보증 및 불량품 교환계획"}, {"block_index": 111, "section_index": 0, "paragraph_index": 148, "location": "section 1 · paragraph 149", "text": "- 그 밖에 발주기관이 제품 확인을 위해 요구하는 자료"}, {"block_index": 112, "section_index": 0, "paragraph_index": 150, "location": "section 1 · paragraph 151", "text": "나. 제작 착수"}, {"block_index": 113, "section_index": 0, "paragraph_index": 151, "location": "section 1 · paragraph 152", "text": " 계약상대자는 발주기관의 승인 없이 본 제작에 착수하여서는 안 된다."}, {"block_index": 114, "section_index": 0, "paragraph_index": 152, "location": "section 1 · paragraph 153", "text": " 발주기관의 확인 또는 승인은 계약상대자의 품질관리 책임과 계약상 의무를 면제하지 않는다."}, {"block_index": 115, "section_index": 0, "paragraph_index": 153, "location": "section 1 · paragraph 154", "text": " 승인된 견본, 상세규격 및 디자인은 계약내용의 일부로 보며, 실제 납품 제품은 승인된 내용과 동일하여야 한다."}, {"block_index": 116, "section_index": 0, "paragraph_index": 154, "location": "section 1 · paragraph 155", "text": " 승인 후 제품의 소재, 규격, 색상, 디자인 또는 표시 방법을 변경하려는 경우에는 사전에 발주기관의 서면 승인을 받아야 한다."}, {"block_index": 117, "section_index": 0, "paragraph_index": 157, "location": "section 1 · paragraph 158", "text": "Ⅵ포장 및 읍·면별 분류"}, {"block_index": 118, "section_index": 0, "paragraph_index": 158, "location": "section 1 · paragraph 159", "text": "Ⅵ"}, {"block_index": 119, "section_index": 0, "paragraph_index": 160, "location": "section 1 · paragraph 161", "text": "포장 및 읍·면별 분류"}, {"block_index": 120, "section_index": 0, "paragraph_index": 161, "location": "section 1 · paragraph 162", "text": "가. 지팡이 포장"}, {"block_index": 121, "section_index": 0, "paragraph_index": 162, "location": "section 1 · paragraph 163", "text": " 지팡이 600개는 제품의 파손과 오염을 방지할 수 있도록 각각 개별 포장한다."}, {"block_index": 122, "section_index": 0, "paragraph_index": 163, "location": "section 1 · paragraph 164", "text": " 지팡이는 모두 동일한 제품이므로 대상자 성명이나 관리번호를 표시 하지 않는다."}, {"block_index": 123, "section_index": 0, "paragraph_index": 164, "location": "section 1 · paragraph 165", "text": " 포장 외부에는 제품명과 구성품 등 필요한 사항만 표시한다."}, {"block_index": 124, "section_index": 0, "paragraph_index": 167, "location": "section 1 · paragraph 168", "text": "나. 읍·면별 납품 분류"}, {"block_index": 125, "section_index": 0, "paragraph_index": 168, "location": "section 1 · paragraph 169", "text": " 지팡이는 발주기관이 제공한 읍·면별 배부수량에 따라 구분하여 적재한다."}, {"block_index": 126, "section_index": 0, "paragraph_index": 169, "location": "section 1 · paragraph 170", "text": " 지팡이는 납품장소에서 읍·면별로 즉시 반출할 수 있는 상태로"}, {"block_index": 127, "section_index": 0, "paragraph_index": 170, "location": "section 1 · paragraph 171", "text": "정리한다."}, {"block_index": 128, "section_index": 0, "paragraph_index": 171, "location": "section 1 · paragraph 172", "text": " 계약상대자는 읍·면별 지팡이 수량을 기재한 납품 내역서를 제출한다."}]