ex": 1, "paragraph_index": 120, "location": "section 2 · paragraph 121", "text": "보통"}, {"block_index": 112, "section_index": 1, "paragraph_index": 121, "location": "section 2 · paragraph 122", "text": "미흡"}, {"block_index": 113, "section_index": 1, "paragraph_index": 122, "location": "section 2 · paragraph 123", "text": "부적합"}, {"block_index": 114, "section_index": 1, "paragraph_index": 123, "location": "section 2 · paragraph 124", "text": "15"}, {"block_index": 115, "section_index": 1, "paragraph_index": 124, "location": "section 2 · paragraph 125", "text": "10"}, {"block_index": 116, "section_index": 1, "paragraph_index": 125, "location": "section 2 · paragraph 126", "text": "5"}, {"block_index": 117, "section_index": 1, "paragraph_index": 126, "location": "section 2 · paragraph 127", "text": "0"}, {"block_index": 118, "section_index": 1, "paragraph_index": 127, "location": "section 2 · paragraph 128", "text": "15"}, {"block_index": 119, "section_index": 1, "paragraph_index": 128, "location": "section 2 · paragraph 129", "text": "10"}, {"block_index": 120, "section_index": 1, "paragraph_index": 129, "location": "section 2 · paragraph 130", "text": "5"}, {"block_index": 121, "section_index": 1, "paragraph_index": 130, "location": "section 2 · paragraph 131", "text": "0"}, {"block_index": 122, "section_index": 1, "paragraph_index": 131, "location": "section 2 · paragraph 132", "text": "장애대책"}, {"block_index": 123, "section_index": 1, "paragraph_index": 132, "location": "section 2 · paragraph 133", "text": "(15점)"}, {"block_index": 124, "section_index": 1, "paragraph_index": 133, "location": "section 2 · paragraph 134", "text": "15"}, {"block_index": 125, "section_index": 1, "paragraph_index": 134, "location": "section 2 · paragraph 135", "text": "o 장애대응 전략의 적정성"}, {"block_index": 126, "section_index": 1, "paragraph_index": 135, "location": "section 2 · paragraph 136", "text": "o 하자담보책임기간 내 정기/수시 점검 계획"}, {"block_index": 127, "section_index": 1, "paragraph_index": 137, "location": "section 2 · paragraph 138", "text": "적합"}, {"block_index": 128, "section_index": 1, "paragraph_index": 138, "location": "section 2 · paragraph 139", "text": "보통"}, {"block_index": 129, "section_index": 1, "paragraph_index": 139, "location": "section 2 · paragraph 140", "text": "미흡"}, {"block_index": 130, "section_index": 1, "paragraph_index": 140, "location": "section 2 · paragraph 141", "text": "부적합"}, {"block_index": 131, "section_index": 1, "paragraph_index": 141, "location": "section 2 · paragraph 142", "text": "15"}, {"block_index": 132, "section_index": 1, "paragraph_index": 142, "location": "section 2 · paragraph 143", "text": "10"}, {"block_index": 133, "section_index": 1, "paragraph_index": 143, "location": "section 2 · paragraph 144", "text": "5"}, {"block_index": 134, "section_index": 1, "paragraph_index": 144, "location": "section 2 · paragraph 145", "text": "0"}, {"block_index": 135, "section_index": 1, "paragraph_index": 145, "location": "section 2 · paragraph 146", "text": "15"}, {"block_index": 136, "section_index": 1, "paragraph_index": 146, "location": "section 2 · paragraph 147", "text": "10"}, {"block_index": 137, "section_index": 1, "paragraph_index": 147, "location": "section 2 · paragraph 148", "text": "5"}, {"block_index": 138, "section_index": 1, "paragraph_index": 148, "location": "section 2 · paragraph 149", "text": "0"}, {"block_index": 139, "section_index": 1, "paragraph_index": 149, "location": "section 2 · paragraph 150", "text": "기 타 필요사항"}, {"block_index": 140, "section_index": 1, "paragraph_index": 150, "location": "section 2 · paragraph 151", "text": "(25점)"}, {"block_index": 141, "section_index": 1, "paragraph_index": 151, "location": "section 2 · paragraph 152", "text": "교육지원"}, {"block_index": 142, "section_index": 1, "paragraph_index": 152, "location": "section 2 · paragraph 153", "text": "(15점)"}, {"block_index": 143, "section_index": 1, "paragraph_index": 153, "location": "section 2 · paragraph 154", "text": "15"}, {"block_index": 144, "section_index": 1, "paragraph_index": 154, "location": "section 2 · paragraph 155", "text": "o 교육 방법, 내용, 충실도"}, {"block_index": 145, "section_index": 1, "paragraph_index": 156, "location": "section 2 · paragraph 157", "text": "적합"}, {"block_index": 146, "section_index": 1, "paragraph_index": 157, "location": "section 2 · paragraph 158", "text": "보통"}, {"block_index": 147, "section_index": 1, "paragraph_index": 158, "location": "section 2 · paragraph 159", "text": "미흡"}, {"block_index": 148, "section_index": 1, "paragraph_index": 159, "location": "section 2 · paragraph 160", "text": "부적합"}, {"block_index": 149, "section_index": 1, "paragraph_index": 160, "location": "section 2 · paragraph 161", "text": "15"}, {"block_index": 150, "section_index": 1, "paragraph_index": 161, "location": "section 2 · paragraph 162", "text": "10"}, {"block_index": 151, "section_index": 1, "paragraph_index": 162, "location": "section 2 · paragraph 163", "text": "5"}, {"block_index": 152, "section_index": 1, "paragraph_index": 163, "location": "section 2 · paragraph 164", "text": "0"}, {"block_index": 153, "section_index": 1, "paragraph_index": 164, "location": "section 2 · paragraph 165", "text": "15"}, {"block_index": 154, "section_index": 1, "paragraph_index": 165, "location": "section 2 · paragraph 166", "text": "10"}, {"block_index": 155, "section_index": 1, "paragraph_index": 166, "location": "section 2 · paragraph 167", "text": "5"}, {"block_index": 156, "section_index": 1, "paragraph_index": 167, "location": "section 2 · paragraph 168", "text": "0"}, {"block_index": 157, "section_index": 1, "paragraph_index": 168, "location": "section 2 · paragraph 169", "text": "계약이행 성실도"}, {"block_index": 158, "section_index": 1, "paragraph_index": 169, "location": "section 2 · paragraph 170", "text": "(10점)"}, {"block_index": 159, "section_index": 1, "paragraph_index": 170, "location": "section 2 · paragraph 171", "text": "10"}, {"block_index": 160, "section_index": 1, "paragraph_index": 171, "location": "section 2 · paragraph 172", "text": "o 입찰 공고일 기준 최근 3년 이내 첨단정보통신융합산업기술원에 납품 지연 내역"}, {"block_index": 161, "section_index": 1, "paragraph_index": 172, "location": "section 2 · paragraph 173", "text": "① 없음"}, {"block_index": 162, "section_index": 1, "paragraph_index": 173, "location": "section 2 · paragraph 174", "text": "② 있음"}, {"block_index": 163, "section_index": 1, "paragraph_index": 174, "location": "section 2 · paragraph 175", "text": "10"}, {"block_index": 164, "section_index": 1, "paragraph_index": 175, "location": "section 2 · paragraph 176", "text": "0"}, {"block_index": 165, "section_index": 1, "paragraph_index": 176, "location": "section 2 · paragraph 177", "text": "합 계"}, {"block_index": 166, "section_index": 1, "paragraph_index": 177, "location": "section 2 · paragraph 178", "text": "100"}, {"block_index": 167, "section_index": 1, "paragraph_index": 179, "location": "section 2 · paragraph 180", "text": "Ⅳ"}, {"block_index": 168, "section_index": 1, "paragraph_index": 180, "location": "section 2 · paragraph 181", "text": "제안서 작성 일반지침"}, {"block_index": 169, "section_index": 1, "paragraph_index": 181, "location": "section 2 · paragraph 182", "text": "1. 제안서의 효력"}, {"block_index": 170, "section_index": 1, "paragraph_index": 182, "location": "section 2 · paragraph 183", "text": "1) 수요기관의 필요에 따라 제안 업체에게 추가 제안 또는 자료를 요청할 수 있으며, 이에 따라 제출된 자료는 제안서와 동일한 효력을 가진다."}, {"block_index": 171, "section_index": 1, "paragraph_index": 183, "location": "section 2 · paragraph 184", "text": "2) 제안서에 제시된 내용과 수요기관의 요구에 의해 수정, 보완, 변경된 제안 내용은 계약서에 명시하지 않더라도 계약서와 동일한 효력을 가진다. 단, 계약서에 명시된 경우는 계약서가 우선한다."}, {"block_index": 172, "section_index": 1, "paragraph_index": 184, "location": "section 2 · paragraph 185", "text": "2. 제안서 작성 시 유의사항"}, {"block_index": 173, "section_index": 1, "paragraph_index": 185, "location": "section 2 · paragraph 186", "text": "1) 제안서의 규격은 단면 A4용지 세로 방향을 기본으로 정한다."}, {"block_index": 174, "section_index": 1, "paragraph_index": 186, "location": "section 2 · paragraph 187", "text": "2) 제안서는 한글 작성이 원칙이며, 사용된 영문 약어에 대하여는 약어표를 제공해야 한다."}, {"block_index": 175, "section_index": 1, "paragraph_index": 187, "location": "section 2 · paragraph 188", "text": "3) 제안서의 각 페이지는 쉽게 참조할 수 있도록 페이지 하단 중앙에 일련 번호를 붙이되, 각 장별로 번호를 부여한다."}, {"block_index": 176, "section_index": 1, "paragraph_index": 188, "location": "section 2 · paragraph 189", "text": "4) 제안서의 구성 및 목차는 제안서 작성지침의 순서 및 목차에 의해 작성하여야 하며, 증빙과 관련된 자료는 본문에 표기 및 붙임으로 첨부해야 한다."}, {"block_index": 177, "section_index": 1, "paragraph_index": 189, "location": "section 2 · paragraph 190", "text": "5) 작성지침에 명시되지 않은 내용에 대한 추가적인 제안사항이 있는 경우 해당항목에 포함 또는 별도의 항목을 추가하여 작성할 수 있다."}, {"block_index": 178, "section_index": 1, "paragraph_index": 190, "location": "section 2 · paragraph 191", "text": "6) 제안서의 내용은 명확한 용어를 사용하여 표현하여야 한다. “~이 가능하다.”, “할 수 있다.”, “고려하고 있다.” 등과 같이 모호한 표현은 불가능한 것으로 간주하며, 수치를 계량화할 수 있는 항목은 계량화하여 작성해야 한다."}, {"block_index": 179, "section_index": 1, "paragraph_index": 191, "location": "section 2 · paragraph 192", "text": "7) 제안서의 모든 내용은 객관적으로 입증할 수 있어야 하며, 그 내용이 허위로 확인되거나 입증요구에 대해 명확한 입증을 하지 못하는 경우는 평가대상에서 제외되며, 계약 후에도 계약 해지와 함께 인적·물적·기간적 손실에 대한 손해배상책임을 져야 한다."}, {"block_index": 180, "section_index": 1, "paragraph_index": 192, "location": "section 2 · paragraph 193", "text": "8) 제안내용을 보충하기 위하여 참고문헌을 활용하는 경우 참고문헌 목록을 첨부하고, 그 출처를 정확히 알 수 있도록 표기해야 한다."}, {"block_index": 181, "section_index": 1, "paragraph_index": 193, "location": "section 2 · paragraph 194", "text": "9) 제안과 관련되어 제출된 자료 일체는 반환하지 않으며, 본 제안과 관련된 일체의 소요비용은 제안업체가 부담한다."}, {"block_index": 182, "section_index": 1, "paragraph_index": 194, "location": "section 2 · paragraph 195", "text": "10) 본 제안서의 결과에 의한 일체의 계약은 국가를 당사자로 하는 계약에 관한 법률 등 관련 법규를 준수해야 한다."}, {"block_index": 183, "section_index": 1, "paragraph_index": 195, "location": "section 2 · paragraph 196", "text": "11) 제안업체는 동 사업과 관련하여 취급 또는 습득한 정보를 유출하지 않아야 하며, 보안에 관련된 사항을 준수하고 보안 사고에 대한 민․형사상의 모든 책임을 져야 한다."}, {"block_index": 184, "section_index": 1, "paragraph_index": 196, "location": "section 2 · paragraph 197", "text": "12) 제시된 규격과 동등하거나 이상으로 제안하여야 하며 제안서는 수요기관의 요청이 있는 경우를 제외하고 수정·보완 등 추가 대체할 수 없다."}, {"block_index": 185, "section_index": 1, "paragraph_index": 197, "location": "section 2 · paragraph 198", "text": "13) 제안하는 물품이 수요기관에서 요구하는 규격 및 기술에 적합한지 명확하게 확인할 수 있도록, 규격서에 기재된 성능 및 규격 부분의 각 항목에 대한 검증 자료를 제출해야 한다."}, {"block_index": 186, "section_index": 1, "paragraph_index": 198, "location": "section 2 · paragraph 199", "text": "14) 제안하는 물품이 판매 중인 기성품인 경우, 장비 제조사에서 공식적으로 사용하는 카달로그(물품의 정확한 스펙 기재되어 있을 것)와 제안 물품의 실사 이미지, 사용 방법, 활용사례, 안전 관련 인증서, 시험 성적서 등 규격서의 규격 및 제안 물품에 대한 검증 자료를 제출해야 한다."}, {"block_index": 187, "section_index": 1, "paragraph_index": 199, "location": "section 2 · paragraph 200", "text": "15) 제안하고자하는 물품이 제작품인 경우, 제안 물품에 대한 안정성과 성능을 입증할 수 있도록 완성품(기존에 제작한 물품 중 규격서의 규격 동등이상인 물품)에 대한 객관적인 자료(납품 및 설치실적, 기술 인증서, 안전 관련 인증서, 성능검사서, 시험 성적서 등)를 제출해야 한다."}, {"block_index": 188, "section_index": 1, "paragraph_index": 200, "location": "section 2 · paragraph 201", "text": "3. 작성 일반지침"}, {"block_index": 189, "section_index": 1, "paragraph_index": 201, "location": "section 2 · paragraph 202", "text": "1) 제출기한 및 장소 : 입찰공고문 참조"}, {"block_index": 190, "section_index": 1, "paragraph_index": 202, "location": "section 2 · paragraph 203", "text": "2) 제출서류"}, {"block_index": 191, "section_index": 1, "paragraph_index": 203, "location": "section 2 · paragraph 204", "text": "- 제안서 : 나라장터를 통한 온라인 제출(PDF 파일로 제출)"}, {"block_index": 192, "section_index": 1, "paragraph_index": 204, "location": "section 2 · paragraph 205", "text": "- 제출자료 : 제안서 PDF 1부(300MB 초과 시 업로드 불가)\n※ 제출된 서류는 회수 및 수정이 불가"}, {"block_index": 193, "section_index": 1, "paragraph_index": 205, "location": "section 2 · paragraph 206", "text": "3) 제출방법 : 입찰공고문 참조"}, {"block_index": 194, "section_index": 1, "paragraph_index": 206, "location": "section 2 · paragraph 207", "text": "3. 제안서 구성내용 및 작성 방법"}, {"block_index": 195, "section_index": 1, "paragraph_index": 207, "location": "section 2 · paragraph 208", "text": "1) 제안서 구성내용"}, {"block_index": 196, "section_index": 1, "paragraph_index": 208, "location": "section 2 · paragraph 209", "text": "- 제안서 구성내용은 지정된 순서나 양식을 준수하여 작성하되 해당 내용이 없을 경우 “해당사항 없음”으로 간략히 기술함"}, {"block_index": 197, "section_index": 1, "paragraph_index": 210, "location": "section 2 · paragraph 211", "text": "작 성 항 목"}, {"block_index": 198, "section_index": 1, "paragraph_index": 211, "location": "section 2 · paragraph 212", "text": "작 성 내 용"}, {"block_index": 199, "section_index": 1, "paragraph_index": 212, "location": "section 2 · paragraph 213", "text": "비고"}, {"block_index": 200, "section_index": 1, "paragraph_index": 213, "location": "section 2 · paragraph 214", "text": "Ⅰ. 일반부문"}, {"block_index": 201, "section_index": 1, "paragraph_index": 214, "location": "section 2 · paragraph 215", "text": "1. 일반현황"}, {"block_index": 202, "section_index": 1, "paragraph_index": 215, "location": "section 2 · paragraph 216", "text": "제안사의 일반 현황, 주요 연혁, 주요 사업 분야"}, {"block_index": 203, "section_index": 1, "paragraph_index": 216, "location": "section 2 · paragraph 217", "text": "서식 2"}, {"block_index": 204, "section_index": 1, "paragraph_index": 217, "location": "section 2 · paragraph 218", "text": "사업수행 조직 체계 및 인원 현황 제시"}, {"block_index": 205, "section_index": 1, "paragraph_index": 218, "location": "section 2 · paragraph 219", "text": "Ⅱ. 기술부문"}, {"block_index": 206, "section_index": 1, "paragraph_index": 219, "location": "section 2 · paragraph 220", "text": "1. 규격적합여부"}, {"block_index": 207, "section_index": 1, "paragraph_index": 220, "location": "section 2 · paragraph 221", "text": "제안 물품과 공고 규격의 비교 및 적합 여부 확인"}, {"block_index": 208, "section_index": 1, "paragraph_index": 221, "location": "section 2 · paragraph 222", "text": "서식 3"}, {"block_index": 209, "section_index": 1, "paragraph_index": 222, "location": "section 2 · paragraph 223", "text": "2. 장비현황"}, {"block_index": 210, "section_index": 1, "paragraph_index": 223, "location": "section 2 · paragraph 224", "text": "제안 물품의 스펙 소개"}, {"block_index": 211, "section_index": 1, "paragraph_index": 224, "location": "section 2 · paragraph 225", "text": "공고규격 각 항목에 대한 기술 검증 자료(카달로그 등 증빙자료 첨부)"}, {"block_index": 212, "section_index": 1, "paragraph_index": 225, "location": "section 2 · paragraph 226", "text": "운용 방법 및 구성"}, {"block_index": 213, "section_index": 1, "paragraph_index": 226, "location": "section 2 · paragraph 227", "text": "물품의 성능 및 활용방안"}, {"block_index": 214, "section_index": 1, "paragraph_index": 227, "location": "section 2 · paragraph 228", "text": "Ⅲ. 관리부문"}, {"block_index": 215, "section_index": 1, "paragraph_index": 228, "location": "section 2 · paragraph 229", "text": "1. 납품계획"}, {"block_index": 216, "section_index": 1, "paragraph_index": 229, "location": "section 2 · paragraph 230", "text": "납품 계획 및 일정 제시"}, {"block_index": 217, "section_index": 1, "paragraph_index": 230, "location": "section 2 · paragraph 231", "text": "2. 설치일정 및 계획"}, {"block_index": 218, "section_index": 1, "paragraph_index": 231, "location": "section 2 · paragraph 232", "text": "설치 및 시험 운영 계획(일정 및 방법)"}, {"block_index": 219, "section_index": 1, "paragraph_index": 232, "location": "section 2 · paragraph 233", "text": "검수(설치 완료 검증) 방법 및 일정 제시"}, {"block_index": 220, "section_index": 1, "paragraph_index": 233, "location": "section 2 · paragraph 234", "text": "3. 품질보증계획"}, {"block_index": 221, "section_index": 1, "paragraph_index": 234, "location": "section 2 · paragraph 235", "text": "품질 유지 및 관리를 위한 계획 및 방법 제시"}, {"block_index": 222, "section_index": 1, "paragraph_index": 235, "location": "section 2 · paragraph 236", "text": "사후관리 전략(부품수급 방법 및 기술지원 방안)"}, {"block_index": 223, "section_index": 1, "paragraph_index": 236, "location": "section 2 · paragraph 237", "text": "Ⅳ. 기술지원・사후관리부문"}, {"block_index": 224, "section_index": 1, "paragraph_index": 237, "location": "section 2 · paragraph 238", "text": "1. 장애대응"}, {"block_index": 225, 