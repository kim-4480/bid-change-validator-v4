 "policy": {
  "core": "회사 프로필로 판정하는 참가자격 요건. 유형과 값이 모두 맞아야 찾은 것으로 본다. values 가 여럿이면 대안(하나만 갖추면 됨)이다.",
  "confirm": "공동수급 불허·단독 이행처럼 충족/미충족으로 단정하면 안 되는 조건. 조항을 찾아 '확인 필요'로 남겼으면 맞다.",
  "excluded.common": "나라장터 참가등록, 부정당업자 제재·조세포탈 해당 없음 등 거의 모든 공고에 있는 항목. 채점하지 않는다.",
  "excluded.conditional": "'적용되는 경우' 처럼 조건이 붙은 문장. 채점하지 않는다.",
  "excluded.subjective": "'이행할 수 있는 업체' 처럼 프로필로 판정할 수 없는 서술. 요건으로 뽑으면 오답이다.",
  "excluded.not_requirement": "요건이 아닌 안내 문장. 요건으로 뽑으면 오답이다.",
  "excluded.product": "납품 물품에 대한 조건. 회사 자격으로 뽑으면 오답이다.",
  "core.exclusion": "exclusion=true 인 core 는 배제 조건이다. 배제로 담겨야(scope.restriction=EXCLUDE) 찾은 것이고, 같은 값을 요구로 확정하면 뜻이 뒤집힌 확정(inverted)이다.",
  "excluded.detail": "core 요건에 딸린 세부(실적의 인정 분야 등). 따로 요건으로 나와도 오답으로 세지 않는다.",
  "excluded.evaluation": "평가·심사의 배점 항목. 참가 자격이 아니다. 요건으로 뽑으면 오답이다.",
  "ideal_profile": "그 공고의 참가 자격을 모두 갖춘 가상 회사. 이 회사에 '미달' 이 하나라도 나오면 틀린 미달이다.",
  "checklist": "확인할 항목 또는 요건으로 정리하지 못한 조항으로 나와야 하는 문구.",
  "notes": "참고 정보(공동수급·하도급 허용 여부 등)로 나와야 하는 문구.",
  "expect": "가상 회사 판정의 기대값이 '핵심 자격 충족' 이 아닌 공고만 적는다."
